@inject IAuthService AuthService
@{
    var user = AuthService.CurrentUser;
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool At(string c, params string[] actions) => ctrl == c && actions.Contains(act);
    string? Cur(bool on) => on ? "page" : null;

    var onOutlines = At("Home", "Index", "Outline");
    var onQuizzes = At("Home", "Quizzed", "Quiz");
    var onArena = At("Home", "Arena");
    var onSubjects = At("Home", "Subjects");
    var onBoard = At("Home", "Leaderboard");
    var onMe = ctrl == "Auth" || ctrl == "Outline";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0F1D33" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/app.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="icon" type="image/png" href="~/favicon.png" />
</head>
<body>
    <partial name="_Icons" />
    <a class="skip-link visually-hidden-focusable" href="#main">Bỏ qua, tới nội dung chính</a>

    <header class="topbar">
        <div class="wrap topbar__inner">
            <a href="/" class="brand" aria-label="EduClash, về trang chủ">
                <svg class="brand__mark" viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">
                    <rect width="16" height="16" fill="#22395E" />
                    <rect x="2" y="4" width="5" height="8" fill="#F5B70A" />
                    <rect x="9" y="4" width="5" height="8" fill="#F5B70A" />
                    <rect x="7" y="5" width="2" height="8" fill="#B98500" />
                    <rect x="3" y="6" width="3" height="1" fill="#0F1D33" />
                    <rect x="3" y="8" width="2" height="1" fill="#0F1D33" />
                    <rect x="10" y="6" width="3" height="1" fill="#0F1D33" />
                    <rect x="10" y="8" width="3" height="1" fill="#0F1D33" />
                    <rect x="11" y="1" width="2" height="5" fill="#10B981" />
                    <rect x="11" y="6" width="1" height="1" fill="#10B981" />
                </svg>
                <span>Edu<span class="brand__clash">Clash</span></span>
            </a>

            <nav class="mainnav" aria-label="Điều hướng chính">
                <a href="/" aria-current="@Cur(onOutlines)"><svg class="icon" aria-hidden="true"><use href="#i-book" /></svg>Đề cương</a>
                <a href="/Home/Quizzed" aria-current="@Cur(onQuizzes)"><svg class="icon" aria-hidden="true"><use href="#i-quiz" /></svg>Trắc nghiệm</a>
                <a href="/Home/Arena" class="mainnav__arena" aria-current="@Cur(onArena)"><svg class="icon" aria-hidden="true"><use href="#i-swords" /></svg>Đấu trường</a>
                <a href="/Home/Subjects" aria-current="@Cur(onSubjects)"><svg class="icon" aria-hidden="true"><use href="#i-grid" /></svg>Môn học</a>
                <a href="/Home/Leaderboard" aria-current="@Cur(onBoard)"><svg class="icon" aria-hidden="true"><use href="#i-trophy" /></svg>Xếp hạng</a>
            </nav>

            <div class="topbar__user">
                @if (user != null)
                {
                    <a href="/Auth/Profile" class="stat-pill stat-pill--coin" title="Ví xu của bạn">
                        <svg class="icon" aria-hidden="true"><use href="#i-coin" /></svg>
                        <span class="num">@user.Coins</span><span class="visually-hidden"> xu</span>
                    </a>
                    <a href="/Home/Leaderboard" class="stat-pill stat-pill--elo" title="Điểm Elo đấu trường">
                        <svg class="icon" aria-hidden="true"><use href="#i-bolt" /></svg>
                        <span class="num">@user.Rating</span><span class="visually-hidden"> Elo</span>
                    </a>
                    <div class="dropdown">
                        <button type="button" class="user-btn" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Tài khoản: @user.DisplayName">
                            <span class="avatar">
                                @if (!string.IsNullOrEmpty(user.AvatarUrl))
                                {
                                    <img src="@user.AvatarUrl" alt="" />
                                }
                                else
                                {
                                    @(string.IsNullOrEmpty(user.DisplayName) ? "?" : user.DisplayName.Substring(0, 1).ToUpper())
                                }
                            </span>
                            <span class="user-btn__name">@user.DisplayName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                            <li class="dropdown-header-card">
                                <strong>@user.DisplayName</strong>
                                <span>@user.Email</span>
                            </li>
                            <li><a class="dropdown-item" href="/Auth/Profile"><svg class="icon" aria-hidden="true"><use href="#i-user" /></svg>Hồ sơ của tôi</a></li>
                            <li><a class="dropdown-item" href="/Outline/MyOutlines"><svg class="icon" aria-hidden="true"><use href="#i-file" /></svg>Đề tôi đã đăng</a></li>
                            <li><a class="dropdown-item" href="/Outline/Import"><svg class="icon" aria-hidden="true"><use href="#i-upload" /></svg>Tải đề lên</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="/Auth/Logout"><svg class="icon" aria-hidden="true"><use href="#i-logout" /></svg>Đăng xuất</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="/Auth/Login" class="btn-arcade btn-arcade--ghost btn-arcade--sm btn-hide-sm">Đăng nhập</a>
                    <a href="/Auth/Register" class="btn-arcade btn-arcade--gold btn-arcade--sm">Đăng ký nhận 50 xu</a>
                }
            </div>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
    {
        <div class="wrap">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="flash flash--ok alert fade show" role="status">
                    <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
                    <span>@TempData["SuccessMessage"]</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="flash flash--err alert fade show" role="alert">
                    <svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg>
                    <span>@TempData["ErrorMessage"]</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button>
                </div>
            }
        </div>
    }

    <main id="main" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="wrap site-footer__inner">
            <p class="m-0"><strong>EduClash</strong> · Ôn đề cương, luyện trắc nghiệm, đấu trí 1 vs 1.</p>
            <p class="m-0">© 2026 Nhóm Qua Môn Two · Học phần Quản lý dự án CNTT</p>
        </div>
    </footer>

    <nav class="tabbar" aria-label="Điều hướng nhanh">
        <a href="/" aria-current="@Cur(onOutlines)"><svg class="icon" aria-hidden="true"><use href="#i-book" /></svg>Đề cương</a>
        <a href="/Home/Quizzed" aria-current="@Cur(onQuizzes)"><svg class="icon" aria-hidden="true"><use href="#i-quiz" /></svg>Trắc nghiệm</a>
        <a href="/Home/Arena" class="tabbar__arena" aria-current="@Cur(onArena)"><svg class="icon" aria-hidden="true"><use href="#i-swords" /></svg>Đấu</a>
        <a href="/Home/Leaderboard" aria-current="@Cur(onBoard)"><svg class="icon" aria-hidden="true"><use href="#i-trophy" /></svg>Xếp hạng</a>
        <a href="@(user != null ? "/Auth/Profile" : "/Auth/Login")" aria-current="@Cur(onMe)"><svg class="icon" aria-hidden="true"><use href="#i-user" /></svg>@(user != null ? "Tôi" : "Đăng nhập")</a>
    </nav>

    <div class="toast-stack" id="toastStack" aria-live="polite"></div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/drag-scroll.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra · EduClash";
}

<div class="wrap wrap--narrow oops">
    <p class="oops__code" aria-hidden="true">GAME OVER</p>
    <h1>Trang này vừa gặp lỗi</h1>
    <p>Máy chủ chưa xử lý được yêu cầu của bạn. Thử tải lại trang sau ít giây, hoặc quay về trang chủ.</p>
    <div class="d-flex flex-wrap justify-content-center gap-3">
        <a href="/" class="btn-arcade btn-arcade--gold"><svg class="icon" aria-hidden="true"><use href="#i-home" /></svg>Về trang chủ</a>
        <button type="button" class="btn-arcade" onclick="location.reload()"><svg class="icon" aria-hidden="true"><use href="#i-refresh" /></svg>Tải lại</button>
    </div>
    @if (Model?.ShowRequestId == true)
    {
        <p class="field-hint mt-4">Mã lỗi để báo nhóm phát triển: <code>@Model.RequestId</code></p>
    }
</div>

@model QuizDetailViewModel
@{
    ViewData["Title"] = $"{Model.Title} · Trắc nghiệm · EduClash";
    var questions = Model.Questions ?? new List<QuestionViewModel>();
    var questionCount = questions.Count;
    var totalSeconds = Math.Max(60, questionCount * 90);
    var startClock = $"{totalSeconds / 60:00}:{totalSeconds % 60:00}";
    var routeId = ViewContext.RouteData.Values["id"]?.ToString() ?? Model.QuizId.ToString();
}

<div class="wrap wrap--narrow">
    <header class="page-head">
        <ol class="crumbs" aria-label="Vị trí">
            <li><a href="/">Trang chủ</a></li>
            <li><a href="/Home/Quizzed">Trắc nghiệm</a></li>
            <li aria-current="page">@Model.Title</li>
        </ol>
        <div class="page-head__row">
            <div>
                <span class="chip chip--code">@(Model.Subject?.Code ?? "—")</span>
                <h1 class="mt-2">@Model.Title</h1>
                <p class="page-head__lede">@questionCount câu · khoảng @(questionCount * 3 / 2) phút · @(Model.Subject?.Name ?? "Trắc nghiệm")</p>
            </div>
        </div>
    </header>

    @if (questionCount == 0)
    {
        <div class="empty mt-4">
            <svg class="icon empty__icon" aria-hidden="true"><use href="#i-quiz" /></svg>
            <h3>Bộ đề này chưa có câu hỏi</h3>
            <p>Có thể file tải lên chưa đúng định dạng A, B, C, D. Hãy thử bộ đề khác.</p>
            <a href="/Home/Quizzed" class="btn-arcade">Về danh sách bộ đề</a>
        </div>
    }
    else
    {
        <div class="quiz-bar" id="quizBar">
            <span class="quiz-bar__title">@Model.Title</span>
            <span class="quiz-bar__timer" id="quizTimer" role="timer" aria-label="Thời gian còn lại">
                <svg class="icon" aria-hidden="true"><use href="#i-clock" /></svg><span id="quizClock">@startClock</span>
            </span>
            <div class="quiz-bar__progress">
                <span>Đã làm <b class="num" id="answeredCount">0</b>/<span class="num">@questionCount</span></span>
                <div class="xp-track" aria-hidden="true"><div class="xp-fill" id="answeredFill"></div></div>
            </div>
        </div>

        <form id="quizForm" novalidate>
            @for (int i = 0; i < questionCount; i++)
            {
                var q = questions[i];
                <fieldset class="panel q-card" data-qid="@q.QuestionId" id="q-@(i + 1)">
                    <legend class="q-card__head">
                        <span class="q-card__no">@(i + 1)</span>
                        <span class="q-card__text">@q.QuestionText</span>
                    </legend>
                    <div class="q-options">
                        @for (int j = 0; j < q.Answers.Count; j++)
                        {
                            var a = q.Answers[j];
                            <label class="q-option" data-aid="@a.AnswerId">
                                <input type="radio" name="q_@q.QuestionId" value="@a.AnswerId" />
                                <span class="q-option__key" aria-hidden="true">@((char)('A' + j))</span>
                                <span>@a.AnswerText</span>
                                <span class="q-option__mark" data-mark></span>
                            </label>
                        }
                    </div>
                    <div class="q-explain d-none" data-explain></div>
                </fieldset>
            }

            <div class="quiz-submit">
                <button type="submit" id="btnSubmitQuiz" class="btn-arcade btn-arcade--green btn-arcade--lg">
                    <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>Nộp bài và xem kết quả
                </button>
            </div>
        </form>

        <section id="quizResult" class="game-panel result-card d-none" aria-live="polite" tabindex="-1">
            <div class="stars" id="resultStars" aria-hidden="true">
                <svg class="icon icon--fill"><use href="#i-star" /></svg>
                <svg class="icon icon--fill"><use href="#i-star" /></svg>
                <svg class="icon icon--fill"><use href="#i-star" /></svg>
            </div>
            <h2 id="resultTitle">Hoàn thành!</h2>
            <p class="result-card__score" id="resultScore">0/100</p>
            <p class="result-card__sub" id="resultSub"></p>
            <div class="result-card__actions">
                <a href="#q-1" class="btn-arcade btn-arcade--ghost">Xem lại từng câu</a>
                <a href="/Home/Quiz/@routeId" class="btn-arcade btn-arcade--ghost"><svg class="icon" aria-hidden="true"><use href="#i-refresh" /></svg>Làm lại</a>
                <a href="/Home/Arena" class="btn-arcade btn-arcade--gold"><svg class="icon" aria-hidden="true"><use href="#i-swords" /></svg>Mang đề này vào đấu</a>
            </div>
        </section>
    }
</div>

@section Scripts {
    <script>
    (function () {
        if (!document.getElementById('quizForm')) return;
        const TOTAL = @questionCount;
        const QUIZ_ID = "@routeId";
        const form = document.getElementById('quizForm');
        const clock = document.getElementById('quizClock');
        const timerBox = document.getElementById('quizTimer');
        const answeredCount = document.getElementById('answeredCount');
        const answeredFill = document.getElementById('answeredFill');
        const submitBtn = document.getElementById('btnSubmitQuiz');
        let seconds = @totalSeconds;
        let graded = false;

        const fmt = s => `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;

        const timer = setInterval(() => {
            seconds = Math.max(0, seconds - 1);
            clock.textContent = fmt(seconds);
            timerBox.classList.toggle('is-low', seconds <= 60);
            if (seconds === 0) {
                clearInterval(timer);
                EC.toast('Hết giờ, bài của bạn đã được nộp.', 'warn');
                grade();
            }
        }, 1000);

        function picks() {
            const out = {};
            form.querySelectorAll('input[type=radio]:checked').forEach(r => {
                out[r.closest('[data-qid]').dataset.qid] = r.value;
            });
            return out;
        }

        function updateProgress() {
            const n = Object.keys(picks()).length;
            answeredCount.textContent = n;
            answeredFill.style.transform = `scaleX(${n / TOTAL})`;
        }
        form.addEventListener('change', updateProgress);

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (graded) return;
            const missing = TOTAL - Object.keys(picks()).length;
            if (missing > 0) {
                const ok = await EC.confirm({
                    title: `Còn ${missing} câu chưa làm`,
                    body: 'Câu bỏ trống sẽ tính là sai. Bạn vẫn muốn nộp bài?',
                    okText: 'Nộp luôn',
                    cancelText: 'Làm tiếp'
                });
                if (!ok) {
                    const first = [...form.querySelectorAll('[data-qid]')].find(f => !f.querySelector('input:checked'));
                    first?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    first?.querySelector('input')?.focus({ preventScroll: true });
                    return;
                }
            }
            grade();
        });

        async function grade() {
            if (graded) return;
            graded = true;
            clearInterval(timer);
            submitBtn.disabled = true;
            submitBtn.lastChild.textContent = 'Đang chấm…';

            let data;
            try {
                const res = await fetch(`/Home/GradeQuiz?id=${QUIZ_ID}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(picks())
                });
                if (!res.ok) throw new Error();
                data = await res.json();
            } catch {
                graded = false;
                submitBtn.disabled = false;
                submitBtn.lastChild.textContent = 'Nộp bài và xem kết quả';
                EC.toast('Không chấm được bài vì mất kết nối. Bài làm của bạn vẫn còn, hãy bấm nộp lại.', 'err', 7000);
                return;
            }

            form.classList.add('is-graded');
            form.querySelectorAll('input[type=radio]').forEach(r => r.disabled = true);

            data.results.forEach(r => {
                const box = form.querySelector(`[data-qid="${r.questionId}"]`);
                if (!box) return;
                box.querySelectorAll('.q-option').forEach(opt => {
                    const aid = opt.dataset.aid;
                    const mark = opt.querySelector('[data-mark]');
                    if (r.correctAnswerIds.includes(aid)) {
                        opt.classList.add('is-correct');
                        mark.innerHTML = '<svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>Đáp án đúng';
                    } else if (r.picked === aid) {
                        opt.classList.add('is-wrong');
                        mark.innerHTML = '<svg class="icon" aria-hidden="true"><use href="#i-x"/></svg>Bạn chọn';
                    }
                });
                if (!r.picked) box.classList.add('is-skipped');
                if (r.explanation) {
                    const ex = box.querySelector('[data-explain]');
                    ex.textContent = 'Giải thích: ' + r.explanation;
                    ex.classList.remove('d-none');
                }
            });

            const pct = data.total ? Math.round(data.correct / data.total * 100) : 0;
            const stars = pct >= 90 ? 3 : pct >= 70 ? 2 : pct >= 40 ? 1 : 0;
            document.querySelectorAll('#resultStars .icon').forEach((s, i) => s.classList.toggle('is-on', i < stars));
            document.getElementById('resultScore').textContent = `${pct}/100`;
            document.getElementById('resultTitle').textContent =
                stars === 3 ? 'Xuất sắc! Sẵn sàng vào đấu.' :
                stars === 2 ? 'Khá lắm! Thêm một lượt nữa là chắc.' :
                stars === 1 ? 'Đã qua vòng khởi động.' : 'Cần ôn thêm một chút.';
            document.getElementById('resultSub').textContent = `${data.correct}/${data.total} câu đúng · thời gian còn ${fmt(seconds)}`;

            submitBtn.closest('.quiz-submit').classList.add('d-none');
            const result = document.getElementById('quizResult');
            result.classList.remove('d-none');
            result.scrollIntoView({ behavior: 'smooth', block: 'center' });
            result.focus({ preventScroll: true });
        }
    })();
    </script>
}

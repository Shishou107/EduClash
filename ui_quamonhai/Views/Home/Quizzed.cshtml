@model List<ContentItemViewModel>
@{
    ViewData["Title"] = "Trắc nghiệm · EduClash";
    var subjects = ViewBag.Subjects as List<SubjectViewModel> ?? new List<SubjectViewModel>();
    int? selectedSubjectId = ViewBag.SelectedSubjectId as int?;
    var selectedSubject = ViewBag.SelectedSubject as SubjectViewModel;
    string searchKeyword = ViewBag.SearchKeyword as string ?? "";
    bool filtering = selectedSubject != null || !string.IsNullOrWhiteSpace(searchKeyword);
    string DiffLabel(string d) => d switch { "Easy" => "Dễ", "Hard" => "Khó", _ => "Vừa" };
    string DiffChip(string d) => d switch { "Easy" => "chip--green", "Hard" => "chip--red", _ => "chip--gold" };
}

<div class="wrap">
    <header class="page-head">
        <ol class="crumbs" aria-label="Vị trí">
            <li><a href="/">Trang chủ</a></li>
            @if (selectedSubject != null)
            {
                <li><a href="/Home/Quizzed">Trắc nghiệm</a></li>
                <li aria-current="page">@selectedSubject.Name</li>
            }
            else
            {
                <li aria-current="page">Trắc nghiệm</li>
            }
        </ol>
        <div class="page-head__row">
            <div>
                <h1>Luyện trắc nghiệm</h1>
                <p class="page-head__lede">Làm thử một bộ đề trước khi mang nó vào đấu trường. Chấm điểm ngay sau khi nộp, có giải thích cho từng câu.</p>
            </div>
            <a href="/Home/Arena" class="btn-arcade btn-arcade--gold">
                <svg class="icon" aria-hidden="true"><use href="#i-swords" /></svg>Mang đề vào đấu
            </a>
        </div>
    </header>

    <section class="section" aria-labelledby="subjectsTitle">
        <div class="section-head">
            <h2 id="subjectsTitle">Chọn môn</h2>
            <a class="link-arrow" href="/Home/Subjects">Tất cả môn học <svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg></a>
        </div>
        @await Html.PartialAsync("_SubjectRail", subjects, new ViewDataDictionary(ViewData) { { "BaseUrl", "/Home/Quizzed" }, { "SelectedId", selectedSubjectId }, { "ShowCounts", false } })
    </section>

    <section class="section" aria-labelledby="quizTitle">
        <div class="section-head">
            <h2 id="quizTitle">@(selectedSubject != null ? $"Bộ đề môn {selectedSubject.Name}" : "Bộ đề mới nhất")</h2>
            <form method="get" action="/Home/Quizzed" class="search" role="search">
                @if (selectedSubjectId != null)
                {
                    <input type="hidden" name="subjectId" value="@selectedSubjectId" />
                }
                <svg class="icon" aria-hidden="true"><use href="#i-search" /></svg>
                <label for="quizSearch" class="visually-hidden">Tìm bộ đề trắc nghiệm</label>
                <input id="quizSearch" type="search" name="search" placeholder="Tên bộ đề hoặc tag" value="@searchKeyword" />
                <button type="submit">Tìm</button>
            </form>
        </div>

        @if (filtering)
        {
            <p class="filter-note">
                Đang lọc: @if (selectedSubject != null) { <span class="chip chip--green">@selectedSubject.Code</span> }
                @if (!string.IsNullOrWhiteSpace(searchKeyword)) { <span class="chip">“@searchKeyword”</span> }
                <a href="/Home/Quizzed" class="link-arrow">Bỏ lọc</a>
            </p>
        }

        @if (Model == null || Model.Count == 0)
        {
            <div class="empty">
                <svg class="icon empty__icon" aria-hidden="true"><use href="#i-target" /></svg>
                <h3>Chưa có bộ đề trắc nghiệm @(selectedSubject != null ? "cho môn này" : "khớp")</h3>
                <p>Tải lên file đề có sẵn đáp án A, B, C, D, hoặc mở một đề cương và dùng xu để AI soạn câu hỏi.</p>
                <a href="/Outline/Import" class="btn-arcade btn-arcade--green">
                    <svg class="icon" aria-hidden="true"><use href="#i-upload" /></svg>Tải bộ đề lên
                </a>
            </div>
        }
        else
        {
            <div class="doc-grid">
                @foreach (var item in Model)
                {
                    <article class="doc-card doc-card--quiz">
                        <div class="doc-card__top">
                            <span class="chip chip--code">@item.Subject.Code</span>
                            <span class="d-inline-flex gap-2">
                                <span class="chip @DiffChip(item.DifficultyLevel)">@DiffLabel(item.DifficultyLevel)</span>
                                <span class="chip chip--blue"><span class="num">@item.QuestionCount</span>&nbsp;câu</span>
                            </span>
                        </div>
                        <h3><a href="/Home/Quiz/@item.ContentId">@item.Title</a></h3>
                        <p class="doc-card__desc">@(string.IsNullOrEmpty(item.Description) ? $"Bộ câu hỏi trắc nghiệm môn {item.Subject.Name}." : item.Description)</p>
                        <div class="doc-card__meta">
                            <span class="doc-card__author">
                                <span class="avatar avatar--sm" aria-hidden="true">@(string.IsNullOrEmpty(item.Author.DisplayName) ? "?" : item.Author.DisplayName.Substring(0, 1).ToUpper())</span>
                                <span>@item.Author.DisplayName</span>
                            </span>
                            <span class="doc-card__go" aria-hidden="true">Làm bài <svg class="icon"><use href="#i-arrow" /></svg></span>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

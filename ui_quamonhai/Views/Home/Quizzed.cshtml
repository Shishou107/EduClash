@model List<ContentItemViewModel>
@{
    ViewData["Title"] = "Trắc Nghiệm Đại Học — EduClash";
    var subjects = ViewBag.Subjects as List<SubjectViewModel> ?? new List<SubjectViewModel>();
    int? selectedSubjectId = ViewBag.SelectedSubjectId as int?;
    var selectedSubject = ViewBag.SelectedSubject as SubjectViewModel;
    string searchKeyword = ViewBag.SearchKeyword as string ?? "";
}

<!-- Breadcrumbs Strip -->
<div class="edu-breadcrumbs-strip" style="background-color: #0F1D33; padding: 12px 24px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
    <div style="max-width: 1200px; margin: 0 auto; display: flex; align-items: center; gap: 10px; font-size: 0.95rem;">
        <a href="/" style="color: #FFFFFF; font-weight: 500; text-decoration: none;">Trang chủ</a>
        <span style="color: #94A3B8;">&gt;</span>
        <a href="/" style="color: #FFFFFF; font-weight: 500; text-decoration: none;">Đại Học</a>
        <span style="color: #94A3B8;">&gt;</span>
        <span style="color: #38BDF8; font-weight: 600;">@(selectedSubject != null ? selectedSubject.Name : "Trắc Nghiệm")</span>
    </div>
</div>

<div class="container py-4" style="max-width: 1200px;">


    <!-- SECTION 1: Các môn (Horizontal Scroll) -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span style="display: inline-block; width: 4px; height: 22px; background: #10B981; border-radius: 2px;"></span>
                <h2 class="h4 fw-bold m-0 text-dark">Trắc Nghiệm các môn Đại Học</h2>
            </div>
            <div class="d-flex align-items-center gap-3">
                @if (selectedSubjectId != null)
                {
                    <a href="/Home/Quizzed" class="btn btn-sm btn-outline-secondary">✕ Xem tất cả đề</a>
                }
                <a href="/Home/Subjects" class="text-success fw-bold text-decoration-none">
                    Xem tất cả các môn &rarr;
                </a>
            </div>
        </div>

        @if (subjects.Count == 0)
        {
            <div class="text-muted py-3 px-1 small">Chưa có môn học nào trong hệ thống.</div>
        }
        else
        {
            <div class="d-flex gap-3 overflow-auto pb-3" style="scrollbar-width: thin;">
                @foreach (var sub in subjects)
                {
                    bool isSelected = selectedSubjectId == sub.SubjectId;
                    <div style="flex: 0 0 170px;">
                        <a href="@(isSelected ? "/Home/Quizzed" : $"/Home/Quizzed?subjectId={sub.SubjectId}")" class="text-decoration-none">
                            <div class="card h-100 shadow-sm" 
                                 style="border-radius: 12px; border: @(isSelected ? "2px solid #059669" : "1px solid #E2E8F0"); background: @(isSelected ? "#F0FDF4" : "#FFFFFF");">
                                <div class="p-3 d-flex flex-column justify-content-between" style="min-height: 200px;">
                                    <h6 class="fw-bold text-dark m-0" style="height: 2.6em; line-height: 1.3;" title="@sub.Name">
                                        @sub.Name
                                    </h6>
                                    
                                    <div class="rounded d-flex flex-column align-items-center justify-content-center text-center p-2 my-2" 
                                         style="background: @sub.ThemeColor; color: @sub.TextColor; height: 85px;">
                                        <span class="badge bg-light text-dark fw-bold mb-1" style="font-size: 0.65rem;">@sub.Code</span>
                                        <small class="text-truncate px-1 fw-bold" style="font-size: 0.72rem; max-width: 100%;">@sub.Name</small>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top text-muted small" style="font-size: 0.75rem;">
                                        <span>Đề thi</span>
                                        <span class="text-success fw-bold">@(isSelected ? "✓ Đang chọn" : "Chọn đề →")</span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </section>

    <!-- SECTION 2: Danh sách bài thi trắc nghiệm -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span style="display: inline-block; width: 4px; height: 22px; background: #10B981; border-radius: 2px;"></span>
                <h2 class="h4 fw-bold m-0 text-dark">
                    @(selectedSubject != null ? $"Đề Trắc Nghiệm Môn: {selectedSubject.Name}" : "Đề Trắc Nghiệm Đại Học Nổi Bật")
                </h2>
            </div>

            <!-- Search form -->
            <form method="get" action="/Home/Quizzed" class="d-flex gap-2">
                @if (selectedSubjectId != null)
                {
                    <input type="hidden" name="subjectId" value="@selectedSubjectId" />
                }
                <div class="input-group">
                    <input type="text" name="search" class="form-control" 
                           placeholder="Tìm bài thi trắc nghiệm..." 
                           value="@searchKeyword" />
                    <button class="btn btn-outline-success" type="submit">Tìm</button>
                    @if (!string.IsNullOrWhiteSpace(searchKeyword) || selectedSubjectId != null)
                    {
                        <a href="/Home/Quizzed" class="btn btn-outline-secondary">Xóa lọc</a>
                    }
                </div>
            </form>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="card p-5 text-center shadow-sm border-0" style="border-radius: 12px; background: #FFFFFF;">
                <div style="font-size: 3.5rem;">🎯</div>
                <h4 class="fw-bold mt-2">Chưa có bài thi trắc nghiệm nào</h4>
                <p class="text-muted">
                    @(selectedSubject != null 
                        ? $"Hiện chưa có bộ trắc nghiệm cho môn '{selectedSubject.Name}'. Bạn có thể tạo từ đề cương bằng AI!" 
                        : "Kho đề hiện tại chưa có đề trắc nghiệm. Hãy tải lên tài liệu để AI sinh bộ câu hỏi.")
                </p>
                <div>
                    <a href="/Outline/Import" class="btn btn-success fw-bold px-4 py-2 mt-2" style="border-radius: 8px;">
                        + Tạo đề trắc nghiệm mới
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var item in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0" style="border-radius: 12px;">
                            <div class="card-body d-flex flex-column justify-content-between p-4">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-success-subtle text-success fw-bold">@item.Subject.Code</span>
                                        <span class="badge bg-secondary-subtle text-secondary">@item.QuestionCount câu hỏi</span>
                                    </div>
                                    <h5 class="card-title fw-bold text-dark text-truncate-2">
                                        <a href="/Home/Quiz/@item.ContentId" class="text-dark text-decoration-none">
                                            @item.Title
                                        </a>
                                    </h5>
                                    <p class="card-text text-muted small text-truncate-3">
                                        @(string.IsNullOrEmpty(item.Description) ? "Bộ câu hỏi trắc nghiệm rèn luyện kỹ năng và củng cố kiến thức." : item.Description)
                                    </p>
                                </div>

                                <div class="pt-3 border-top mt-3 d-flex justify-content-between align-items-center">
                                    <span class="small text-muted">⭐ @item.StarCount lượt thi</span>
                                    <a href="/Home/Quiz/@item.ContentId" class="btn btn-sm btn-primary fw-bold px-3">
                                        Bắt đầu làm bài &rarr;
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

</div>

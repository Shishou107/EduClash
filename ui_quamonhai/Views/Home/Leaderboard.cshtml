@model List<LeaderboardItemViewModel>
@{
    ViewData["Title"] = "Bảng Xếp Hạng Cao Thủ — EduClash";
    bool byRating = ViewBag.ByRating is bool b ? b : true;
}

<div class="edu-breadcrumbs-strip" style="background-color: #0F1D33; padding: 12px 24px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
    <div style="max-width: 1200px; margin: 0 auto; display: flex; align-items: center; gap: 10px; font-size: 0.95rem;">
        <a href="/" style="color: #FFFFFF; font-weight: 500; text-decoration: none;">Trang chủ</a>
        <span style="color: #94A3B8;">&gt;</span>
        <span style="color: #38BDF8; font-weight: 600;">Bảng Xếp Hạng</span>
    </div>
</div>

<div class="container py-4" style="max-width: 1000px;">
    <!-- Title & Mode switcher -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark m-0">🏆 Bảng Xếp Hạng Cao Thủ</h1>
            <p class="text-muted small m-0">Vinh danh các sinh viên có thành tích xuất sắc nhất toàn hệ thống.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a href="/Home/Arena" class="btn btn-warning fw-bold shadow-sm d-flex align-items-center gap-2 px-3 py-2" style="border-radius: 8px;">
                <span>⚔️</span> Vào Đấu Trí (Arena)
            </a>
            <div class="btn-group shadow-sm" role="group">
                <a href="/Home/Leaderboard?byRating=true" class="btn btn-sm @(byRating ? "btn-success" : "btn-outline-success") fw-bold px-3 py-2">
                    ⚔️ Xếp Hạng Elo
                </a>
                <a href="/Home/Leaderboard?byRating=false" class="btn btn-sm @(!byRating ? "btn-success" : "btn-outline-success") fw-bold px-3 py-2">
                    ⭐ Xếp Hạng XP
                </a>
            </div>
        </div>
    </div>

    <!-- Leaderboard Table -->
    <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width: 80px;">Hạng</th>
                        <th>Học viên</th>
                        <th>Danh hiệu</th>
                        <th class="text-end px-4">@(byRating ? "Điểm Elo" : "Kinh nghiệm (XP)")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <div>Chưa có dữ liệu xếp hạng. Hãy tham gia thi đấu để ghi danh đầu tiên!</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var u in Model)
                        {
                            string rankBadge = u.RankPosition switch
                            {
                                1 => "🥇",
                                2 => "🥈",
                                3 => "🥉",
                                _ => $"#{u.RankPosition}"
                            };
                            <tr class="@(u.RankPosition <= 3 ? "fw-bold" : "")">
                                <td class="text-center fs-5">@rankBadge</td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle overflow-hidden shadow-sm" style="width: 38px; height: 38px; background: #E2E8F0;">
                                            <img src="@(string.IsNullOrEmpty(u.AvatarUrl) ? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=64&q=80" : u.AvatarUrl)" 
                                                 alt="@u.DisplayName" style="width: 100%; height: 100%; object-fit: cover;" />
                                        </div>
                                        <div>
                                            <div class="text-dark">@u.DisplayName</div>
                                            <small class="text-muted fw-normal">Tham gia thi đấu</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary px-2 py-1">@u.RankTier</span>
                                </td>
                                <td class="text-end px-4">
                                    <span class="text-success fw-bold fs-6">
                                        @(byRating ? $"{u.Rating} Elo" : $"{u.CurrentXP} XP")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

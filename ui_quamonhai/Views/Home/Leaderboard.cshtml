@model List<LeaderboardItemViewModel>
@{
    ViewData["Title"] = "Bảng xếp hạng · EduClash";
    bool byRating = ViewBag.ByRating is bool b ? b : true;
    var list = Model ?? new List<LeaderboardItemViewModel>();
    var podium = list.Take(3).ToList();
    var rest = list.Skip(3).ToList();
    string Score(LeaderboardItemViewModel u) => byRating ? u.Rating.ToString() : u.CurrentXP.ToString();
    string unit = byRating ? "Elo" : "XP";
}

<div class="wrap wrap--narrow">
    <header class="page-head">
        <ol class="crumbs" aria-label="Vị trí">
            <li><a href="/">Trang chủ</a></li>
            <li aria-current="page">Bảng xếp hạng</li>
        </ol>
        <div class="page-head__row">
            <div>
                <h1>Bảng xếp hạng cao thủ</h1>
                <p class="page-head__lede">Elo tăng khi thắng trận ở đấu trường. XP tăng theo mọi hoạt động học.</p>
            </div>
            <nav class="seg" aria-label="Cách xếp hạng">
                <a href="/Home/Leaderboard?byRating=true" aria-current="@(byRating ? "page" : null)"><svg class="icon" aria-hidden="true"><use href="#i-bolt" /></svg>Theo Elo</a>
                <a href="/Home/Leaderboard?byRating=false" aria-current="@(!byRating ? "page" : null)"><svg class="icon" aria-hidden="true"><use href="#i-star" /></svg>Theo XP</a>
            </nav>
        </div>
    </header>

    <section class="section" aria-label="Xếp hạng">
        @if (list.Count == 0)
        {
            <div class="empty">
                <svg class="icon empty__icon" aria-hidden="true"><use href="#i-trophy" /></svg>
                <h3>Bảng còn trống</h3>
                <p>Chưa ai có thứ hạng. Thắng một trận ở đấu trường để ghi tên đầu tiên.</p>
                <a href="/Home/Arena" class="btn-arcade btn-arcade--gold"><svg class="icon" aria-hidden="true"><use href="#i-swords" /></svg>Vào đấu trường</a>
            </div>
        }
        else
        {
            <ol class="podium" aria-label="Top 3">
                @foreach (var u in podium)
                {
                    <li class="podium__spot podium__spot--@u.RankPosition">
                        <span class="avatar">
                            @if (!string.IsNullOrEmpty(u.AvatarUrl))
                            {
                                <img src="@u.AvatarUrl" alt="" />
                            }
                            else
                            {
                                @UiHelpers.Initial(u.DisplayName)
                            }
                        </span>
                        <span class="podium__name">@u.DisplayName</span>
                        <span class="podium__score">@Score(u) @unit</span>
                        <span class="podium__block" aria-hidden="true">@u.RankPosition</span>
                    </li>
                }
            </ol>

            @if (rest.Count > 0)
            {
                <div class="panel table-scroll">
                    <table class="data-table">
                        <caption class="visually-hidden">Các hạng tiếp theo</caption>
                        <thead>
                            <tr>
                                <th scope="col">Hạng</th>
                                <th scope="col">Người chơi</th>
                                <th scope="col">Danh hiệu</th>
                                <th scope="col" class="num-col">Thắng / Thua</th>
                                <th scope="col" class="num-col">@unit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in rest)
                            {
                                <tr>
                                    <td><span class="rank-no">#@u.RankPosition</span></td>
                                    <td>
                                        <div class="player-cell">
                                            <span class="avatar">
                                                @if (!string.IsNullOrEmpty(u.AvatarUrl))
                                                {
                                                    <img src="@u.AvatarUrl" alt="" />
                                                }
                                                else
                                                {
                                                    @UiHelpers.Initial(u.DisplayName)
                                                }
                                            </span>
                                            <div><strong>@u.DisplayName</strong><small>Cấp @u.Level</small></div>
                                        </div>
                                    </td>
                                    <td><span class="chip tier @UiHelpers.TierClass(u.RankTier)">@u.RankTier</span></td>
                                    <td class="num-col"><span class="num">@u.Wins/@u.Losses</span></td>
                                    <td class="num-col"><strong class="num">@Score(u)</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </section>
</div>

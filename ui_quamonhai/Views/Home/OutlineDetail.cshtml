@model OutlineDetailViewModel
@{
    ViewData["Title"] = $"{Model.Title} · EduClash";
    bool isPdf = Model.AttachedFileUrl?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true;
    bool isDocx = Model.AttachedFileUrl?.EndsWith(".docx", StringComparison.OrdinalIgnoreCase) == true;
    string fileExt = isPdf ? "pdf" : (isDocx ? "docx" : "pdf");
}

@section Styles {
    <link rel="stylesheet" href="~/css/viewer.css" asp-append-version="true" />
}

<div class="wrap">
    <section class="panel doc-head" aria-labelledby="docTitle">
        <ol class="crumbs" aria-label="Vị trí">
            <li><a href="/">Đề cương</a></li>
            <li><a href="/?subjectId=@(Model.Subject?.SubjectId ?? 0)">@(Model.Subject?.Name ?? "Môn học")</a></li>
            <li aria-current="page">@Model.Title</li>
        </ol>
        <div class="doc-head__row">
            <div>
                <div class="doc-head__chips">
                    <span class="chip chip--code">@(Model.Subject?.Code ?? "—")</span>
                    <span class="chip">@(isPdf ? "PDF" : (isDocx ? "Word" : "Tài liệu"))@(Model.AttachedFileSizeBytes.HasValue ? $" · {Model.AttachedFileSizeBytes.Value / 1024} KB" : "")</span>
                    <span class="chip" title="Lượt xem"><svg class="icon" aria-hidden="true"><use href="#i-eye" /></svg>@Model.ViewCount</span>
                    <span class="chip chip--gold" title="Lượt thích"><svg class="icon" aria-hidden="true"><use href="#i-star" /></svg>@Model.StarCount</span>
                </div>
                <h1 id="docTitle">@Model.Title</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="doc-head__desc">@Model.Description</p>
                }
                <p class="doc-head__meta">
                    <span>Đăng bởi <strong>@(Model.Author?.DisplayName ?? "Thành viên")</strong></span>
                    <span>@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                </p>
            </div>
            <div class="doc-head__actions">
                <button type="button" class="btn-arcade btn-arcade--gold" data-bs-toggle="modal" data-bs-target="#aiQuizModal">
                    <svg class="icon" aria-hidden="true"><use href="#i-sparkles" /></svg>AI soạn trắc nghiệm
                </button>
                @if (!string.IsNullOrEmpty(Model.AttachedFileUrl))
                {
                    <a href="@Model.AttachedFileUrl" target="_blank" rel="noopener" download class="btn-arcade">
                        <svg class="icon" aria-hidden="true"><use href="#i-download" /></svg>Tải file gốc
                    </a>
                }
            </div>
        </div>
    </section>

    <section id="studocu-viewer-card" class="panel viewer" aria-label="Trình đọc tài liệu">
        <div class="viewer-toolbar" role="toolbar" aria-label="Điều khiển trình đọc">
            <div class="viewer-toolbar__group">
                <button type="button" id="studocu-btn-prev" class="studocu-ctrl-btn" aria-label="Trang trước" disabled>
                    <svg class="icon" aria-hidden="true"><use href="#i-chev-left" /></svg>
                </button>
                <span class="viewer-page">
                    <label for="studocu-page-input" class="visually-hidden">Đến trang</label>
                    <input type="number" id="studocu-page-input" value="1" min="1" class="studocu-page-input" />
                    <span>/ <span id="studocu-total-pages" class="num">1</span></span>
                </span>
                <button type="button" id="studocu-btn-next" class="studocu-ctrl-btn" aria-label="Trang sau">
                    <svg class="icon" aria-hidden="true"><use href="#i-chev-right" /></svg>
                </button>
            </div>

            <div class="viewer-toolbar__group">
                <button type="button" id="studocu-btn-zoom-out" class="studocu-ctrl-btn" aria-label="Thu nhỏ">
                    <svg class="icon" aria-hidden="true"><use href="#i-zoom-out" /></svg>
                </button>
                <span id="studocu-zoom-text" aria-live="polite">100%</span>
                <button type="button" id="studocu-btn-zoom-in" class="studocu-ctrl-btn" aria-label="Phóng to">
                    <svg class="icon" aria-hidden="true"><use href="#i-zoom-in" /></svg>
                </button>
                <button type="button" id="studocu-btn-fit-width" class="studocu-ctrl-btn d-none d-md-inline-flex" aria-label="Vừa chiều rộng">
                    <svg class="icon" aria-hidden="true"><use href="#i-width" /></svg>
                </button>
                <button type="button" id="studocu-btn-zoom-reset" class="studocu-ctrl-btn" aria-label="Về cỡ 100%">1:1</button>
                <button type="button" id="studocu-btn-fullscreen" class="studocu-ctrl-btn" aria-label="Toàn màn hình">
                    <svg class="icon" aria-hidden="true"><use href="#i-expand" /></svg>
                </button>
            </div>
        </div>

        <div id="studocu-workspace" class="studocu-workspace">
            <div id="studocu-document-container" class="studocu-document-body"></div>
        </div>
    </section>
</div>

<div class="modal fade" id="aiQuizModal" tabindex="-1" aria-labelledby="aiQuizModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="aiQuizModalLabel">AI soạn trắc nghiệm từ đề cương này</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <p class="text-secondary">AI đọc nội dung đề cương và soạn câu hỏi 4 phương án. Bộ đề mới sẽ nằm ở trang Trắc nghiệm.</p>
                <div class="field">
                    <label for="aiCoins">Số xu muốn dùng</label>
                    <input type="number" id="aiCoins" class="form-control" value="3" min="1" max="10" aria-describedby="aiCoinsHint" />
                    <p class="field-hint" id="aiCoinsHint">1 xu đổi được khoảng 2 câu hỏi. Tối đa 10 xu mỗi lần.</p>
                </div>
                <div id="aiResultMsg" class="flash d-none" role="status"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-arcade btn-arcade--sm" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn-arcade btn-arcade--sm btn-arcade--gold" id="btnRunAiQuiz">Soạn câu hỏi</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- 1. JSZip (bắt buộc cho docx-preview) -->
    <script src="~/js/jszip.min.js"></script>

    <!-- 2. Thư viện docx-preview chuẩn Word Online -->
    <script src="~/js/docx-preview.min.js"></script>

    <!-- 3. Thư viện Mozilla PDF.js chuẩn PDF Studocu -->
    <script src="~/js/pdf.min.js"></script>

    <!-- 4. Bộ điều khiển Studocu Document Viewer -->
    <script src="~/js/studocu-viewer.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var fileUrl = "@(Model.AttachedFileUrl ?? "")";
            var fileType = "@fileExt";

            if (fileUrl) {
                var proxyUrl = "/Home/DocumentProxy?url=" + encodeURIComponent(fileUrl);

                window.studocuViewer.init({
                    containerId: 'studocu-document-container',
                    docUrl: fileUrl,
                    proxyUrl: proxyUrl,
                    fileType: fileType
                });
            } else {
                document.getElementById('studocu-document-container').innerHTML = 
                    '<div class="studocu-fallback-box"><p class="text-secondary">Đề cương này chưa có file đính kèm.</p></div>';
            }
        });

        // AI Quiz Handler
        document.getElementById('btnRunAiQuiz')?.addEventListener('click', async function () {
            const coins = document.getElementById('aiCoins').value;
            const btn = document.getElementById('btnRunAiQuiz');
            const alertBox = document.getElementById('aiResultMsg');
            
            btn.disabled = true;
            btn.innerText = "Đang soạn…";
            alertBox.className = "flash";
            alertBox.innerText = "AI đang đọc đề cương, việc này có thể mất khoảng nửa phút.";

            try {
                const res = await fetch(`/Outline/GenerateAiQuiz?id=@Model.ContentId&coins=${coins}`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    alertBox.className = "flash flash--ok";
                    alertBox.innerText = data.message + ` Còn ${data.remainingCoins} xu. Đang chuyển sang trang Trắc nghiệm…`;
                    setTimeout(() => window.location.href = '/Home/Quizzed', 1500);
                } else {
                    alertBox.className = "flash flash--err";
                    alertBox.innerText = data.message || "Chưa soạn được câu hỏi. Kiểm tra lại số xu trong ví rồi thử lại.";
                }
            } catch (e) {
                alertBox.className = "flash flash--err";
                alertBox.innerText = "Mất kết nối tới máy chủ. Kiểm tra mạng rồi bấm thử lại.";
            } finally {
                btn.disabled = false;
                btn.innerText = "Soạn câu hỏi";
            }
        });
    </script>
}

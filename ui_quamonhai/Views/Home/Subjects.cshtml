@model List<SubjectViewModel>
@{
    ViewData["Title"] = "Môn học · EduClash";
    string searchKeyword = ViewBag.SearchKeyword as string ?? "";
}

<div class="wrap">
    <header class="page-head">
        <ol class="crumbs" aria-label="Vị trí">
            <li><a href="/">Trang chủ</a></li>
            <li aria-current="page">Môn học</li>
        </ol>
        <div class="page-head__row">
            <div>
                <h1>Tất cả môn học</h1>
                <p class="page-head__lede">Mỗi môn có hai kệ: đề cương để đọc và bộ trắc nghiệm để luyện hoặc mang vào đấu trường.</p>
            </div>
            <form method="get" action="/Home/Subjects" class="search" role="search">
                <svg class="icon" aria-hidden="true"><use href="#i-search" /></svg>
                <label for="subjectSearch" class="visually-hidden">Tìm môn học</label>
                <input id="subjectSearch" type="search" name="search" placeholder="Tên môn hoặc mã môn" value="@searchKeyword" />
                <button type="submit">Tìm</button>
            </form>
        </div>
    </header>

    <section class="section" aria-label="Danh sách môn học">
        @if (!string.IsNullOrWhiteSpace(searchKeyword))
        {
            <p class="filter-note">Kết quả cho <span class="chip">“@searchKeyword”</span> <a href="/Home/Subjects" class="link-arrow">Xem lại tất cả</a></p>
        }

        @if (Model == null || Model.Count == 0)
        {
            <div class="empty">
                <svg class="icon empty__icon" aria-hidden="true"><use href="#i-search" /></svg>
                <h3>Không tìm thấy môn nào</h3>
                <p>Không có môn học khớp với “@searchKeyword”. Thử gõ mã môn, ví dụ CS101.</p>
                <a href="/Home/Subjects" class="btn-arcade">Xem tất cả môn</a>
            </div>
        }
        else
        {
            <div class="subject-grid">
                @foreach (var sub in Model)
                {
                    <article class="subject-card" style="--c:@sub.ThemeColor; --tc:@sub.TextColor">
                        <div class="subject-card__cover">
                            <span class="num">@sub.Code</span>
                            <h2>@sub.Name</h2>
                        </div>
                        <div class="subject-card__body">
                            <p>@(string.IsNullOrEmpty(sub.Description) ? "Đề cương lý thuyết và câu hỏi trắc nghiệm ôn thi." : sub.Description)</p>
                            <div class="subject-card__actions">
                                <a href="/?subjectId=@sub.SubjectId" class="btn-arcade btn-arcade--sm" aria-label="Đề cương môn @sub.Name">
                                    <svg class="icon" aria-hidden="true"><use href="#i-book" /></svg>Đề cương
                                </a>
                                <a href="/Home/Quizzed?subjectId=@sub.SubjectId" class="btn-arcade btn-arcade--sm" aria-label="Trắc nghiệm môn @sub.Name">
                                    <svg class="icon" aria-hidden="true"><use href="#i-quiz" /></svg>Trắc nghiệm
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

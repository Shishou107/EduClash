        }
        document.getElementById('createdRoomBox').classList.add('d-none');
        currentRoom = null;
    });

    // 4. SAO CHÉP MÃ PHÒNG
    document.getElementById('btnCopyCode')?.addEventListener('click', copyRoomCode);

    // 5. RỜI TRẬN (XỬ THUA NGAY LẬP TỨC, ĐỐI THỦ THẮNG)
    document.getElementById('btnSurrender')?.addEventListener('click', async () => {
        const leave = await EC.confirm({
            title: 'Rời trận bây giờ?',
            body: isRealMatch ? 'Bạn sẽ bị xử thua và mất 20 Elo, đối thủ thắng ngay.' : 'Trận tập sẽ kết thúc, không ảnh hưởng Elo.',
            okText: 'Rời trận',
            cancelText: 'Đấu tiếp',
            danger: true
        });
        if (leave) {
            if (isRealMatch && currentRoom) {
                try {
                    await fetch(`/Home/LeaveArenaRoom?code=${encodeURIComponent(currentRoom.roomCode)}&playerId=${encodeURIComponent(MY_PLAYER_ID)}`, { method: 'POST' });
                } catch(e) {}
            }
            endGame(false, true, false, false, false);
        }
    });

    document.getElementById('btnPlayAgain')?.addEventListener('click', () => {
        result.classList.add('d-none');
        lobby.classList.remove('d-none');
    });

    // 6. GHÉP NHANH CÙNG BOT AI
    btnQuickMatch?.addEventListener('click', () => {
        startBotMatch("Bot tập");
    });

    // =========================================================================
    // KHỞI ĐỘNG TRẬN ĐẤU 1 VS 1 THẬT (PVP 2 CLIENT HOÀN TOÀN ĐỒNG BỘ)
    // =========================================================================
    async function startPvPMatch(room, isHostPlayer) {
        isRealMatch = true;
        currentRoom = room;
        isHost = isHostPlayer;
        opponentName = isHost ? (room.guest?.displayName || "Người Thách Đấu") : (room.host?.displayName || "Chủ Phòng");

        // Tải câu hỏi từ bộ đề của phòng đấu
        let rawQuestions = [];
        try {
            const resp = await fetch(`/Home/GetQuizQuestions/${room.contentId}`);
            if (!resp.ok) {
                EC.toast('Không tải được câu hỏi của bộ đề này, trận bị huỷ.', 'err');
                return;
            }
            rawQuestions = await resp.json();
        } catch (e) {
            EC.toast('Mất kết nối khi tải câu hỏi. Thử lại sau ít giây.', 'err');
            return;
        }

        if (!rawQuestions || rawQuestions.length === 0) {
            EC.toast('Bộ đề này chưa có câu hỏi nào. Hãy chọn bộ đề khác.', 'warn');
            return;
        }

        // ĐỒNG BỘ THỨ TỰ CÂU HỎI & ĐÁP ÁN BẰNG SEED TỪ SERVER PHÒNG ĐẤU
        const seed = room.seed || Math.abs((room.roomCode || 'EDU').split('').reduce((a, b) => { a = ((a << 5) - a) + b.charCodeAt(0); return a & a }, 0));
        const rng = createSeededRandom(seed);

        // Sắp xếp ID cố định trước, sau đó xáo trộn theo PRNG seed
        const sortedRaw = [...rawQuestions].sort((a, b) => String(a.questionId || a.QuestionId).localeCompare(String(b.questionId || b.QuestionId)));
        const shuffledQuestions = sortedRaw.sort(() => rng() - 0.5);
        const selectedQuestions = shuffledQuestions.slice(0, 20);

        currentQuestions = selectedQuestions.map(q => {
            const rawAns = q.answers || q.Answers || [];
            const sortedAns = [...rawAns].sort((a, b) => String(a.answerId || a.AnswerId).localeCompare(String(b.answerId || b.AnswerId)));
            const shuffledAnswers = sortedAns.sort(() => rng() - 0.5).map(a => ({
                id: a.answerId || a.AnswerId,
                text: a.answerText || a.AnswerText,
                isCorrect: a.isCorrect !== undefined ? a.isCorrect : a.IsCorrect
            }));

            return {
                text: q.questionText || q.QuestionText,
                answers: shuffledAnswers
            };
        });

        // Chuyển sang màn hình trận đấu
        lobby.classList.add('d-none');
        result.classList.add('d-none');
        battle.classList.remove('d-none');

        document.getElementById('battleSubjectInfo').innerText = `${room.subjectCode || ''} · ${room.subjectName || 'Đại cương'}`;
        

        // Khởi tạo trạng thái
        p1Hp = 200;
        p2Hp = 200;
        p1Score = 0;
        qIndex = 0;
        lastOpponentScore = 0;
        isWaitingOpponent = false;
        isMatchEnded = false;

        waitingOpponentCard?.classList.add('d-none');
        answersContainer?.classList.remove('d-none');

        p1Combo = 0;
        endingStarted = false;
        answersContainer.innerHTML = '';
        ArenaFX.reset();
        updateHealthUI();
        ArenaFX.intro(() => loadQuestion());

        // BẮT ĐẦU ĐỒNG BỘ TIẾN TRÌNH REAL-TIME GIỮA 2 CLIENT (MỖI 800MS)
        clearInterval(roomGameSyncTimer);
        roomGameSyncTimer = setInterval(async () => {
            if (isMatchEnded) {
                clearInterval(roomGameSyncTimer);
                return;
            }

            try {
                const resp = await fetch(`/Home/GetArenaRoom?code=${encodeURIComponent(currentRoom.roomCode)}`);
                if (!resp.ok) return;
                const updatedRoom = await resp.json();

                const opp = isHost ? updatedRoom.guest : updatedRoom.host;
                const me = isHost ? updatedRoom.host : updatedRoom.guest;

                // 1. Kiểm tra nếu đối thủ thoát trận giữa chừng -> Bạn THẮNG NGAY LẬP TỨC
                if (updatedRoom.status === 'Finished' && updatedRoom.abandonedByPlayerId) {
                    if (updatedRoom.abandonedByPlayerId !== MY_PLAYER_ID) {
                        clearInterval(roomGameSyncTimer);
                        clearInterval(timerTimer);
                        endGame(true, false, true, false, false);
                        return;
                    }
                }

                // 2. Đồng bộ đòn bắn của đối thủ khi đối thủ trả lời ĐÚNG
                if (opp) {
                    if (opp.score > lastOpponentScore) {
                        lastOpponentScore = opp.score;
                        triggerOpponentShot();
                    }
                }

                // 3. Kiểm tra ván đấu đã kết thúc từ server (cả 2 làm xong hết câu hỏi hoặc K.O.)
                if (updatedRoom.status === 'Finished') {
                    clearInterval(roomGameSyncTimer);
                    clearInterval(timerTimer);
                    isMatchEnded = true;

                    let won = false;
                    let draw = false;
                    let ko = (p1Hp <= 0 || p2Hp <= 0);

                    if (updatedRoom.winnerPlayerId === MY_PLAYER_ID) {
                        won = true;
                    } else if (updatedRoom.winnerPlayerId === 'DRAW') {
                        draw = true;
                    } else {
                        won = false;
                    }

                    endGame(won, false, false, ko, draw);
                }

            } catch (e) {}
        }, 800);
    }

    // =========================================================================
    // GHÉP NHANH CÙNG BOT AI (LUẬT CÔNG BẰNG: SAI KHÔNG BẮN, SO MÁU CUỐI TRẬN)
    // =========================================================================
    async function startBotMatch(botName) {
        isRealMatch = false;
        currentRoom = null;
        opponentName = botName;

        const selectedQuizId = quizSelect.value;
        if (!selectedQuizId) {
            EC.toast('Chọn một bộ đề trước khi vào trận.', 'warn');
            return;
        }

        let rawQuestions = [];
        try {
            const resp = await fetch(`/Home/GetQuizQuestions/${selectedQuizId}`);
            if (!resp.ok) {
                EC.toast('Không tải được câu hỏi của bộ đề này.', 'err');
                return;
            }
            rawQuestions = await resp.json();
        } catch (e) {
            EC.toast('Mất kết nối khi tải câu hỏi. Thử lại sau ít giây.', 'err');
            return;
        }

        if (!rawQuestions || rawQuestions.length === 0) {
            EC.toast('Bộ đề này chưa có câu hỏi nào. Hãy chọn bộ đề khác.', 'warn');
            return;
        }

        const shuffledQuestions = [...rawQuestions].sort(() => 0.5 - Math.random());
        const selectedQuestions = shuffledQuestions.slice(0, 20);

        currentQuestions = selectedQuestions.map(q => {
            const rawAns = q.answers || q.Answers || [];
            const shuffledAnswers = [...rawAns].sort(() => 0.5 - Math.random()).map(a => ({
                id: a.answerId || a.AnswerId,
                text: a.answerText || a.AnswerText,
                isCorrect: a.isCorrect !== undefined ? a.isCorrect : a.IsCorrect
            }));

            return {
                text: q.questionText || q.QuestionText,
                answers: shuffledAnswers
            };
        });

        lobby.classList.add('d-none');
        result.classList.add('d-none');
        battle.classList.remove('d-none');

        const subName = subSelect.options[subSelect.selectedIndex]?.dataset.name || "Kiến thức Đại học";
        document.getElementById('battleSubjectInfo').innerText = `${subName} · trận tập`;
        

        p1Hp = 200;
        p2Hp = 200;
        p1Score = 0;
        qIndex = 0;
        isWaitingOpponent = false;
        isMatchEnded = false;

        waitingOpponentCard?.classList.add('d-none');
        answersContainer?.classList.remove('d-none');

        p1Combo = 0;
        endingStarted = false;
        answersContainer.innerHTML = '';
        ArenaFX.reset();
        updateHealthUI();
        ArenaFX.intro(() => loadQuestion());
    }

    // =========================================================================
    // ĐIỀU KHIỂN CÂU HỎI & LỰA CHỌN ĐÁP ÁN (CHỈ ĐÚNG MỚI BẮN, SAI THÌ THÔI)
    // =========================================================================
    function loadQuestion() {
        if (qIndex >= currentQuestions.length || p1Hp <= 0 || p2Hp <= 0) {
            handleEndOfQuestions();
            return;
        }

        isSubmitting = false;
        clearInterval(timerTimer);
        timerVal = 15;
        updateTimerDisplay();

        const q = currentQuestions[qIndex];
        document.getElementById('questionNumberLabel').innerText = `${qIndex + 1}/${currentQuestions.length}`;
        ArenaFX.type(document.getElementById('questionText'), q.text);

        answersContainer.innerHTML = '';
        resetDeck(q.answers.length);

        q.answers.forEach((ans, idx) => {
            const letter = String.fromCharCode(65 + idx);
            const btn = document.createElement('button');
            btn.className = 'pixel-answer-row';
            btn.type = 'button';
            btn.innerHTML = `<span class="answer-key-letter">${letter}.</span> <span>${ans.text}</span>`;
            btn.onclick = () => chooseAnswer(ans, btn);
            answersContainer.appendChild(btn);
        });

        // Bắt đầu đếm ngược 15 giây
        timerTimer = setInterval(() => {
            timerVal--;
            updateTimerDisplay();
            if (timerVal <= 0) {
                clearInterval(timerTimer);
                // HẾT GIỜ: Coi như bỏ qua câu hỏi, KHÔNG AI BẮN
                chooseAnswer(null, null);
            }
        }, 1000);
    }

    function updateTimerDisplay() {
        const valStr = timerVal < 10 ? `0${timerVal}` : `${timerVal}`;
        document.getElementById('battleTimerText').innerText = `00:${valStr}`;
        document.getElementById('timerBox').classList.toggle('is-low', timerVal <= 5);
        ArenaFX.timer(timerVal);
    }

    function chooseAnswer(selectedAns, clickedBtn) {
        if (isSubmitting || isWaitingOpponent || isMatchEnded) return;
        isSubmitting = true;
        clearInterval(timerTimer);

        const isCorrect = selectedAns && selectedAns.isCorrect;

        // Vô hiệu hóa nút đáp án
        document.querySelectorAll('.pixel-answer-row').forEach(b => b.disabled = true);

        if (clickedBtn) {
            clickedBtn.classList.add(isCorrect ? 'correct-pick' : 'wrong-pick');
            lightDeck(clickedBtn, isCorrect);
        }

        if (isCorrect) {
            // BẠN TRẢ LỜI ĐÚNG -> BẠN ĐƯỢC BẮN ĐỐI THỦ (-20 HP)!
            p1Score++;
            p1Combo++;
            ArenaFX.combo(p1Combo);
            triggerPlayer1Shoot();

            // Gửi kết quả lên server nếu là trận đấu phòng thật
            if (isRealMatch && currentRoom) {
                fetch('/Home/SubmitArenaAnswer', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        roomCode: currentRoom.roomCode,
                        playerId: MY_PLAYER_ID,
                        questionIndex: qIndex,
                        isCorrect: true,
                        isFinished: (qIndex + 1 >= currentQuestions.length)
                    })
                }).catch(() => {});
            }

            // Kiểm tra K.O. đối thủ
            if (p2Hp <= 0) {
                setTimeout(() => {
                    endGame(true, false, false, true, false);
                }, 1000);
                return;
            }
        } else {
            // BẠN TRẢ LỜI SAI HOẶC HẾT GIỜ -> TUYỆT ĐỐI KHÔNG AI BẮN! CÔNG BẰNG TUYỆT ĐỐI!
            document.getElementById('battleLogText').innerHTML = '<span class="log-muted">Sai hoặc hết giờ: phép xịt khói, lượt này không ai trúng đòn.</span>';
            p1Combo = 0;
            ArenaFX.combo(0);
            ArenaFX.fizzle(1);

            // Gửi kết quả sai lên server
            if (isRealMatch && currentRoom) {
                fetch('/Home/SubmitArenaAnswer', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        roomCode: currentRoom.roomCode,
                        playerId: MY_PLAYER_ID,
                        questionIndex: qIndex,
                        isCorrect: false,
                        isFinished: (qIndex + 1 >= currentQuestions.length)
                    })
                }).catch(() => {});
            }
        }

        // Chuyển câu tiếp theo sau 1.2 giây
        setTimeout(() => {
            qIndex++;
            loadQuestion();
        }, 1200);
    }

    // XỬ LÝ KHI NGƯỜI CHƠI HOÀN THÀNH HẾT 20 CÂU HỎI
    function handleEndOfQuestions() {
        clearInterval(timerTimer);

        if (p1Hp <= 0) {
            endGame(false, false, false, true, false);
            return;
        }
        if (p2Hp <= 0) {
            endGame(true, false, false, true, false);
            return;
        }

        if (isRealMatch) {
            // NẾU LÀ TRẬN ĐẤU PHÒNG REAL-TIME:
            // Bạn đã xong 20 câu, NHƯNG ĐỐI THỦ CHƯA XONG -> BẠN PHẢI CHỜ ĐỐI THỦ!
            isWaitingOpponent = true;
            answersContainer?.classList.add('d-none');
            document.getElementById('waitingOpponentName').innerText = opponentName;
            waitingOpponentCard?.classList.remove('d-none');
            document.getElementById('battleTimerText').innerText = "--:--";
            document.getElementById('battleLogText').innerHTML = '<span class="log-wait">Bạn đã làm xong. Đang chờ đối thủ để so máu.</span>';
        } else {
            // Đấu với Bot: So sánh lượng máu sau khi xong 20 câu
            endGame(p1Hp > p2Hp, false, false, false, p1Hp === p2Hp);
        }
    }

    // HIỆU ỨNG BẮN ĐẠN & TRỪ MÁU
    function triggerPlayer1Shoot() {
        const crit = p1Combo >= 3;
        document.getElementById('battleLogText').innerHTML = crit
            ? `<span class="log-ok">COMBO x${p1Combo}! Phép cực mạnh trúng đối thủ, -20 HP.</span>`
            : '<span class="log-ok">Đúng! Phép của bạn trúng đối thủ, -20 HP.</span>';
        playWebAudio('shoot');
        ArenaFX.cast(1, crit);

        setTimeout(() => {
            p2Hp = Math.max(0, p2Hp - 20);
            updateHealthUI();
            showDamage(2, "-20");
            ArenaFX.impact(2, crit);
            playWebAudio('hit');
        }, 350);
    }

    function triggerOpponentShot() {
        document.getElementById('battleLogText').innerHTML = '<span class="log-bad">Đối thủ trả lời đúng, phép trúng bạn, -20 HP.</span>';
        playWebAudio('shoot');
        ArenaFX.cast(2);

        setTimeout(() => {
            p1Hp = Math.max(0, p1Hp - 20);
            updateHealthUI();
            showDamage(1, "-20");
            ArenaFX.impact(1);
            playWebAudio('hit');

            if (p1Hp <= 0) {
                setTimeout(() => {
                    endGame(false, false, false, true, false);
                }, 800);
            }
        }, 350);
    }

    function showDamage(target, text) {
        const pop = document.getElementById(target === 1 ? 'damagePop1' : 'damagePop2');
        pop.innerText = text;
        pop.classList.remove('d-none');
        setTimeout(() => pop.classList.add('d-none'), 800);
    }

    function updateHealthUI() {
        document.getElementById('p1HealthFill').style.transform = `scaleX(${p1Hp / 200})`;
        document.getElementById('p2HealthFill').style.transform = `scaleX(${p2Hp / 200})`;
        document.getElementById('p1NameTag').innerText = 'BAN';
        document.getElementById('p2NameTag').innerText = asciiName(opponentName);
        document.getElementById('p1HpText').innerText = `${p1Hp} HP`;
        document.getElementById('p2HpText').innerText = `${p2Hp} HP`;
        ArenaFX.health(p1Hp, p2Hp);
    }

    // =========================================================================
    // TỔNG KẾT TRẬN ĐẤU (SO SÁNH MÁU HOẶC XỬ THẮNG KHI ĐỐI THỦ THOÁT)
    // =========================================================================
    function endGame(isWon, isSurrendered, isOpponentLeft, isKo, isDraw) {
        if (endingStarted) return;
        endingStarted = true;
        isMatchEnded = true;
        clearInterval(timerTimer);
        clearInterval(roomGameSyncTimer);
        document.querySelectorAll('.pixel-answer-row, .arcade-btn').forEach(b => b.disabled = true);
        const kind = isSurrendered ? 'forfeit'
            : isDraw ? 'draw'
            : isWon ? (isKo ? 'ko-win' : 'win')
            : (isKo ? 'ko-lose' : 'lose');
        ArenaFX.outro(kind, () => {
            showResult(isWon, isSurrendered, isOpponentLeft, isKo, isDraw);
            if (isWon) ArenaFX.confetti(result);
        });
    }

    function showResult(isWon, isSurrendered, isOpponentLeft, isKo, isDraw) {
        isMatchEnded = true;
        clearInterval(timerTimer);
        clearInterval(roomGameSyncTimer);

        battle.classList.add('d-none');
        result.classList.remove('d-none');

        let icon = '#i-trophy', title, desc, elo, tone;
        if (isSurrendered) {
            icon = '#i-flag'; tone = 'lose'; elo = -20;
            title = 'Bạn đã rời trận';
            desc = `Rời trận giữa chừng nên ${opponentName} được xử thắng.`;
        } else if (isOpponentLeft) {
            tone = 'win'; elo = 25;
            title = 'Thắng! Đối thủ đã rời trận';
            desc = `${opponentName} thoát giữa chừng nên bạn được xử thắng.`;
        } else if (isKo && isWon) {
            icon = '#i-bolt'; tone = 'win'; elo = 30;
            title = 'Thắng knock-out!';
            desc = 'Đối thủ hết máu trước khi hết câu hỏi.';
        } else if (isKo) {
            icon = '#i-heart'; tone = 'lose'; elo = -20;
            title = 'Bạn bị knock-out';
            desc = 'Bạn hết máu trước. Ôn lại bộ đề rồi phục thù nhé.';
        } else if (isDraw) {
            icon = '#i-shield'; tone = 'draw'; elo = 5;
            title = 'Hoà!';
            desc = 'Hai bên còn lượng máu bằng nhau khi hết câu hỏi.';
        } else if (isWon) {
            tone = 'win'; elo = 25;
            title = 'Chiến thắng!';
            desc = `Hết câu hỏi, bạn còn ${p1Hp} HP, đối thủ còn ${p2Hp} HP.`;
        } else {
            icon = '#i-shield'; tone = 'lose'; elo = -15;
            title = 'Thua sát nút';
            desc = `Hết câu hỏi, bạn còn ${p1Hp} HP, đối thủ còn ${p2Hp} HP.`;
        }

        result.classList.remove('is-win', 'is-lose', 'is-draw');
        result.classList.add('is-' + tone);
        document.getElementById('resultIcon').setAttribute('href', icon);
        document.getElementById('resultTitle').innerText = title;
        document.getElementById('resultDesc').innerText = desc;

        const eloEl = document.getElementById('resultEloText');
        if (!isRealMatch) {
            eloEl.innerText = '—';
            eloEl.className = 'elo-flat';
            eloEl.title = 'Trận tập không tính Elo';
        } else {
            eloEl.innerText = (elo > 0 ? '+' : '') + elo;
            eloEl.className = elo > 0 ? 'elo-up' : (elo < 0 ? 'elo-down' : 'elo-flat');
        }

        document.getElementById('resultHpText').innerText = `${p1Hp}/200`;
        document.getElementById('resultScoreText').innerText = `${p1Score}/${currentQuestions.length}`;
        result.focus({ preventScroll: true });
        result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Font pixel không có dấu tiếng Việt: bỏ dấu cho nhãn trên đầu nhân vật.
    function asciiName(name) {
        return (name || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').toUpperCase().slice(0, 14);
    }

    // ---- Bàn điều khiển máy arcade: 4 nút A–D và phím tắt bàn phím ----
    const deckButtons = [...document.querySelectorAll('.arcade-btn')];

    function resetDeck(answerCount) {
        deckButtons.forEach((b, i) => {
            b.classList.remove('is-correct', 'is-wrong', 'is-pressed');
            b.disabled = i >= answerCount;
        });
    }

    function lightDeck(answerBtn, isCorrect) {
        const i = [...answersContainer.children].indexOf(answerBtn);
        deckButtons.forEach(b => b.disabled = true);
        if (deckButtons[i]) deckButtons[i].classList.add(isCorrect ? 'is-correct' : 'is-wrong');
    }

    function pressAnswer(i) {
        const target = answersContainer.children[i];
        if (!target || target.disabled || battle.classList.contains('d-none')) return;
        const deckBtn = deckButtons[i];
        if (deckBtn) {
            deckBtn.classList.add('is-pressed');
            setTimeout(() => deckBtn.classList.remove('is-pressed'), 140);
        }
        target.click();
    }

    deckButtons.forEach(b => b.addEventListener('click', () => pressAnswer(Number(b.dataset.pick))));

    document.addEventListener('keydown', (e) => {
        if (battle.classList.contains('d-none') || e.ctrlKey || e.metaKey || e.altKey) return;
        if (e.target instanceof Element && e.target.closest('input, textarea, select, dialog')) return;
        const map = { a: 0, b: 1, c: 2, d: 3, '1': 0, '2': 1, '3': 2, '4': 3 };
        const i = map[e.key.toLowerCase()];
        if (i === undefined) return;
        e.preventDefault();
        pressAnswer(i);
    });

    document.getElementById('btnRules')?.addEventListener('click', function () {
        const panel = document.getElementById('pixelRules');
        const open = panel.classList.toggle('d-none') === false;
        this.setAttribute('aria-expanded', String(open));
    });

    // TỰ ĐỘNG THÔNG BÁO RỜI TRẬN NẾU ĐÓNG TRÌNH DUYỆT
    window.addEventListener('beforeunload', () => {
        if (isRealMatch && currentRoom && !isMatchEnded) {
            navigator.sendBeacon(`/Home/LeaveArenaRoom?code=${encodeURIComponent(currentRoom.roomCode)}&playerId=${encodeURIComponent(MY_PLAYER_ID)}`);
        }
    });
</script>
}

                    roomCode: validCode,
                    playerId: MY_PLAYER_ID
                })
            });

            if (!resp.ok) {
                const err = await resp.json();
                EC.toast(err.message || `Không vào được phòng ${validCode}: mã sai hoặc phòng đã đủ người.`, 'err', 7000);
                btnJoinRoom.disabled = false;

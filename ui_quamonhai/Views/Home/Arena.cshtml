        } catch (e) {
            EC.toast('Mất kết nối khi vào phòng. Kiểm tra mạng rồi thử lại.', 'err');
        } finally {
            btnJoinRoom.disabled = false;
            btnJoinRoom.innerHTML = 'Vào';
        }
    });

    // 3. HỦY PHÒNG ĐÃ TẠO
    document.getElementById('btnCancelRoom')?.addEventListener('click', async () => {
        clearInterval(roomPollTimer);
        if (currentRoom) {
            try {
                await fetch(`/Home/LeaveArenaRoom?code=${encodeURIComponent(currentRoom.roomCode)}&playerId=${encodeURIComponent(MY_PLAYER_ID)}`, { method: 'POST' });

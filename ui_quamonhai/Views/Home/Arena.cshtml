@{
    ViewData["Title"] = "Đấu Trí — Đấu Trường Tri Thức EduClash";
    var userProfile = ViewBag.CurrentUser as UserProfileViewModel;
    var subjects = ViewBag.Subjects as List<SubjectViewModel> ?? new List<SubjectViewModel>();
    var quizzes = ViewBag.Quizzes as List<ContentItemViewModel> ?? new List<ContentItemViewModel>();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet">

<div class="pvp-wrapper py-4">

    <!-- =========================================================================
         1. MÀN HÌNH SẢNH CHỜ (LOBBY)
         ========================================================================= -->
    <div id="lobbyScreen" class="lobby-card">
        <div class="text-center mb-4">
            <span class="arena-top-icon">⚔️</span>
            <h2 class="mt-2 text-navy fw-bold">Đấu Trí — Đấu Trường Tri Thức</h2>
            <p class="text-muted">Thách đấu so tài kiến thức trực tiếp, kiểm tra tốc độ phản xạ và bứt phá thứ hạng Elo chuẩn thể thao điện tử.</p>
        </div>

        <!-- Profile Người chơi -->
        <div class="player-card-preview mb-4">
            <div class="d-flex align-items-center gap-3">
                <div class="user-avatar-box">
                    @if (!string.IsNullOrEmpty(userProfile?.AvatarUrl))
                    {
                        <img src="@userProfile.AvatarUrl" alt="Avatar" class="avatar-img" />
                    }
                    else
                    {
                        <span>@(string.IsNullOrEmpty(userProfile?.DisplayName) ? "U" : userProfile.DisplayName.Substring(0, 1).ToUpper())</span>
                    }
                </div>
                <div>
                    <h4 class="mb-0 text-dark fw-bold">@(userProfile?.DisplayName ?? "Đấu thủ Khách")</h4>
                    <span class="text-muted small">Cấp @(userProfile?.Level ?? 1) • Rank: @(userProfile?.RankTier ?? "Đồng")</span>
                </div>
            </div>
            <div class="text-end">
                <div class="fw-bold fs-4 text-warning">⚡ @(userProfile?.Rating ?? 1000) Elo</div>
                <span class="text-success small fw-semibold">Thắng: @(userProfile?.Wins ?? 0) | Thua: @(userProfile?.Losses ?? 0) | Xu: @(userProfile?.Coins ?? 50) 🪙</span>
            </div>
        </div>

        <!-- Chọn Chế Độ Thi Đấu -->
        <div class="mb-4">
            <label class="form-label fw-bold mb-2">Chế Độ Thi Đấu:</label>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="game-mode-card active">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="mode-icon">⚔️</span>
                            <span class="mode-badge ready">● Khả dụng</span>
                        </div>
                        <div class="mode-title">Đấu 1 vs 1 (Pixel Duel 200 HP)</div>
                        <p class="mode-desc">200 HP đối kháng, mỗi phát đạn đúng -20 HP. Bên nào hết máu trước hoặc ít máu hơn khi hết câu sẽ thua cuộc!</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="game-mode-card opacity-75">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="mode-icon">👑</span>
                            <span class="mode-badge coming-soon">⏳ Sắp ra mắt</span>
                        </div>
                        <div class="mode-title">Đấu Nhiều Người (Multiplayer)</div>
                        <p class="mode-desc">Đấu trường hỗn chiến 4 - 8 người hoặc thi đấu theo phòng riêng giữa các lớp.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- BƯỚC 1: CHỌN MÔN HỌC -->
        <div class="mb-4">
            <label class="form-label fw-bold mb-2">1. Chọn Môn Học Thách Đấu: <span class="text-danger">*</span></label>
            <select id="selectSubject" class="form-select py-2">
                @foreach (var s in subjects)
                {
                    <option value="@s.SubjectId" data-code="@s.Code" data-name="@s.Name">
                        📘 [@s.Code] @s.Name
                    </option>
                }
            </select>
        </div>

        <!-- BƯỚC 2: CHỌN BỘ ĐỀ THÁCH ĐẤU TRONG MÔN HỌC (ĐỀ IMPORT) -->
        <div class="mb-4" id="quizSelectSection">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <label class="form-label fw-bold mb-0">2. Chọn Đề Thi Đấu (Đề được Import): <span class="text-danger">*</span></label>
                <span class="badge bg-primary px-3 py-1" id="quizCountBadge">0 đề import</span>
            </div>

            <!-- Ô TÌM KIẾM ĐỀ THI TRỰC TIẾP -->
            <div class="input-group mb-2" id="quizSearchGroup">
                <span class="input-group-text bg-white border-end-0 text-muted">🔍</span>
                <input type="text" id="searchQuizInput" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm tên đề thi, người import (bản thân / người khác), thẻ tag..." autocomplete="off" />
                <button class="btn btn-outline-secondary" type="button" id="btnClearSearchQuiz" style="display:none;" title="Xóa tìm kiếm">✕</button>
            </div>

            <!-- DROPDOWN CHỌN ĐỀ THI -->
            <select id="selectQuiz" class="form-select py-2">
                <!-- Được cập nhật tự động khi chọn môn hoặc tìm kiếm -->
            </select>

            <!-- THẺ XEM TRƯỚC BỘ ĐỀ ĐÃ CHỌN -->
            <div id="selectedQuizPreviewCard" class="card border-success-subtle bg-light mt-2 p-3 d-none">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <div class="fw-bold text-dark fs-6" id="previewQuizTitle">Tên đề thi</div>
                        <div class="small text-muted mt-1 d-flex gap-2 align-items-center flex-wrap">
                            <span id="previewQuizAuthor" class="badge bg-secondary">Tác giả</span>
                            <span id="previewQuizDiff" class="text-muted">Độ khó: Medium</span>
                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">🎲 Tự động bốc ngẫu nhiên 20 câu khi vào trận</span>
                        </div>
                    </div>
                    <span class="badge bg-success px-3 py-2 fw-bold">✓ Đã Sẵn Sàng Vào Đấu</span>
                </div>
            </div>
            
            <!-- THÔNG BÁO KHI MÔN CHƯA CÓ ĐỀ ĐƯỢC IMPORT -->
            <div id="noQuizAlert" class="alert alert-danger border-2 border-danger-subtle d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between p-3 rounded-3 mt-3 gap-3 d-none">
                <div class="d-flex align-items-center gap-3">
                    <span class="fs-1">🚫</span>
                    <div>
                        <div class="fw-bold text-danger fs-6" id="noQuizTitle">Môn này chưa có bộ đề thi nào được import!</div>
                        <div class="small text-muted">
                            Đấu trường yêu cầu phải có đề thi thực tế (được import từ bản thân hoặc người khác) mới được thi đấu để lấy ngẫu nhiên 20 câu hỏi. Hiện tại không có đề thi nào nên <strong>KHÔNG ĐƯỢC PHÉP THI ĐẤU</strong>. Bạn có thể tự import tài liệu đề thi vào.
                        </div>
                    </div>
                </div>
                <a href="/Outline/Import" class="btn btn-danger fw-bold text-white text-nowrap px-3 py-2 shadow-sm">
                    📥 Import Đề Thi / Đề Cương &rarr;
                </a>
            </div>
        </div>

        <!-- KHU VỰC VÀO ĐẤU TRƯỜNG -->
        <div class="arena-match-actions mt-4 pt-4 border-top">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="action-card p-3 text-center h-100 d-flex flex-column justify-content-between">
                        <div>
                            <span class="fs-1 mb-2 d-inline-block">⚡</span>
                            <h5 class="fw-bold text-dark">Ghép Nhanh</h5>
                            <p class="small text-muted">Tự động tìm kiếm đối thủ đang trực tuyến hoặc so tài cùng AI Bot.</p>
                        </div>
                        <button type="button" class="btn btn-success fw-bold w-100 py-2 mt-3" id="btnQuickMatch">
                            ⚔️ Tìm Trận Ngay
                        </button>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="action-card p-3 text-center h-100 d-flex flex-column justify-content-between">
                        <div>
                            <span class="fs-1 mb-2 d-inline-block">🏠</span>
                            <h5 class="fw-bold text-dark">Tạo Phòng Riêng</h5>
                            <p class="small text-muted">Tạo phòng và nhận mã mời 6 chữ số để thách đấu cùng bạn bè.</p>
                        </div>
                        <button type="button" class="btn btn-outline-primary fw-bold w-100 py-2 mt-3" id="btnCreateRoom">
                            + Tạo Mã Phòng
                        </button>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="action-card p-3 text-center h-100 d-flex flex-column justify-content-between">
                        <div>
                            <span class="fs-1 mb-2 d-inline-block">🔑</span>
                            <h5 class="fw-bold text-dark">Nhập Mã Phòng</h5>
                            <p class="small text-muted">Nhập mã phòng do bạn bè chia sẻ để tham gia thách đấu.</p>
                        </div>
                        <div class="input-group mt-3">
                            <input type="text" id="inputRoomCode" class="form-control text-uppercase font-monospace text-center fw-bold" placeholder="VD: EDU-8924" maxlength="25" autocomplete="off" />
                            <button class="btn btn-primary fw-bold px-3" type="button" id="btnJoinRoom">Vào ➔</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Box chờ tạo phòng (Ẩn ban đầu) -->
        <div id="createdRoomBox" class="created-room-box text-center p-4 mt-4 d-none">
            <span class="badge bg-success px-3 py-1 mb-2 fw-bold">🟢 PHÒNG ĐẤU ĐÃ SẴN SÀNG</span>
            <h4 class="fw-bold text-dark mt-2">Mã Phòng Của Bạn:</h4>
            <div class="d-flex align-items-center justify-content-center gap-2 my-3">
                <input type="text" id="displayRoomCode" class="room-code-badge form-control text-center text-primary fw-bold font-monospace" style="max-width: 240px; font-size: 1.4rem; cursor: pointer;" readonly onclick="this.select();" value="EDU-9921" />
                <button type="button" class="btn btn-outline-primary px-3 py-2 fw-semibold" id="btnCopyCode">📋 Sao chép</button>
            </div>
            <div class="d-flex align-items-center justify-content-center gap-2 text-muted mb-3">
                <span class="spinner-border spinner-border-sm text-primary"></span>
                <span>Đang chờ đối thủ nhập mã để vào phòng đấu...</span>
            </div>
            <p class="text-muted small">Hãy gửi mã này cho bạn bè. Khi bạn bè nhập mã và xác nhận, cả 2 sẽ tự động vào phòng đấu ngay!</p>
            <button type="button" class="btn btn-danger px-4" id="btnCancelRoom">✕ Hủy phòng</button>
        </div>
    </div>

    <!-- =========================================================================
         2. MÀN HÌNH ĐẤU SÚNG PIXEL ART (BATTLEFIELD)
         ========================================================================= -->
    <div id="battleScreen" class="pixel-arena-container d-none">
        
        <!-- Top bar điều khiển -->
        <div class="pixel-arena-top-bar d-flex justify-content-between align-items-center px-3 py-2">
            <div class="d-flex align-items-center gap-2">
                <span class="pixel-mode-pill">⚔️ 1 VS 1 ĐẤU TRÍ PIXEL</span>
                <span class="text-white-50 small" id="battleSubjectInfo">| Môn Học</span>
            </div>
            <button class="pixel-btn-action btn-surrender" type="button" id="btnSurrender">
                🚪 Rời Trận
            </button>
        </div>

        <!-- Banner Câu hỏi Pixel -->
        <div class="pixel-top-banner">
            <div class="pixel-banner-inner">
                <span class="pixel-gold-label" id="questionNumberLabel">CÂU 1/10: </span>
                <span class="pixel-question-text" id="questionText">Đang chuẩn bị câu hỏi...</span>
            </div>
        </div>

        <!-- Chiến trường Pixel -->
        <div class="pixel-battlefield">
            <div class="pixel-sky-elements">
                <div class="pixel-cloud cloud-pos-1"></div>
                <div class="pixel-cloud cloud-pos-2"></div>
            </div>
            <div class="pixel-hills-backdrop"></div>
            <div class="pixel-scenery-tree tree-left"><div class="tree-foliage"></div><div class="tree-trunk"></div></div>
            <div class="pixel-scenery-tree tree-right"><div class="tree-foliage"></div><div class="tree-trunk"></div></div>

            <!-- ĐẤU THỦ 1 (BẠN - XANH DƯƠNG) -->
            <div class="pixel-fighter-station station-left">
                <div class="fighter-header">
                    <span class="fighter-tag-title" id="p1NameTag">BẠN • 200/200 HP</span>
                    <div class="pixel-health-bar-frame">
                        <div class="pixel-health-bar-fill fill-green" id="p1HealthFill" style="width: 100%;"></div>
                    </div>
                </div>
                <div class="floating-damage-popup popup-left d-none" id="damagePop1">-20 HP</div>
                <div class="pixel-guy-model blue-guy act-idle" id="guy1">
                    <div class="guy-head head-blue"><div class="guy-eyes"><span class="eye-dot"></span><span class="eye-dot"></span></div></div>
                    <div class="guy-torso torso-blue"></div>
                    <div class="guy-legs"><span class="leg-pixel leg-blue"></span><span class="leg-pixel leg-blue"></span></div>
                    <div class="guy-gun-arm arm-right"><div class="pixel-pistol pistol-right"><div class="pixel-muzzle-flash flash-right d-none" id="flash1"></div></div></div>
                </div>
            </div>

            <!-- VIÊN ĐẠN BAY -->
            <div class="pixel-flying-bullet bullet-move-right d-none" id="bullet1"><div class="bullet-sparkle"></div></div>
            <div class="pixel-flying-bullet bullet-move-left d-none" id="bullet2"><div class="bullet-sparkle"></div></div>

            <!-- ĐẤU THỦ 2 (ĐỐI THỦ - ĐỎ) -->
            <div class="pixel-fighter-station station-right">
                <div class="fighter-header">
                    <span class="fighter-tag-title" id="p2NameTag">ĐỐI THỦ • 200/200 HP</span>
                    <div class="pixel-health-bar-frame">
                        <div class="pixel-health-bar-fill fill-red" id="p2HealthFill" style="width: 100%;"></div>
                    </div>
                </div>
                <div class="floating-damage-popup popup-right d-none" id="damagePop2">-20 HP</div>
                <div class="pixel-guy-model red-guy act-idle" id="guy2">
                    <div class="guy-head head-red"><div class="guy-eyes"><span class="eye-dot"></span><span class="eye-dot"></span></div></div>
                    <div class="guy-torso torso-red"></div>
                    <div class="guy-legs"><span class="leg-pixel leg-red"></span><span class="leg-pixel leg-red"></span></div>
                    <div class="guy-gun-arm arm-left"><div class="pixel-pistol pistol-left"><div class="pixel-muzzle-flash flash-left d-none" id="flash2"></div></div></div>
                </div>
            </div>

            <div class="pixel-grass-floor"><div class="grass-tuft tuft-1"></div><div class="grass-tuft tuft-2"></div><div class="grass-tuft tuft-3"></div></div>
        </div>

        <!-- BOTTOM HUD PIXEL -->
        <div class="pixel-bottom-hud">
            <div class="hud-col-left">
                <div class="pixel-chat-console">
                    <div class="chat-screen-window">
                        <div class="chat-system-log" id="battleLogText">Sẵn sàng! Trả lời đúng để bắn đối thủ (-20 HP).</div>
                    </div>
                    <div class="chat-input-row">
                        <span class="chat-title-text">LOG</span>
                        <span class="chat-bubble-icon">💬</span>
                    </div>
                </div>
                <div class="pixel-btn-badge-1v1">1 vs 1</div>
            </div>

            <!-- HỘP 4 ĐÁP ÁN -->
            <div class="hud-col-center">
                <div class="pixel-answers-board">
                    <div class="answers-buttons-stack" id="answersContainer">
                        <!-- Render 4 nút A, B, C, D bằng JavaScript -->
                    </div>
                    <div id="waitingOpponentCard" class="pixel-waiting-opponent-card p-3 text-center d-none" style="background: rgba(15, 23, 42, 0.95); border: 2px dashed #F59E0B; border-radius: 8px;">
                        <div class="spinner-border text-warning mb-2" style="width: 1.8rem; height: 1.8rem;" role="status"></div>
                        <div class="fw-bold text-warning font-monospace fs-6 mb-1">⏳ ĐÃ HOÀN THÀNH TOÀN BỘ 20 CÂU HỎI!</div>
                        <div class="text-white-50 font-monospace small">
                            Đang chờ <strong id="waitingOpponentName" class="text-warning">đối thủ</strong> hoàn thành các câu hỏi...<br />
                            Cả 2 sẽ cùng lúc xem kết quả tổng kết sau khi ván đấu kết thúc.
                        </div>
                    </div>
                </div>
            </div>

            <!-- GÓC PHẢI: ĐỒNG HỒ ĐẾM NGƯỢC -->
            <div class="hud-col-right">
                <button class="pixel-info-button" title="200 HP, mỗi câu đúng bắn đối thủ -20 HP">INFO</button>
                <div class="pixel-timer-console" id="timerBox">
                    <span class="timer-value" id="battleTimerText">00:15</span>
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================================================
         3. MÀN HÌNH KẾT QUẢ TRẬN ĐẤU (RESULT SCREEN)
         ========================================================================= -->
    <div id="resultScreen" class="lobby-card text-center py-5 d-none">
        <span style="font-size: 4.5rem;" id="resultIcon">🏆</span>
        <h2 class="fw-bold mt-2" id="resultTitle">CHIẾN THẮNG TUYỆT ĐỐI!</h2>
        <p class="text-muted" id="resultDesc">Bạn đã thi đấu xuất sắc và giành chiến thắng chung cuộc.</p>

        <div class="row g-3 justify-content-center my-4" style="max-width: 600px; margin: 0 auto;">
            <div class="col-4">
                <div class="card p-3 border-0 shadow-sm bg-light rounded-3">
                    <div class="text-muted small">Điểm Elo</div>
                    <div class="fs-4 fw-bold text-success" id="resultEloText">+25 Elo</div>
                </div>
            </div>
            <div class="col-4">
                <div class="card p-3 border-0 shadow-sm bg-light rounded-3">
                    <div class="text-muted small">Máu còn lại</div>
                    <div class="fs-4 fw-bold text-primary" id="resultHpText">160 HP</div>
                </div>
            </div>
            <div class="col-4">
                <div class="card p-3 border-0 shadow-sm bg-light rounded-3">
                    <div class="text-muted small">Số câu đúng</div>
                    <div class="fs-4 fw-bold text-warning" id="resultScoreText">8 / 10</div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-3">
            <button type="button" class="btn btn-success fw-bold px-4 py-2" id="btnPlayAgain">
                🔄 Chơi Trận Tiếp Theo
            </button>
            <a href="/Home/Leaderboard" class="btn btn-outline-secondary fw-bold px-4 py-2">
                🏆 Xem Bảng Xếp Hạng
            </a>
        </div>
    </div>

</div>

<!-- CSS RETRO PIXEL STYLES GỐC ĐẦY ĐỦ -->
<style>
    .pvp-wrapper { max-width: 960px; margin: 0 auto; }
    .arena-top-icon { font-size: 3.2rem; display: inline-block; }
    .lobby-card { background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 16px; padding: 2.2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    .player-card-preview { display: flex; justify-content: space-between; align-items: center; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 14px; padding: 1.25rem 1.75rem; }
    .user-avatar-box { width: 48px; height: 48px; border-radius: 50%; background: #3B82F6; color: #FFF; display: flex; align-items: center; justify-content: center; font-weight: bold; overflow: hidden; }
    .avatar-img { width: 100%; height: 100%; object-fit: cover; }
    .game-mode-card { border: 2px solid #E2E8F0; border-radius: 14px; padding: 1.2rem; background: #FFFFFF; cursor: pointer; transition: all 0.2s; }
    .game-mode-card.active { border-color: #10B981; background: #F0FDF4; box-shadow: 0 4px 14px rgba(16,185,129,0.15); }
    .mode-icon { font-size: 1.6rem; }
    .mode-badge.ready { color: #059669; font-weight: bold; font-size: 0.75rem; }
    .mode-badge.coming-soon { color: #64748B; font-size: 0.75rem; }
    .mode-title { font-weight: 700; color: #0F172A; margin: 4px 0; }
    .mode-desc { font-size: 0.8rem; color: #64748B; margin: 0; }
    .action-card { background: #FFFFFF; border: 1.5px solid #E2E8F0; border-radius: 16px; transition: all 0.2s; }
    .action-card:hover { border-color: #6366F1; box-shadow: 0 8px 20px rgba(0,0,0,0.06); }
    .created-room-box { background: #F8FAFC; border: 2px dashed #4F46E5; border-radius: 16px; }
    .room-code-badge { font-family: 'Silkscreen', monospace; font-size: 1.8rem; font-weight: 800; color: #4F46E5; letter-spacing: 3px; background: #EEF2FF; border: 2px solid #818CF8; padding: 8px 20px; border-radius: 10px; }

    /* PIXEL ARENA CONTAINER */
    .pixel-arena-container {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        background: #468ac9;
        border: 4px solid #0b2545;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
        position: relative;
    }
    .pixel-arena-top-bar { background: #0b2545; color: #FFFFFF; }
    .pixel-mode-pill { background: #134074; color: #F1D302; font-family: 'Silkscreen', monospace; font-size: 0.75rem; padding: 4px 10px; border-radius: 4px; border: 1px solid #F1D302; }
    .pixel-btn-action { background: #E63946; color: #FFFFFF; border: 2px solid #FFFFFF; font-family: 'Silkscreen', monospace; font-size: 0.75rem; padding: 4px 12px; border-radius: 4px; cursor: pointer; }

    /* TOP BANNER */
    .pixel-top-banner { padding: 12px 18px; background: #0b2545; border-bottom: 3px solid #134074; }
    .pixel-banner-inner { background: #1d3557; border: 2px solid #457b9d; border-radius: 8px; padding: 10px 16px; color: #FFFFFF; }
    .pixel-gold-label { color: #F1D302; font-family: 'Silkscreen', monospace; font-size: 0.95rem; font-weight: 700; }
    .pixel-question-text { font-size: 0.95rem; font-weight: 600; }

    /* BATTLEFIELD */
    .pixel-battlefield {
        height: 250px;
        position: relative;
        overflow: hidden;
        background: linear-gradient(180deg, #3a86c8 0%, #72a9db 65%, #9bc1e4 100%);
    }
    .pixel-hills-backdrop { position: absolute; bottom: 35px; left: 0; width: 100%; height: 75px; background: #5c9e42; border-radius: 50% 50% 0 0 / 25px 25px 0 0; }
    .pixel-scenery-tree { position: absolute; bottom: 35px; width: 40px; height: 80px; z-index: 2; }
    .tree-left { left: 40px; } .tree-right { right: 40px; }
    .tree-foliage { width: 44px; height: 50px; background: #2d6a4f; border-radius: 8px; border: 2px solid #1b4332; }
    .tree-trunk { width: 12px; height: 30px; background: #7f4f24; margin: 0 auto; border: 2px solid #582f0e; }
    .pixel-grass-floor { position: absolute; bottom: 0; width: 100%; height: 35px; background: #386641; border-top: 4px solid #6a994e; z-index: 3; }

    /* FIGHTERS */
    .pixel-fighter-station { position: absolute; bottom: 35px; z-index: 5; text-align: center; width: 140px; }
    .station-left { left: 80px; } .station-right { right: 80px; }
    .fighter-header { background: rgba(11,37,69,0.85); padding: 4px 8px; border-radius: 6px; border: 1px solid #FFF; margin-bottom: 8px; }
    .fighter-tag-title { color: #FFF; font-family: 'Silkscreen', monospace; font-size: 0.65rem; font-weight: 700; display: block; }
    .pixel-health-bar-frame { height: 10px; background: #1F2937; border: 1px solid #FFF; border-radius: 3px; overflow: hidden; margin-top: 2px; }
    .pixel-health-bar-fill { height: 100%; transition: width 0.3s; }
    .fill-green { background: #10B981; } .fill-red { background: #EF4444; }

    .floating-damage-popup { position: absolute; top: -30px; font-family: 'Silkscreen', monospace; font-size: 1.2rem; font-weight: 800; color: #EF4444; text-shadow: 2px 2px #000; animation: floatUp 0.8s forwards; }
    @@keyframes floatUp { 0% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(-30px); } }

    /* PIXEL CHARACTERS */
    .pixel-guy-model { width: 50px; height: 75px; margin: 0 auto; position: relative; }
    .guy-head { width: 28px; height: 26px; border-radius: 4px; margin: 0 auto; position: relative; border: 2px solid #000; }
    .head-blue { background: #0284C7; } .head-red { background: #DC2626; }
    .guy-eyes { display: flex; gap: 8px; justify-content: center; padding-top: 6px; }
    .eye-dot { width: 4px; height: 5px; background: #FFF; border: 1px solid #000; display: inline-block; }
    .guy-torso { width: 34px; height: 30px; margin: 0 auto; border: 2px solid #000; border-radius: 3px; }
    .torso-blue { background: #0369A1; } .torso-red { background: #B91C1C; }
    .guy-legs { display: flex; justify-content: space-around; width: 30px; margin: 0 auto; }
    .leg-pixel { width: 10px; height: 16px; background: #1E293B; border: 2px solid #000; }
    .guy-gun-arm { position: absolute; top: 30px; }
    .arm-right { right: -16px; } .arm-left { left: -16px; }
    .pixel-pistol { width: 18px; height: 12px; background: #334155; border: 1.5px solid #000; position: relative; }
    .pixel-muzzle-flash { position: absolute; width: 14px; height: 14px; background: #FBBF24; border-radius: 50%; box-shadow: 0 0 10px #F59E0B; }
    .flash-right { right: -12px; top: -1px; } .flash-left { left: -12px; top: -1px; }

    /* BULLETS */
    .pixel-flying-bullet { position: absolute; bottom: 85px; width: 18px; height: 8px; background: #FBBF24; border: 1.5px solid #000; z-index: 6; border-radius: 3px; }
    .bullet-move-right { left: 160px; animation: flyRight 0.35s linear forwards; }
    .bullet-move-left { right: 160px; animation: flyLeft 0.35s linear forwards; }
    @@keyframes flyRight { 0% { left: 160px; } 100% { left: calc(100% - 170px); } }
    @@keyframes flyLeft { 0% { right: 160px; } 100% { right: calc(100% - 170px); } }

    /* BOTTOM HUD */
    .pixel-bottom-hud { background: #0b2545; padding: 12px 18px; display: grid; grid-template-columns: 200px 1fr 140px; gap: 14px; border-top: 3px solid #134074; }
    .pixel-chat-console { background: #1d3557; border: 2px solid #457b9d; border-radius: 6px; padding: 6px; }
    .chat-screen-window { height: 65px; overflow-y: auto; font-size: 0.72rem; color: #E2E8F0; }
    .chat-input-row { display: flex; justify-content: space-between; font-size: 0.65rem; color: #94A3B8; font-weight: bold; border-top: 1px solid #457b9d; padding-top: 3px; }
    .pixel-btn-badge-1v1 { background: #134074; color: #FFF; font-family: 'Silkscreen', monospace; text-align: center; font-size: 0.7rem; padding: 2px; margin-top: 4px; border-radius: 3px; }

    /* ANSWERS */
    .pixel-answers-board { background: #1d3557; border: 2px solid #457b9d; border-radius: 8px; padding: 8px; }
    .answers-buttons-stack { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .pixel-answer-row { background: #0b2545; color: #FFF; border: 2px solid #457b9d; border-radius: 6px; padding: 10px 14px; text-align: left; font-size: 0.88rem; cursor: pointer; transition: all 0.15s; display: flex; align-items: center; gap: 8px; }
    .pixel-answer-row:hover:not(:disabled) { background: #1e3a8a; border-color: #60a5fa; transform: translateY(-1px); }
    .pixel-answer-row.correct-pick { background: #065f46 !important; border-color: #10B981 !important; }
    .pixel-answer-row.wrong-pick { background: #7f1d1d !important; border-color: #EF4444 !important; }
    .answer-key-letter { color: #F1D302; font-family: 'Silkscreen', monospace; font-weight: bold; }

    /* TIMER */
    .pixel-info-button { background: #457b9d; color: #FFF; border: 2px solid #FFF; font-family: 'Silkscreen', monospace; font-size: 0.7rem; width: 100%; padding: 4px; border-radius: 4px; cursor: pointer; margin-bottom: 6px; }
    .pixel-timer-console { background: #1d3557; border: 2px solid #F1D302; border-radius: 6px; text-align: center; padding: 12px 6px; }
    .timer-value { font-family: 'Press Start 2P', monospace; font-size: 0.9rem; color: #F1D302; }
</style>

@section Scripts {
<script>
    // Thông tin người dùng hiện tại
    const CURRENT_USER_ID = "@(userProfile?.UserId.ToString() ?? "")";
    let MY_PLAYER_ID = CURRENT_USER_ID;
    if (!MY_PLAYER_ID) {
        MY_PLAYER_ID = sessionStorage.getItem('arena_player_id');
        if (!MY_PLAYER_ID) {
            MY_PLAYER_ID = 'p_' + Math.random().toString(36).substring(2, 10);
            sessionStorage.setItem('arena_player_id', MY_PLAYER_ID);
        }
    }

    // Dữ liệu bộ đề từ server (Đề import từ bản thân hoặc người khác - TUYỆT ĐỐI KHÔNG TẠO DỮ LIỆU ẢO)
    const ALL_QUIZZES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(quizzes, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

    // State Variables
    let currentQuestions = [];
    let qIndex = 0;
    let p1Hp = 200;
    let p2Hp = 200;
    let p1Score = 0;
    let timerVal = 15;
    let timerTimer = null;
    let isSubmitting = false;

    let isRealMatch = false;
    let currentRoom = null;
    let isHost = false;
    let roomPollTimer = null;
    let roomGameSyncTimer = null;
    let lastOpponentScore = 0;
    let isWaitingOpponent = false;
    let isMatchEnded = false;
    let opponentName = "Đối Thủ";

    const lobby = document.getElementById('lobbyScreen');
    const battle = document.getElementById('battleScreen');
    const result = document.getElementById('resultScreen');
    const subSelect = document.getElementById('selectSubject');
    const quizSelect = document.getElementById('selectQuiz');
    const noQuizAlert = document.getElementById('noQuizAlert');
    const btnQuickMatch = document.getElementById('btnQuickMatch');
    const btnCreateRoom = document.getElementById('btnCreateRoom');
    const btnJoinRoom = document.getElementById('btnJoinRoom');
    const searchQuizInput = document.getElementById('searchQuizInput');
    const btnClearSearchQuiz = document.getElementById('btnClearSearchQuiz');
    const quizSearchGroup = document.getElementById('quizSearchGroup');
    const selectedQuizPreviewCard = document.getElementById('selectedQuizPreviewCard');
    const quizCountBadge = document.getElementById('quizCountBadge');
    const waitingOpponentCard = document.getElementById('waitingOpponentCard');
    const answersContainer = document.getElementById('answersContainer');

    // ÂM THANH RETRO WEB AUDIO API
    function playWebAudio(soundType) {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            if (soundType === 'shoot') {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'square';
                osc.frequency.setValueAtTime(880, ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(160, ctx.currentTime + 0.12);
                gain.gain.setValueAtTime(0.25, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.12);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.12);
            } else if (soundType === 'hit') {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(150, ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(30, ctx.currentTime + 0.22);
                gain.gain.setValueAtTime(0.35, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.22);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.22);
            }
        } catch(e) {}
    }

    // SAO CHÉP MÃ PHÒNG CHUẨN ĐA NỀN TẢNG (CÓ FALLBACK TEXTAREA)
    function copyRoomCode() {
        const codeInput = document.getElementById('displayRoomCode');
        const code = codeInput ? (codeInput.value || codeInput.innerText || '').trim() : '';
        if (!code) return;

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(code).then(() => {
                alert("✅ Đã sao chép mã phòng: " + code);
            }).catch(() => fallbackCopy(code));
        } else {
            fallbackCopy(code);
        }
    }

    function fallbackCopy(code) {
        const ta = document.createElement('textarea');
        ta.value = code;
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        try {
            document.execCommand('copy');
            alert("✅ Đã sao chép mã phòng: " + code);
        } catch (e) {
            prompt("Mã phòng của bạn (Nhấn Ctrl+C để sao chép):", code);
        }
        document.body.removeChild(ta);
    }

    // XỬ LÝ & KIỂM TRA MÃ PHÒNG (LOẠI BỎ LINK WEBSITE & BÁO LỖI NẾU NHẬP LINK)
    function validateRoomCode(rawInput) {
        if (!rawInput) {
            alert("⚠️ Vui lòng nhập mã phòng đấu!");
            return null;
        }

        let code = rawInput.trim();

        // Kiểm tra người dùng có lỡ dán cả đường link website vào ô mã phòng hay không
        if (code.includes('http://') || code.includes('https://') || code.includes('/') || code.includes(':') || code.includes('?')) {
            // Thử trích xuất nếu link có chứa mã dạng EDU-XXXX hoặc EC-XXXX
            const match = code.match(/([a-zA-Z0-9]+-[0-9]{3,6})/);
            if (match) {
                code = match[1];
            } else {
                alert("⚠️ Bạn vừa nhập đường link website! Vui lòng nhập đúng mã phòng thi đấu (Ví dụ: EDU-8924), không nhập link.");
                return null;
            }
        }

        code = code.toUpperCase();
        if (code.length < 4 || code.length > 15) {
            alert("⚠️ Định dạng mã phòng không hợp lệ (Ví dụ: EDU-8924)!");
            return null;
        }

        return code;
    }

    // BỘ SINH SỐ NGẪU NHIÊN THEO SEED ĐẢM BẢO 2 CLIENT TRÙNG KHỚP CÂU HỎI
    function createSeededRandom(seed) {
        let s = (Math.abs(seed) % 2147483647) || 12345;
        return function() {
            s = (s * 16807) % 2147483647;
            return (s - 1) / 2147483646;
        };
    }

    function updateQuizDropdown() {
        const selectedSubId = parseInt(subSelect.value);
        const subName = subSelect.options[subSelect.selectedIndex]?.dataset.name || "";
        const searchTerm = (searchQuizInput ? searchQuizInput.value : "").trim().toLowerCase();

        // 1. Lọc tất cả các đề thuộc môn học này
        const subjectQuizzes = ALL_QUIZZES.filter(q => {
            const sId = q.subject?.subjectId || q.Subject?.SubjectId;
            return sId === selectedSubId;
        });

        const totalInSubject = subjectQuizzes.length;
        if (quizCountBadge) {
            quizCountBadge.innerText = `${totalInSubject} đề import`;
        }

        // 2. Nếu môn học CHƯA CÓ BỘ ĐỀ NÀO ĐƯỢC IMPORT -> KHÔNG ĐƯỢC PHÉP THI ĐẤU
        if (totalInSubject === 0) {
            quizSelect.classList.add('d-none');
            quizSearchGroup?.classList.add('d-none');
            selectedQuizPreviewCard?.classList.add('d-none');
            noQuizAlert.classList.remove('d-none');
            document.getElementById('noQuizTitle').innerText = `Môn '${subName}' chưa có bộ đề thi nào được import!`;

            if (btnQuickMatch) {
                btnQuickMatch.disabled = true;
                btnQuickMatch.classList.add('disabled');
                btnQuickMatch.innerHTML = '🚫 Không Thể Ghép (Chưa có đề)';
            }
            if (btnCreateRoom) {
                btnCreateRoom.disabled = true;
                btnCreateRoom.classList.add('disabled');
                btnCreateRoom.innerHTML = '🚫 Không Thể Tạo (Chưa có đề)';
            }
            if (btnJoinRoom) {
                btnJoinRoom.disabled = true;
                btnJoinRoom.classList.add('disabled');
            }
            return;
        }

        // 3. Môn có đề -> hiển thị ô tìm kiếm & ẩn cảnh báo
        quizSearchGroup?.classList.remove('d-none');

        // Lọc theo từ khóa tìm kiếm (tên đề, tác giả bản thân hay người khác, tags)
        let filtered = subjectQuizzes;
        if (searchTerm) {
            filtered = subjectQuizzes.filter(q => {
                const title = (q.title || q.Title || '').toLowerCase();
                const author = (q.author?.displayName || q.Author?.DisplayName || '').toLowerCase();
                const tags = (q.tags || q.Tags || []).map(t => t.toLowerCase()).join(' ');
                const isMe = (q.author?.userId === CURRENT_USER_ID) || (q.Author?.UserId === CURRENT_USER_ID);
                const authorType = isMe ? 'bản thân tôi của tôi my' : 'người khác cộng đồng';
                return title.includes(searchTerm) || author.includes(searchTerm) || tags.includes(searchTerm) || authorType.includes(searchTerm);
            });
        }

        quizSelect.innerHTML = '';
        if (filtered.length === 0) {
            quizSelect.classList.add('d-none');
            selectedQuizPreviewCard?.classList.add('d-none');
            noQuizAlert.classList.remove('d-none');
            document.getElementById('noQuizTitle').innerText = `Không tìm thấy đề thi nào khớp với "${searchQuizInput.value}"!`;

            if (btnQuickMatch) {
                btnQuickMatch.disabled = true;
                btnQuickMatch.classList.add('disabled');
                btnQuickMatch.innerHTML = '🚫 Chưa Chọn Đề';
            }
            if (btnCreateRoom) {
                btnCreateRoom.disabled = true;
                btnCreateRoom.classList.add('disabled');
                btnCreateRoom.innerHTML = '🚫 Chưa Chọn Đề';
            }
            return;
        }

        // Hiển thị dropdown các đề import
        quizSelect.classList.remove('d-none');
        noQuizAlert.classList.add('d-none');

        filtered.forEach(q => {
            const cId = q.contentId || q.ContentId;
            const title = q.title || q.Title || 'Bộ đề không tên';
            const authorName = q.author?.displayName || q.Author?.DisplayName || 'Cộng đồng';
            const authorId = q.author?.userId || q.Author?.UserId || '';
            const isMe = (CURRENT_USER_ID && authorId === CURRENT_USER_ID);
            const diff = q.difficultyLevel || q.DifficultyLevel || 'Medium';

            const opt = document.createElement('option');
            opt.value = cId;
            const authorTag = isMe ? '⭐ [Của tôi]' : `👤 [${authorName}]`;
            opt.text = `${authorTag} 📝 ${title} (${diff})`;
            quizSelect.appendChild(opt);
        });

        // Bật lại các nút thi đấu
        if (btnQuickMatch) {
            btnQuickMatch.disabled = false;
            btnQuickMatch.classList.remove('disabled');
            btnQuickMatch.innerHTML = '⚔️ Tìm Trận Ngay';
        }
        if (btnCreateRoom) {
            btnCreateRoom.disabled = false;
            btnCreateRoom.classList.remove('disabled');
            btnCreateRoom.innerHTML = '+ Tạo Mã Phòng';
        }
        if (btnJoinRoom) {
            btnJoinRoom.disabled = false;
            btnJoinRoom.classList.remove('disabled');
        }

        updateSelectedQuizPreview();
    }

    function updateSelectedQuizPreview() {
        const selectedQuizId = quizSelect.value;
        if (!selectedQuizId) {
            selectedQuizPreviewCard?.classList.add('d-none');
            return;
        }
        const q = ALL_QUIZZES.find(item => (item.contentId || item.ContentId) === selectedQuizId);
        if (!q) {
            selectedQuizPreviewCard?.classList.add('d-none');
            return;
        }

        const title = q.title || q.Title || '';
        const authorName = q.author?.displayName || q.Author?.DisplayName || 'Cộng đồng';
        const authorId = q.author?.userId || q.Author?.UserId || '';
        const isMe = (CURRENT_USER_ID && authorId === CURRENT_USER_ID);
        const diff = q.difficultyLevel || q.DifficultyLevel || 'Medium';

        document.getElementById('previewQuizTitle').innerText = `📝 ${title}`;
        const authorEl = document.getElementById('previewQuizAuthor');
        if (authorEl) {
            if (isMe) {
                authorEl.className = 'badge bg-success text-white';
                authorEl.innerText = '⭐ Bản thân import';
            } else {
                authorEl.className = 'badge bg-secondary text-white';
                authorEl.innerText = `👤 Import bởi: ${authorName}`;
            }
        }
        const diffEl = document.getElementById('previewQuizDiff');
        if (diffEl) {
            diffEl.innerText = `Độ khó: ${diff}`;
        }
        selectedQuizPreviewCard?.classList.remove('d-none');
    }

    subSelect?.addEventListener('change', updateQuizDropdown);
    quizSelect?.addEventListener('change', updateSelectedQuizPreview);

    // Xử lý ô tìm kiếm đề thi
    searchQuizInput?.addEventListener('input', () => {
        if (searchQuizInput.value.trim().length > 0) {
            btnClearSearchQuiz.style.display = 'block';
        } else {
            btnClearSearchQuiz.style.display = 'none';
        }
        updateQuizDropdown();
    });

    btnClearSearchQuiz?.addEventListener('click', () => {
        searchQuizInput.value = '';
        btnClearSearchQuiz.style.display = 'none';
        updateQuizDropdown();
        searchQuizInput.focus();
    });

    // Khởi tạo danh sách đề ngay khi tải trang
    updateQuizDropdown();

    // =========================================================================
    // QUẢN LÝ PHÒNG ĐẤU REAL-TIME (TẠO PHÒNG / VÀO PHÒNG / ĐỒNG BỘ 2 CLIENT)
    // =========================================================================

    // 1. TẠO PHÒNG ĐẤU TRÊN SERVER
    btnCreateRoom?.addEventListener('click', async () => {
        const selectedQuizId = quizSelect.value;
        if (!selectedQuizId) {
            alert("Môn này chưa có bộ đề thi hoặc bạn chưa chọn đề. Không thể tạo phòng đấu!");
            return;
        }

        btnCreateRoom.disabled = true;
        btnCreateRoom.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang tạo...';

        try {
            const subName = subSelect.options[subSelect.selectedIndex]?.dataset.name || "Môn học";
            const subCode = subSelect.options[subSelect.selectedIndex]?.dataset.code || "GEN";
            const q = ALL_QUIZZES.find(item => (item.contentId || item.ContentId) === selectedQuizId);
            const qTitle = q ? (q.title || q.Title || "Đề thi đấu") : "Đề thi đấu";

            const resp = await fetch('/Home/CreateArenaRoom', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    contentId: selectedQuizId,
                    quizTitle: qTitle,
                    subjectName: subName,
                    subjectCode: subCode,
                    playerId: MY_PLAYER_ID
                })
            });

            if (!resp.ok) {
                const err = await resp.json();
                alert(err.message || "Không thể tạo phòng đấu trên máy chủ.");
                btnCreateRoom.disabled = false;
                btnCreateRoom.innerHTML = '+ Tạo Mã Phòng';
                return;
            }

            currentRoom = await resp.json();
            isHost = true;

            const codeBox = document.getElementById('createdRoomBox');
            document.getElementById('displayRoomCode').value = currentRoom.roomCode;
            codeBox.classList.remove('d-none');

            // Bắt đầu thăm dò (polling) chờ người chơi thứ 2 vào phòng
            clearInterval(roomPollTimer);
            roomPollTimer = setInterval(async () => {
                try {
                    const checkResp = await fetch(`/Home/GetArenaRoom?code=${encodeURIComponent(currentRoom.roomCode)}`);
                    if (checkResp.ok) {
                        const roomState = await checkResp.json();
                        if (roomState.status === 'Playing' && roomState.guest) {
                            clearInterval(roomPollTimer);
                            codeBox.classList.add('d-none');
                            currentRoom = roomState;
                            startPvPMatch(roomState, true);
                        }
                    }
                } catch(e) {}
            }, 1000);

        } catch (e) {
            alert("Lỗi kết nối khi tạo phòng: " + e.message);
        } finally {
            btnCreateRoom.disabled = false;
            btnCreateRoom.innerHTML = '+ Tạo Mã Phòng';
        }
    });

    // 2. VÀO PHÒNG ĐẤU VỚI MÃ ĐÃ CHIA SẺ
    document.getElementById('btnJoinRoom')?.addEventListener('click', async () => {
        const rawCode = document.getElementById('inputRoomCode').value;
        const validCode = validateRoomCode(rawCode);
        if (!validCode) return;

        btnJoinRoom.disabled = true;
        btnJoinRoom.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Vào...';

        try {
            const resp = await fetch('/Home/JoinArenaRoom', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    roomCode: validCode,
                    playerId: MY_PLAYER_ID
                })
            });

            if (!resp.ok) {
                const err = await resp.json();
                alert(err.message || `Mã phòng '${validCode}' không tồn tại hoặc phòng đã đủ người!`);
                btnJoinRoom.disabled = false;
                btnJoinRoom.innerHTML = 'Vào ➔';
                return;
            }

            const roomState = await resp.json();
            currentRoom = roomState;
            isHost = false;
            startPvPMatch(roomState, false);

        } catch (e) {
            alert("Lỗi kết nối khi tham gia phòng: " + e.message);
        } finally {
            btnJoinRoom.disabled = false;
            btnJoinRoom.innerHTML = 'Vào ➔';
        }
    });

    // 3. HỦY PHÒNG ĐÃ TẠO
    document.getElementById('btnCancelRoom')?.addEventListener('click', async () => {
        clearInterval(roomPollTimer);
        if (currentRoom) {
            try {
                await fetch(`/Home/LeaveArenaRoom?code=${encodeURIComponent(currentRoom.roomCode)}&playerId=${encodeURIComponent(MY_PLAYER_ID)}`, { method: 'POST' });
            } catch(e) {}
        }
        document.getElementById('createdRoomBox').classList.add('d-none');
        currentRoom = null;
    });

    // 4. SAO CHÉP MÃ PHÒNG
    document.getElementById('btnCopyCode')?.addEventListener('click', copyRoomCode);

    // 5. RỜI TRẬN (XỬ THUA NGAY LẬP TỨC, ĐỐI THỦ THẮNG)
    document.getElementById('btnSurrender')?.addEventListener('click', async () => {
        if (confirm("⚠️ Bạn có chắc muốn rời trận? Nếu bạn rời trận bây giờ, đối thủ sẽ được xử THẮNG NGAY LẬP TỨC (-20 Elo)!")) {
            if (isRealMatch && currentRoom) {
                try {
                    await fetch(`/Home/LeaveArenaRoom?code=${encodeURIComponent(currentRoom.roomCode)}&playerId=${encodeURIComponent(MY_PLAYER_ID)}`, { method: 'POST' });
                } catch(e) {}
            }
            endGame(false, true, false, false, false);
        }
    });

    document.getElementById('btnPlayAgain')?.addEventListener('click', () => {
        result.classList.add('d-none');
        lobby.classList.remove('d-none');
    });

    // 6. GHÉP NHANH CÙNG BOT AI
    btnQuickMatch?.addEventListener('click', () => {
        startBotMatch("Trần Bảo Nam (Bot AI)");
    });

    // =========================================================================
    // KHỞI ĐỘNG TRẬN ĐẤU 1 VS 1 THẬT (PVP 2 CLIENT HOÀN TOÀN ĐỒNG BỘ)
    // =========================================================================
    async function startPvPMatch(room, isHostPlayer) {
        isRealMatch = true;
        currentRoom = room;
        isHost = isHostPlayer;
        opponentName = isHost ? (room.guest?.displayName || "Người Thách Đấu") : (room.host?.displayName || "Chủ Phòng");

        // Tải câu hỏi từ bộ đề của phòng đấu
        let rawQuestions = [];
        try {
            const resp = await fetch(`/Home/GetQuizQuestions/${room.contentId}`);
            if (!resp.ok) {
                alert("Không thể tải câu hỏi từ bộ đề này. Trận đấu bị hủy!");
                return;
            }
            rawQuestions = await resp.json();
        } catch (e) {
            alert("Lỗi tải câu hỏi: " + e.message);
            return;
        }

        if (!rawQuestions || rawQuestions.length === 0) {
            alert("Bộ đề này chưa có câu hỏi nào trong cơ sở dữ liệu! Vui lòng import câu hỏi trước khi thi đấu.");
            return;
        }

        // ĐỒNG BỘ THỨ TỰ CÂU HỎI & ĐÁP ÁN BẰNG SEED TỪ SERVER PHÒNG ĐẤU
        const seed = room.seed || Math.abs((room.roomCode || 'EDU').split('').reduce((a, b) => { a = ((a << 5) - a) + b.charCodeAt(0); return a & a }, 0));
        const rng = createSeededRandom(seed);

        // Sắp xếp ID cố định trước, sau đó xáo trộn theo PRNG seed
        const sortedRaw = [...rawQuestions].sort((a, b) => String(a.questionId || a.QuestionId).localeCompare(String(b.questionId || b.QuestionId)));
        const shuffledQuestions = sortedRaw.sort(() => rng() - 0.5);
        const selectedQuestions = shuffledQuestions.slice(0, 20);

        currentQuestions = selectedQuestions.map(q => {
            const rawAns = q.answers || q.Answers || [];
            const sortedAns = [...rawAns].sort((a, b) => String(a.answerId || a.AnswerId).localeCompare(String(b.answerId || b.AnswerId)));
            const shuffledAnswers = sortedAns.sort(() => rng() - 0.5).map(a => ({
                id: a.answerId || a.AnswerId,
                text: a.answerText || a.AnswerText,
                isCorrect: a.isCorrect !== undefined ? a.isCorrect : a.IsCorrect
            }));

            return {
                text: q.questionText || q.QuestionText,
                answers: shuffledAnswers
            };
        });

        // Chuyển sang màn hình trận đấu
        lobby.classList.add('d-none');
        result.classList.add('d-none');
        battle.classList.remove('d-none');

        document.getElementById('battleSubjectInfo').innerText = `| Môn: ${room.subjectName || "Đại Cương"} (${room.subjectCode || "GEN"})`;
        document.getElementById('p1NameTag').innerText = `BẠN • 200/200 HP`;
        document.getElementById('p2NameTag').innerText = `${opponentName.toUpperCase()} • 200/200 HP`;

        // Khởi tạo trạng thái
        p1Hp = 200;
        p2Hp = 200;
        p1Score = 0;
        qIndex = 0;
        lastOpponentScore = 0;
        isWaitingOpponent = false;
        isMatchEnded = false;

        waitingOpponentCard?.classList.add('d-none');
        answersContainer?.classList.remove('d-none');

        updateHealthUI();
        loadQuestion();

        // BẮT ĐẦU ĐỒNG BỘ TIẾN TRÌNH REAL-TIME GIỮA 2 CLIENT (MỖI 800MS)
        clearInterval(roomGameSyncTimer);
        roomGameSyncTimer = setInterval(async () => {
            if (isMatchEnded) {
                clearInterval(roomGameSyncTimer);
                return;
            }

            try {
                const resp = await fetch(`/Home/GetArenaRoom?code=${encodeURIComponent(currentRoom.roomCode)}`);
                if (!resp.ok) return;
                const updatedRoom = await resp.json();

                const opp = isHost ? updatedRoom.guest : updatedRoom.host;
                const me = isHost ? updatedRoom.host : updatedRoom.guest;

                // 1. Kiểm tra nếu đối thủ thoát trận giữa chừng -> Bạn THẮNG NGAY LẬP TỨC
                if (updatedRoom.status === 'Finished' && updatedRoom.abandonedByPlayerId) {
                    if (updatedRoom.abandonedByPlayerId !== MY_PLAYER_ID) {
                        clearInterval(roomGameSyncTimer);
                        clearInterval(timerTimer);
                        endGame(true, false, true, false, false);
                        return;
                    }
                }

                // 2. Đồng bộ đòn bắn của đối thủ khi đối thủ trả lời ĐÚNG
                if (opp) {
                    if (opp.score > lastOpponentScore) {
                        lastOpponentScore = opp.score;
                        triggerOpponentShot();
                    }
                }

                // 3. Kiểm tra ván đấu đã kết thúc từ server (cả 2 làm xong hết câu hỏi hoặc K.O.)
                if (updatedRoom.status === 'Finished') {
                    clearInterval(roomGameSyncTimer);
                    clearInterval(timerTimer);
                    isMatchEnded = true;

                    let won = false;
                    let draw = false;
                    let ko = (p1Hp <= 0 || p2Hp <= 0);

                    if (updatedRoom.winnerPlayerId === MY_PLAYER_ID) {
                        won = true;
                    } else if (updatedRoom.winnerPlayerId === 'DRAW') {
                        draw = true;
                    } else {
                        won = false;
                    }

                    endGame(won, false, false, ko, draw);
                }

            } catch (e) {}
        }, 800);
    }

    // =========================================================================
    // GHÉP NHANH CÙNG BOT AI (LUẬT CÔNG BẰNG: SAI KHÔNG BẮN, SO MÁU CUỐI TRẬN)
    // =========================================================================
    async function startBotMatch(botName) {
        isRealMatch = false;
        currentRoom = null;
        opponentName = botName;

        const selectedQuizId = quizSelect.value;
        if (!selectedQuizId) {
            alert("Vui lòng chọn bộ đề trắc nghiệm trước khi thi đấu!");
            return;
        }

        let rawQuestions = [];
        try {
            const resp = await fetch(`/Home/GetQuizQuestions/${selectedQuizId}`);
            if (!resp.ok) {
                alert("Không thể tải câu hỏi từ bộ đề này!");
                return;
            }
            rawQuestions = await resp.json();
        } catch (e) {
            alert("Lỗi tải câu hỏi: " + e.message);
            return;
        }

        if (!rawQuestions || rawQuestions.length === 0) {
            alert("Bộ đề này chưa có câu hỏi nào trong cơ sở dữ liệu!");
            return;
        }

        const shuffledQuestions = [...rawQuestions].sort(() => 0.5 - Math.random());
        const selectedQuestions = shuffledQuestions.slice(0, 20);

        currentQuestions = selectedQuestions.map(q => {
            const rawAns = q.answers || q.Answers || [];
            const shuffledAnswers = [...rawAns].sort(() => 0.5 - Math.random()).map(a => ({
                id: a.answerId || a.AnswerId,
                text: a.answerText || a.AnswerText,
                isCorrect: a.isCorrect !== undefined ? a.isCorrect : a.IsCorrect
            }));

            return {
                text: q.questionText || q.QuestionText,
                answers: shuffledAnswers
            };
        });

        lobby.classList.add('d-none');
        result.classList.add('d-none');
        battle.classList.remove('d-none');

        const subName = subSelect.options[subSelect.selectedIndex]?.dataset.name || "Kiến thức Đại học";
        document.getElementById('battleSubjectInfo').innerText = `| Môn: ${subName}`;
        document.getElementById('p1NameTag').innerText = `BẠN • 200/200 HP`;
        document.getElementById('p2NameTag').innerText = `${opponentName.toUpperCase()} • 200/200 HP`;

        p1Hp = 200;
        p2Hp = 200;
        p1Score = 0;
        qIndex = 0;
        isWaitingOpponent = false;
        isMatchEnded = false;

        waitingOpponentCard?.classList.add('d-none');
        answersContainer?.classList.remove('d-none');

        updateHealthUI();
        loadQuestion();
    }

    // =========================================================================
    // ĐIỀU KHIỂN CÂU HỎI & LỰA CHỌN ĐÁP ÁN (CHỈ ĐÚNG MỚI BẮN, SAI THÌ THÔI)
    // =========================================================================
    function loadQuestion() {
        if (qIndex >= currentQuestions.length || p1Hp <= 0 || p2Hp <= 0) {
            handleEndOfQuestions();
            return;
        }

        isSubmitting = false;
        clearInterval(timerTimer);
        timerVal = 15;
        updateTimerDisplay();

        const q = currentQuestions[qIndex];
        document.getElementById('questionNumberLabel').innerText = `CÂU ${qIndex + 1}/${currentQuestions.length}: `;
        document.getElementById('questionText').innerText = q.text;

        answersContainer.innerHTML = '';

        q.answers.forEach((ans, idx) => {
            const letter = String.fromCharCode(65 + idx);
            const btn = document.createElement('button');
            btn.className = 'pixel-answer-row';
            btn.innerHTML = `<span class="answer-key-letter">${letter}.</span> <span>${ans.text}</span>`;
            btn.onclick = () => chooseAnswer(ans, btn);
            answersContainer.appendChild(btn);
        });

        // Bắt đầu đếm ngược 15 giây
        timerTimer = setInterval(() => {
            timerVal--;
            updateTimerDisplay();
            if (timerVal <= 0) {
                clearInterval(timerTimer);
                // HẾT GIỜ: Coi như bỏ qua câu hỏi, KHÔNG AI BẮN
                chooseAnswer(null, null);
            }
        }, 1000);
    }

    function updateTimerDisplay() {
        const valStr = timerVal < 10 ? `0${timerVal}` : `${timerVal}`;
        document.getElementById('battleTimerText').innerText = `00:${valStr}`;
        const box = document.getElementById('timerBox');
        if (timerVal <= 5) box.style.borderColor = "#EF4444";
        else box.style.borderColor = "#F1D302";
    }

    function chooseAnswer(selectedAns, clickedBtn) {
        if (isSubmitting || isWaitingOpponent || isMatchEnded) return;
        isSubmitting = true;
        clearInterval(timerTimer);

        const isCorrect = selectedAns && selectedAns.isCorrect;

        // Vô hiệu hóa nút đáp án
        document.querySelectorAll('.pixel-answer-row').forEach(b => b.disabled = true);

        if (clickedBtn) {
            clickedBtn.classList.add(isCorrect ? 'correct-pick' : 'wrong-pick');
        }

        if (isCorrect) {
            // BẠN TRẢ LỜI ĐÚNG -> BẠN ĐƯỢC BẮN ĐỐI THỦ (-20 HP)!
            p1Score++;
            triggerPlayer1Shoot();

            // Gửi kết quả lên server nếu là trận đấu phòng thật
            if (isRealMatch && currentRoom) {
                fetch('/Home/SubmitArenaAnswer', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        roomCode: currentRoom.roomCode,
                        playerId: MY_PLAYER_ID,
                        questionIndex: qIndex,
                        isCorrect: true,
                        isFinished: (qIndex + 1 >= currentQuestions.length)
                    })
                }).catch(() => {});
            }

            // Kiểm tra K.O. đối thủ
            if (p2Hp <= 0) {
                setTimeout(() => {
                    endGame(true, false, false, true, false);
                }, 1000);
                return;
            }
        } else {
            // BẠN TRẢ LỜI SAI HOẶC HẾT GIỜ -> TUYỆT ĐỐI KHÔNG AI BẮN! CÔNG BẰNG TUYỆT ĐỐI!
            document.getElementById('battleLogText').innerHTML = '<span style="color:#94A3B8">⚠️ Bạn trả lời sai/hết giờ: Không ai bắn lượt này.</span>';

            // Gửi kết quả sai lên server
            if (isRealMatch && currentRoom) {
                fetch('/Home/SubmitArenaAnswer', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        roomCode: currentRoom.roomCode,
                        playerId: MY_PLAYER_ID,
                        questionIndex: qIndex,
                        isCorrect: false,
                        isFinished: (qIndex + 1 >= currentQuestions.length)
                    })
                }).catch(() => {});
            }
        }

        // Chuyển câu tiếp theo sau 1.2 giây
        setTimeout(() => {
            qIndex++;
            loadQuestion();
        }, 1200);
    }

    // XỬ LÝ KHI NGƯỜI CHƠI HOÀN THÀNH HẾT 20 CÂU HỎI
    function handleEndOfQuestions() {
        clearInterval(timerTimer);

        if (p1Hp <= 0) {
            endGame(false, false, false, true, false);
            return;
        }
        if (p2Hp <= 0) {
            endGame(true, false, false, true, false);
            return;
        }

        if (isRealMatch) {
            // NẾU LÀ TRẬN ĐẤU PHÒNG REAL-TIME:
            // Bạn đã xong 20 câu, NHƯNG ĐỐI THỦ CHƯA XONG -> BẠN PHẢI CHỜ ĐỐI THỦ!
            isWaitingOpponent = true;
            answersContainer?.classList.add('d-none');
            document.getElementById('waitingOpponentName').innerText = opponentName;
            waitingOpponentCard?.classList.remove('d-none');
            document.getElementById('battleTimerText').innerText = "CHỜ...";
            document.getElementById('battleLogText').innerHTML = '<span style="color:#FBBF24">⏳ Bạn đã hoàn thành 20 câu! Đang chờ đối thủ làm xong để so máu tổng kết...</span>';
        } else {
            // Đấu với Bot: So sánh lượng máu sau khi xong 20 câu
            endGame(p1Hp > p2Hp, false, false, false, p1Hp === p2Hp);
        }
    }

    // HIỆU ỨNG BẮN ĐẠN & TRỪ MÁU
    function triggerPlayer1Shoot() {
        document.getElementById('flash1').classList.remove('d-none');
        document.getElementById('battleLogText').innerHTML = '<span style="color:#10B981">🎯 Bạn trả lời ĐÚNG: BẮN TRÚNG ĐỐI THỦ (-20 HP)!</span>';
        playWebAudio('shoot');

        setTimeout(() => document.getElementById('flash1').classList.add('d-none'), 200);

        const bullet = document.getElementById('bullet1');
        bullet.classList.remove('d-none');

        setTimeout(() => {
            bullet.classList.add('d-none');
            p2Hp = Math.max(0, p2Hp - 20);
            updateHealthUI();
            showDamage(2, "-20 HP");
            playWebAudio('hit');
        }, 350);
    }

    function triggerOpponentShot() {
        document.getElementById('flash2').classList.remove('d-none');
        document.getElementById('battleLogText').innerHTML = '<span style="color:#EF4444">💥 Đối thủ trả lời ĐÚNG: BẮN TRÚNG BẠN (-20 HP)!</span>';
        playWebAudio('shoot');

        setTimeout(() => document.getElementById('flash2').classList.add('d-none'), 200);

        const bullet = document.getElementById('bullet2');
        bullet.classList.remove('d-none');

        setTimeout(() => {
            bullet.classList.add('d-none');
            p1Hp = Math.max(0, p1Hp - 20);
            updateHealthUI();
            showDamage(1, "-20 HP");
            playWebAudio('hit');

            if (p1Hp <= 0) {
                setTimeout(() => {
                    endGame(false, false, false, true, false);
                }, 800);
            }
        }, 350);
    }

    function showDamage(target, text) {
        const pop = document.getElementById(target === 1 ? 'damagePop1' : 'damagePop2');
        pop.innerText = text;
        pop.classList.remove('d-none');
        setTimeout(() => pop.classList.add('d-none'), 800);
    }

    function updateHealthUI() {
        document.getElementById('p1HealthFill').style.width = `${(p1Hp / 200) * 100}%`;
        document.getElementById('p2HealthFill').style.width = `${(p2Hp / 200) * 100}%`;
        document.getElementById('p1NameTag').innerText = `BẠN • ${p1Hp}/200 HP`;
        document.getElementById('p2NameTag').innerText = `${opponentName.toUpperCase()} • ${p2Hp}/200 HP`;
    }

    // =========================================================================
    // TỔNG KẾT TRẬN ĐẤU (SO SÁNH MÁU HOẶC XỬ THẮNG KHI ĐỐI THỦ THOÁT)
    // =========================================================================
    function endGame(isWon, isSurrendered, isOpponentLeft, isKo, isDraw) {
        isMatchEnded = true;
        clearInterval(timerTimer);
        clearInterval(roomGameSyncTimer);

        battle.classList.add('d-none');
        result.classList.remove('d-none');

        const title = document.getElementById('resultTitle');
        const icon = document.getElementById('resultIcon');
        const desc = document.getElementById('resultDesc');
        const elo = document.getElementById('resultEloText');

        if (isSurrendered) {
            icon.innerText = "🏳️";
            title.innerText = "BẠN ĐÃ RỜI TRẬN (XỬ THUA)!";
            title.className = "fw-bold mt-2 text-danger";
            desc.innerText = `Bạn đã thoát khỏi trận đấu giữa chừng. Đối thủ (${opponentName}) được xử THẮNG NGAY LẬP TỨC!`;
            elo.innerText = "-20 Elo";
            elo.className = "fs-4 fw-bold text-danger";
        } else if (isOpponentLeft) {
            icon.innerText = "🏆";
            title.innerText = "CHIẾN THẮNG! ĐỐI THỦ ĐÃ RỜI TRẬN!";
            title.className = "fw-bold mt-2 text-success";
            desc.innerText = `Đối thủ (${opponentName}) đã thoát khỏi trận đấu giữa chừng. Bạn được xử CHIẾN THẮNG TUYỆT ĐỐI (+Elo) mà không cần chờ!`;
            elo.innerText = "+25 Elo";
            elo.className = "fs-4 fw-bold text-success";
        } else if (isKo) {
            if (isWon) {
                icon.innerText = "⚡";
                title.innerText = "CHIẾN THẮNG KNOCKOUT (K.O.)!";
                title.className = "fw-bold mt-2 text-success";
                desc.innerText = `Đối thủ đã hết sạch máu trước khi hết 20 câu! Bạn thắng knock-out trực tiếp!`;
                elo.innerText = "+30 Elo";
                elo.className = "fs-4 fw-bold text-success";
            } else {
                icon.innerText = "💥";
                title.innerText = "BẠN ĐÃ BỊ HẠ KNOCKOUT (K.O.)!";
                title.className = "fw-bold mt-2 text-danger";
                desc.innerText = "Bạn đã hết máu trước đối thủ! Hãy phục thù ở trận tiếp theo nhé!";
                elo.innerText = "-20 Elo";
                elo.className = "fs-4 fw-bold text-danger";
            }
        } else if (isDraw) {
            icon.innerText = "🤝";
            title.innerText = "TRẬN ĐẤU BẤT PHÂN THẮNG BẠI (HÒA)!";
            title.className = "fw-bold mt-2 text-warning";
            desc.innerText = `Cả hai đấu thủ đều có lượng máu và số câu đúng bằng nhau sau 20 câu hỏi!`;
            elo.innerText = "+5 Elo";
            elo.className = "fs-4 fw-bold text-warning";
        } else if (isWon) {
            icon.innerText = "🏆";
            title.innerText = "CHIẾN THẮNG TUYỆT ĐỐI (SO MÁU)!";
            title.className = "fw-bold mt-2 text-success";
            desc.innerText = `Đã hoàn thành 20 câu hỏi! Lượng máu còn lại của bạn (${p1Hp} HP) cao hơn đối thủ (${p2Hp} HP) nên bạn giành chiến thắng!`;
            elo.innerText = "+25 Elo";
            elo.className = "fs-4 fw-bold text-success";
        } else {
            icon.innerText = "🛡️";
            title.innerText = "KẾT THÚC TRẬN - BẠN ĐÃ THUA!";
            title.className = "fw-bold mt-2 text-danger";
            desc.innerText = `Đã hoàn thành 20 câu hỏi! Lượng máu còn lại của bạn (${p1Hp} HP) thấp hơn đối thủ (${p2Hp} HP).`;
            elo.innerText = "-15 Elo";
            elo.className = "fs-4 fw-bold text-danger";
        }

        document.getElementById('resultHpText').innerText = `${p1Hp} / 200 HP`;
        document.getElementById('resultScoreText').innerText = `${p1Score} / ${currentQuestions.length}`;
    }

    // TỰ ĐỘNG THÔNG BÁO RỜI TRẬN NẾU ĐÓNG TRÌNH DUYỆT
    window.addEventListener('beforeunload', () => {
        if (isRealMatch && currentRoom && !isMatchEnded) {
            navigator.sendBeacon(`/Home/LeaveArenaRoom?code=${encodeURIComponent(currentRoom.roomCode)}&playerId=${encodeURIComponent(MY_PLAYER_ID)}`);
        }
    });
</script>

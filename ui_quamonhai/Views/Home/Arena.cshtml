@{
    ViewData["Title"] = "Đấu trường · EduClash";
    var userProfile = ViewBag.CurrentUser as UserProfileViewModel;
    var subjects = ViewBag.Subjects as List<SubjectViewModel> ?? new List<SubjectViewModel>();
    var quizzes = ViewBag.Quizzes as List<ContentItemViewModel> ?? new List<ContentItemViewModel>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/arena.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cabinet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/battle-fx.css" asp-append-version="true" />
}

<div class="wrap">
<div class="arena">

    <!-- 1. SẢNH CHỜ -->
    <div id="lobbyScreen">
        <header class="page-head">
            <ol class="crumbs" aria-label="Vị trí">
                <li><a href="/">Trang chủ</a></li>
                <li aria-current="page">Đấu trường</li>
            </ol>
            <h1>Đấu trường 1 vs 1</h1>
            <p class="page-head__lede">Chọn một bộ đề, mời bạn vào phòng rồi so tài. Trả lời đúng là bắn trúng đối thủ. Ai còn nhiều máu hơn sau 20 câu thì thắng.</p>
            <div class="arena-rules" aria-label="Luật chơi">
                <span class="chip chip--red"><svg class="icon" aria-hidden="true"><use href="#i-heart" /></svg><span class="num">200</span>&nbsp;HP mỗi bên</span>
                <span class="chip chip--green"><svg class="icon" aria-hidden="true"><use href="#i-target" /></svg>Đúng: bắn <span class="num">-20</span>&nbsp;HP</span>
                <span class="chip chip--gold"><svg class="icon" aria-hidden="true"><use href="#i-clock" /></svg><span class="num">15</span>&nbsp;giây mỗi câu</span>
                <span class="chip"><svg class="icon" aria-hidden="true"><use href="#i-quiz" /></svg>Tối đa <span class="num">20</span>&nbsp;câu</span>
            </div>
        </header>

        @if (userProfile != null)
        {
            <section class="game-panel player-card" aria-label="Thông tin của bạn">
                <div class="player-card__who">
                    <span class="avatar">
                        @if (!string.IsNullOrEmpty(userProfile.AvatarUrl))
                        {
                            <img src="@userProfile.AvatarUrl" alt="" />
                        }
                        else
                        {
                            @UiHelpers.Initial(userProfile.DisplayName)
                        }
                    </span>
                    <div>
                        <h2>@userProfile.DisplayName</h2>
                        <p>Cấp @userProfile.Level · Hạng @userProfile.RankTier</p>
                    </div>
                </div>
                <dl class="player-card__stats">
                    <div><dt>Elo</dt><dd class="is-elo">@userProfile.Rating</dd></div>
                    <div><dt>Thắng/Thua</dt><dd>@userProfile.Wins/@userProfile.Losses</dd></div>
                    <div><dt>Xu</dt><dd class="is-coin">@userProfile.Coins</dd></div>
                </dl>
            </section>
        }
        else
        {
            <section class="game-panel player-card player-card--guest" aria-label="Bạn đang chơi với tư cách khách">
                <div class="player-card__who">
                    <span class="avatar"><svg class="icon" aria-hidden="true"><use href="#i-user" /></svg></span>
                    <div>
                        <h2>Bạn đang chơi với tư cách khách</h2>
                        <p>Vẫn vào trận được, nhưng Elo và xu chỉ được lưu khi bạn đăng nhập.</p>
                    </div>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="/Auth/Login?returnUrl=%2FHome%2FArena" class="btn-arcade btn-arcade--ghost btn-arcade--sm">Đăng nhập</a>
                    <a href="/Auth/Register" class="btn-arcade btn-arcade--gold btn-arcade--sm">Đăng ký nhận 50 xu</a>
                </div>
            </section>
        }

        <section class="panel setup" aria-label="Chọn đề thi đấu">
            <div class="setup__step">
                <div class="setup__label"><label for="selectSubject"><span class="step-no">1</span>Chọn môn</label></div>
                <select id="selectSubject" class="form-select">
                    @foreach (var s in subjects)
                    {
                        <option value="@s.SubjectId" data-code="@s.Code" data-name="@s.Name">@s.Code · @s.Name</option>
                    }
                </select>
            </div>

            <div class="setup__step" id="quizSelectSection">
                <div class="setup__label">
                    <label for="selectQuiz"><span class="step-no">2</span>Chọn bộ đề</label>
                    <span class="chip chip--blue" id="quizCountBadge">0 bộ đề</span>
                </div>

                <div class="search quiz-search" id="quizSearchGroup">
                    <svg class="icon" aria-hidden="true"><use href="#i-search" /></svg>
                    <label for="searchQuizInput" class="visually-hidden">Lọc bộ đề</label>
                    <input type="search" id="searchQuizInput" placeholder="Lọc theo tên đề, người đăng hoặc tag" autocomplete="off" />
                    <button type="button" class="clear-btn" id="btnClearSearchQuiz" style="display:none" aria-label="Xoá từ khoá">
                        <svg class="icon" aria-hidden="true"><use href="#i-x" /></svg>
                    </button>
                </div>

                <select id="selectQuiz" class="form-select"></select>

                <div id="selectedQuizPreviewCard" class="quiz-preview d-none">
                    <div>
                        <strong id="previewQuizTitle">Tên bộ đề</strong>
                        <div class="quiz-preview__meta">
                            <span id="previewQuizAuthor" class="chip">Người đăng</span>
                            <span id="previewQuizDiff" class="chip">Độ khó</span>
                            <span class="chip chip--blue">Lấy ngẫu nhiên tối đa 20 câu</span>
                        </div>
                    </div>
                    <span class="quiz-preview__ready"><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>Sẵn sàng</span>
                </div>

                <div id="noQuizAlert" class="no-quiz d-none" role="status">
                    <div>
                        <strong id="noQuizTitle">Môn này chưa có bộ đề nào</strong>
                        <p>Đấu trường cần một bộ trắc nghiệm có sẵn câu hỏi. Hãy tải một bộ đề lên hoặc chọn môn khác.</p>
                    </div>
                    <a href="/Outline/Import" class="btn-arcade btn-arcade--sm btn-arcade--danger"><svg class="icon" aria-hidden="true"><use href="#i-upload" /></svg>Tải bộ đề lên</a>
                </div>
            </div>
        </section>

        <section class="match-actions" aria-label="Vào trận">
            <div class="match-card match-card--main">
                <h3><svg class="icon" aria-hidden="true"><use href="#i-users" /></svg>Tạo phòng, mời bạn</h3>
                <p>Nhận mã phòng rồi gửi cho bạn. Trận bắt đầu ngay khi bạn ấy vào.</p>
                <button type="button" class="btn-arcade btn-arcade--gold btn-arcade--block" id="btnCreateRoom">Tạo mã phòng</button>
            </div>
            <div class="match-card">
                <h3><svg class="icon" aria-hidden="true"><use href="#i-key" /></svg>Vào bằng mã</h3>
                <p>Bạn bè đã tạo phòng? Nhập mã họ gửi, ví dụ EDU-8924.</p>
                <div class="room-input">
                    <label for="inputRoomCode" class="visually-hidden">Mã phòng</label>
                    <input type="text" id="inputRoomCode" class="form-control" placeholder="EDU-8924" maxlength="25" autocomplete="off" />
                    <button class="btn-arcade" type="button" id="btnJoinRoom">Vào</button>
                </div>
            </div>
            <div class="match-card">
                <h3><svg class="icon" aria-hidden="true"><use href="#i-bot" /></svg>Đấu tập với bot</h3>
                <p>Luyện tốc độ trả lời. Bot không bắn trả và trận tập không tính Elo.</p>
                <button type="button" class="btn-arcade btn-arcade--block" id="btnQuickMatch">Vào trận tập</button>
            </div>
        </section>

        <section id="createdRoomBox" class="game-panel room-wait d-none" aria-live="polite">
            <h3>Phòng đã sẵn sàng. Gửi mã này cho bạn:</h3>
            <div class="room-code">
                <label for="displayRoomCode" class="visually-hidden">Mã phòng của bạn</label>
                <input type="text" id="displayRoomCode" readonly value="" />
                <button type="button" class="btn-arcade btn-arcade--ghost" id="btnCopyCode"><svg class="icon" aria-hidden="true"><use href="#i-copy" /></svg>Sao chép</button>
            </div>
            <span class="room-wait__status">Đang chờ đối thủ nhập mã…</span>
            <button type="button" class="btn-arcade btn-arcade--danger btn-arcade--sm" id="btnCancelRoom"><svg class="icon" aria-hidden="true"><use href="#i-x" /></svg>Huỷ phòng</button>
        </section>
    </div>

    <!-- 2. TRẬN ĐẤU PIXEL -->
    <section id="battleScreen" class="cabinet d-none" aria-label="Trận đấu">
        <div class="cabinet__marquee" aria-hidden="true">
            <span class="cabinet__logo">EDU<b>CLASH</b></span>
            <span class="cabinet__sub">ARENA · 1 VS 1</span>
        </div>
        <div class="cabinet__bezel">
        <div class="cabinet__screen pixel-arena-container">
        <div class="pixel-arena-top-bar">
            <div class="d-flex align-items-center gap-2 top-bar-info">
                <span class="pixel-mode-pill">1 VS 1</span>
                <span id="battleSubjectInfo">Môn học</span>
            </div>
            <button class="pixel-btn-action" type="button" id="btnSurrender"><svg class="icon" aria-hidden="true"><use href="#i-flag" /></svg>Rời trận</button>
        </div>

        <div class="pixel-top-banner">
            <div class="pixel-banner-inner">
                <span class="pixel-gold-label" id="questionNumberLabel">1/20</span>
                <span class="pixel-question-text" id="questionText" aria-hidden="true"></span>
                <span class="visually-hidden" id="questionTextSr" aria-live="polite"></span>
            </div>
            <div class="fx-burn" aria-hidden="true"><div class="fx-burn__fill" id="fxBurn"></div></div>
        </div>

        <div class="pixel-battlefield fx-stage" id="fxStage" aria-hidden="true">
            <span class="fx-cloud c1"></span><span class="fx-cloud c2"></span><span class="fx-cloud c3"></span>
            <div class="pixel-hills-backdrop"></div>
            <div class="pixel-scenery-tree tree-left"><div class="tree-foliage"></div><div class="tree-trunk"></div></div>
            <div class="pixel-scenery-tree tree-right"><div class="tree-foliage"></div><div class="tree-trunk"></div></div>

            <div class="fx-hud">
                <div class="fx-hud__side" id="p1Hud">
                    <div class="fx-hud__name"><span class="fighter-tag-title" id="p1NameTag">BAN</span><span class="fighter-hp" id="p1HpText">200 HP</span></div>
                    <div class="fx-bar"><div class="fx-bar__ghost" id="p1Ghost"></div><div class="pixel-health-bar-fill fill-green" id="p1HealthFill"></div></div>
                </div>
                <span class="fx-hud__vs">VS</span>
                <div class="fx-hud__side is-right" id="p2Hud">
                    <div class="fx-hud__name"><span class="fighter-tag-title" id="p2NameTag">DOI THU</span><span class="fighter-hp" id="p2HpText">200 HP</span></div>
                    <div class="fx-bar"><div class="fx-bar__ghost" id="p2Ghost"></div><div class="pixel-health-bar-fill fill-red" id="p2HealthFill"></div></div>
                </div>
            </div>

            <div class="wizard wizard--p1 is-idle" id="wiz1"><div class="wizard__body"></div></div>
            <div class="wizard wizard--p2 is-idle" id="wiz2"><div class="wizard__body"></div></div>
            <div class="floating-damage-popup d-none" id="damagePop1">-20</div>
            <div class="floating-damage-popup d-none" id="damagePop2">-20</div>

            <div class="fx-layer" id="fxLayer"></div>
            <div class="fx-combo" id="fxCombo"></div>
            <div class="fx-overlay" id="fxOverlay"></div>
            <div class="pixel-grass-floor"></div>
        </div>

        <div class="pixel-bottom-hud">
            <div class="hud-col-left">
                <div class="pixel-chat-console">
                    <div class="chat-screen-window" id="battleLogText" role="log" aria-live="polite">Sẵn sàng! Trả lời đúng để bắn đối thủ.</div>
                    <div class="chat-input-row"><span>LOG</span><span>1 VS 1</span></div>
                </div>
            </div>

            <div class="hud-col-center">
                <div class="pixel-answers-board">
                    <div class="answers-buttons-stack" id="answersContainer"></div>
                    <div id="waitingOpponentCard" class="waiting-card d-none" role="status">
                        <div class="spinner-border spinner-border-sm text-warning mb-2" aria-hidden="true"></div>
                        <div><strong>Bạn đã làm xong!</strong></div>
                        <div>Đang chờ <strong id="waitingOpponentName">đối thủ</strong> trả lời nốt để so máu.</div>
                    </div>
                </div>
            </div>

            <div class="hud-col-right">
                <button class="pixel-info-button" type="button" id="btnRules" aria-expanded="false" aria-controls="pixelRules">LUAT</button>
                <div class="pixel-rules d-none" id="pixelRules">
                    <ul>
                        <li>Mỗi bên 200 HP.</li>
                        <li>Đúng: bắn đối thủ -20 HP.</li>
                        <li>Sai hoặc hết giờ: không ai bị bắn.</li>
                    </ul>
                </div>
                <div class="pixel-timer-console" id="timerBox" role="timer" aria-label="Thời gian còn lại">
                    <span class="timer-value" id="battleTimerText">00:15</span>
                </div>
            </div>
        </div>
        </div>
        </div>

        <div class="cabinet__deck">
            <div class="joystick" aria-hidden="true"><span class="joystick__stick"></span></div>
            <div class="deck-buttons" role="group" aria-label="Nút chọn đáp án, phím tắt A đến D">
                <button type="button" class="arcade-btn arcade-btn--a" data-pick="0" aria-label="Chọn đáp án A"><span>A</span></button>
                <button type="button" class="arcade-btn arcade-btn--b" data-pick="1" aria-label="Chọn đáp án B"><span>B</span></button>
                <button type="button" class="arcade-btn arcade-btn--c" data-pick="2" aria-label="Chọn đáp án C"><span>C</span></button>
                <button type="button" class="arcade-btn arcade-btn--d" data-pick="3" aria-label="Chọn đáp án D"><span>D</span></button>
            </div>
            <div class="coin-slot" aria-hidden="true">
                <span class="coin-slot__mouth"></span>
                <span class="coin-slot__label">INSERT COIN</span>
            </div>
        </div>
        <div class="cabinet__base" aria-hidden="true"></div>
        <p class="cabinet__hint">Bấm nút trên máy hoặc gõ phím A, B, C, D để trả lời.</p>
    </section>

    <!-- 3. KẾT QUẢ -->
    <section id="resultScreen" class="game-panel match-result d-none" aria-live="polite" tabindex="-1">
        <svg class="icon match-result__icon" aria-hidden="true"><use id="resultIcon" href="#i-trophy" /></svg>
        <h2 id="resultTitle">Chiến thắng!</h2>
        <p id="resultDesc"></p>
        <dl class="match-result__stats">
            <div><dt>Elo</dt><dd id="resultEloText">+25</dd></div>
            <div><dt>Máu còn lại</dt><dd id="resultHpText">200/200</dd></div>
            <div><dt>Câu đúng</dt><dd id="resultScoreText">0/0</dd></div>
        </dl>
        <div class="match-result__actions">
            <button type="button" class="btn-arcade btn-arcade--gold" id="btnPlayAgain"><svg class="icon" aria-hidden="true"><use href="#i-refresh" /></svg>Đấu trận nữa</button>
            <a href="/Home/Leaderboard" class="btn-arcade btn-arcade--ghost"><svg class="icon" aria-hidden="true"><use href="#i-trophy" /></svg>Xem bảng xếp hạng</a>
        </div>
    </section>

</div>
</div>

@section Scripts {
<script src="~/js/arena-fx.js" asp-append-version="true"></script>
<script>
    // Thông tin người dùng hiện tại
    const CURRENT_USER_ID = "@(userProfile?.UserId.ToString() ?? "")";
    let MY_PLAYER_ID = CURRENT_USER_ID;
    if (!MY_PLAYER_ID) {
        MY_PLAYER_ID = sessionStorage.getItem('arena_player_id');
        if (!MY_PLAYER_ID) {
            MY_PLAYER_ID = 'p_' + Math.random().toString(36).substring(2, 10);
            sessionStorage.setItem('arena_player_id', MY_PLAYER_ID);
        }
    }

    // Dữ liệu bộ đề từ server (Đề import từ bản thân hoặc người khác - TUYỆT ĐỐI KHÔNG TẠO DỮ LIỆU ẢO)
    const ALL_QUIZZES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(quizzes, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

    // State Variables
    let currentQuestions = [];
    let qIndex = 0;
    let p1Hp = 200;
    let p2Hp = 200;
    let p1Score = 0;
    let p1Combo = 0;
    let endingStarted = false;
    let timerVal = 15;
    let timerTimer = null;
    let isSubmitting = false;

    let isRealMatch = false;
    let currentRoom = null;
    let isHost = false;
    let roomPollTimer = null;
    let roomGameSyncTimer = null;
    let lastOpponentScore = 0;
    let isWaitingOpponent = false;
    let isMatchEnded = false;
    let opponentName = "Đối Thủ";

    const lobby = document.getElementById('lobbyScreen');
    const battle = document.getElementById('battleScreen');
    const result = document.getElementById('resultScreen');
    const subSelect = document.getElementById('selectSubject');
    const quizSelect = document.getElementById('selectQuiz');
    const noQuizAlert = document.getElementById('noQuizAlert');
    const btnQuickMatch = document.getElementById('btnQuickMatch');
    const btnCreateRoom = document.getElementById('btnCreateRoom');
    const btnJoinRoom = document.getElementById('btnJoinRoom');
    const searchQuizInput = document.getElementById('searchQuizInput');
    const btnClearSearchQuiz = document.getElementById('btnClearSearchQuiz');
    const quizSearchGroup = document.getElementById('quizSearchGroup');
    const selectedQuizPreviewCard = document.getElementById('selectedQuizPreviewCard');
    const quizCountBadge = document.getElementById('quizCountBadge');
    const waitingOpponentCard = document.getElementById('waitingOpponentCard');
    const answersContainer = document.getElementById('answersContainer');

    // ÂM THANH RETRO WEB AUDIO API
    function playWebAudio(soundType) {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            if (soundType === 'shoot') {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'square';
                osc.frequency.setValueAtTime(880, ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(160, ctx.currentTime + 0.12);
                gain.gain.setValueAtTime(0.25, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.12);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.12);
            } else if (soundType === 'hit') {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(150, ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(30, ctx.currentTime + 0.22);
                gain.gain.setValueAtTime(0.35, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.22);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.22);
            }
        } catch(e) {}
    }

    // SAO CHÉP MÃ PHÒNG CHUẨN ĐA NỀN TẢNG (CÓ FALLBACK TEXTAREA)
    function copyRoomCode() {
        const codeInput = document.getElementById('displayRoomCode');
        const code = codeInput ? (codeInput.value || codeInput.innerText || '').trim() : '';
        if (!code) return;

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(code).then(() => {
                EC.toast(`Đã sao chép mã ${code}. Gửi cho bạn của bạn nhé.`, 'ok');
            }).catch(() => fallbackCopy(code));
        } else {
            fallbackCopy(code);
        }
    }

    function fallbackCopy(code) {
        const ta = document.createElement('textarea');
        ta.value = code;
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        try {
            document.execCommand('copy');
            EC.toast(`Đã sao chép mã ${code}.`, 'ok');
        } catch (e) {
            const box = document.getElementById('displayRoomCode');
            box.focus(); box.select();
            EC.toast('Mã đã được chọn sẵn, nhấn Ctrl+C để sao chép.', 'warn');
        }
        document.body.removeChild(ta);
    }

    // XỬ LÝ & KIỂM TRA MÃ PHÒNG (LOẠI BỎ LINK WEBSITE & BÁO LỖI NẾU NHẬP LINK)
    function validateRoomCode(rawInput) {
        if (!rawInput) {
            EC.toast('Nhập mã phòng trước khi vào, ví dụ EDU-8924.', 'warn'); document.getElementById('inputRoomCode').focus();
            return null;
        }

        let code = rawInput.trim();

        // Kiểm tra người dùng có lỡ dán cả đường link website vào ô mã phòng hay không
        if (code.includes('http://') || code.includes('https://') || code.includes('/') || code.includes(':') || code.includes('?')) {
            // Thử trích xuất nếu link có chứa mã dạng EDU-XXXX hoặc EC-XXXX
            const match = code.match(/([a-zA-Z0-9]+-[0-9]{3,6})/);
            if (match) {
                code = match[1];
            } else {
                EC.toast('Đó là một đường link. Chỉ cần nhập mã phòng, ví dụ EDU-8924.', 'warn');
                return null;
            }
        }

        code = code.toUpperCase();
        if (code.length < 4 || code.length > 15) {
            EC.toast('Mã phòng chưa đúng dạng. Mã có dạng EDU-8924.', 'warn');
            return null;
        }

        return code;
    }

    // BỘ SINH SỐ NGẪU NHIÊN THEO SEED ĐẢM BẢO 2 CLIENT TRÙNG KHỚP CÂU HỎI
    function createSeededRandom(seed) {
        let s = (Math.abs(seed) % 2147483647) || 12345;
        return function() {
            s = (s * 16807) % 2147483647;
            return (s - 1) / 2147483646;
        };
    }

    function updateQuizDropdown() {
        const selectedSubId = parseInt(subSelect.value);
        const subName = subSelect.options[subSelect.selectedIndex]?.dataset.name || "";
        const searchTerm = (searchQuizInput ? searchQuizInput.value : "").trim().toLowerCase();

        // 1. Lọc tất cả các đề thuộc môn học này
        const subjectQuizzes = ALL_QUIZZES.filter(q => {
            const sId = q.subject?.subjectId || q.Subject?.SubjectId;
            return sId === selectedSubId;
        });

        const totalInSubject = subjectQuizzes.length;
        if (quizCountBadge) {
            quizCountBadge.innerText = `${totalInSubject} bộ đề`;
        }

        // 2. Nếu môn học CHƯA CÓ BỘ ĐỀ NÀO ĐƯỢC IMPORT -> KHÔNG ĐƯỢC PHÉP THI ĐẤU
        if (totalInSubject === 0) {
            quizSelect.classList.add('d-none');
            quizSearchGroup?.classList.add('d-none');
            selectedQuizPreviewCard?.classList.add('d-none');
            noQuizAlert.classList.remove('d-none');
            document.getElementById('noQuizTitle').innerText = `Môn ${subName} chưa có bộ đề nào`;

            if (btnQuickMatch) {
                btnQuickMatch.disabled = true;
                btnQuickMatch.classList.add('disabled');
                btnQuickMatch.innerHTML = 'Chưa có bộ đề';
            }
            if (btnCreateRoom) {
                btnCreateRoom.disabled = true;
                btnCreateRoom.classList.add('disabled');
                btnCreateRoom.innerHTML = 'Chưa có bộ đề';
            }
            if (btnJoinRoom) {
                btnJoinRoom.disabled = true;
                btnJoinRoom.classList.add('disabled');
            }
            return;
        }

        // 3. Môn có đề -> hiển thị ô tìm kiếm & ẩn cảnh báo
        quizSearchGroup?.classList.remove('d-none');

        // Lọc theo từ khóa tìm kiếm (tên đề, tác giả bản thân hay người khác, tags)
        let filtered = subjectQuizzes;
        if (searchTerm) {
            filtered = subjectQuizzes.filter(q => {
                const title = (q.title || q.Title || '').toLowerCase();
                const author = (q.author?.displayName || q.Author?.DisplayName || '').toLowerCase();
                const tags = (q.tags || q.Tags || []).map(t => t.toLowerCase()).join(' ');
                const isMe = (q.author?.userId === CURRENT_USER_ID) || (q.Author?.UserId === CURRENT_USER_ID);
                const authorType = isMe ? 'bản thân tôi của tôi my' : 'người khác cộng đồng';
                return title.includes(searchTerm) || author.includes(searchTerm) || tags.includes(searchTerm) || authorType.includes(searchTerm);
            });
        }

        quizSelect.innerHTML = '';
        if (filtered.length === 0) {
            quizSelect.classList.add('d-none');
            selectedQuizPreviewCard?.classList.add('d-none');
            noQuizAlert.classList.remove('d-none');
            document.getElementById('noQuizTitle').innerText = `Không có bộ đề nào khớp "${searchQuizInput.value}"`;

            if (btnQuickMatch) {
                btnQuickMatch.disabled = true;
                btnQuickMatch.classList.add('disabled');
                btnQuickMatch.innerHTML = 'Chưa chọn bộ đề';
            }
            if (btnCreateRoom) {
                btnCreateRoom.disabled = true;
                btnCreateRoom.classList.add('disabled');
                btnCreateRoom.innerHTML = 'Chưa chọn bộ đề';
            }
            return;
        }

        // Hiển thị dropdown các đề import
        quizSelect.classList.remove('d-none');
        noQuizAlert.classList.add('d-none');

        filtered.forEach(q => {
            const cId = q.contentId || q.ContentId;
            const title = q.title || q.Title || 'Bộ đề không tên';
            const authorName = q.author?.displayName || q.Author?.DisplayName || 'Cộng đồng';
            const authorId = q.author?.userId || q.Author?.UserId || '';
            const isMe = (CURRENT_USER_ID && authorId === CURRENT_USER_ID);
            const diff = q.difficultyLevel || q.DifficultyLevel || 'Medium';

            const opt = document.createElement('option');
            opt.value = cId;
            const diffVi = { Easy: 'Dễ', Medium: 'Vừa', Hard: 'Khó' }[diff] || diff;
            opt.text = `${title} · ${isMe ? 'của tôi' : authorName} · ${diffVi}`;
            quizSelect.appendChild(opt);
        });

        // Bật lại các nút thi đấu
        if (btnQuickMatch) {
            btnQuickMatch.disabled = false;
            btnQuickMatch.classList.remove('disabled');
            btnQuickMatch.innerHTML = 'Vào trận tập';
        }
        if (btnCreateRoom) {
            btnCreateRoom.disabled = false;
            btnCreateRoom.classList.remove('disabled');
            btnCreateRoom.innerHTML = 'Tạo mã phòng';
        }
        if (btnJoinRoom) {
            btnJoinRoom.disabled = false;
            btnJoinRoom.classList.remove('disabled');
        }

        updateSelectedQuizPreview();
    }


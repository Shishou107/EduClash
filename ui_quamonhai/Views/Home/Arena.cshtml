        if (!selectedQuizId) {
            selectedQuizPreviewCard?.classList.add('d-none');
            return;
        }
        const q = ALL_QUIZZES.find(item => (item.contentId || item.ContentId) === selectedQuizId);
        if (!q) {
            selectedQuizPreviewCard?.classList.add('d-none');
            return;
        }

        const title = q.title || q.Title || '';
        const authorName = q.author?.displayName || q.Author?.DisplayName || 'Cộng đồng';
        const authorId = q.author?.userId || q.Author?.UserId || '';
        const isMe = (CURRENT_USER_ID && authorId === CURRENT_USER_ID);
        const diff = q.difficultyLevel || q.DifficultyLevel || 'Medium';

        document.getElementById('previewQuizTitle').innerText = title;

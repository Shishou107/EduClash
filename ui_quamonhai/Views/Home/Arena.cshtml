        updateQuizDropdown();
        searchQuizInput.focus();
    });

    // Khởi tạo danh sách đề ngay khi tải trang
    updateQuizDropdown();

    // =========================================================================
    // QUẢN LÝ PHÒNG ĐẤU REAL-TIME (TẠO PHÒNG / VÀO PHÒNG / ĐỒNG BỘ 2 CLIENT)
    // =========================================================================

    // 1. TẠO PHÒNG ĐẤU TRÊN SERVER
    btnCreateRoom?.addEventListener('click', async () => {
        const selectedQuizId = quizSelect.value;
        if (!selectedQuizId) {
            EC.toast('Chọn một bộ đề trước khi tạo phòng.', 'warn');
            return;
        }

        btnCreateRoom.disabled = true;
        btnCreateRoom.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Đang tạo phòng…';

        try {
            const subName = subSelect.options[subSelect.selectedIndex]?.dataset.name || "Môn học";
            const subCode = subSelect.options[subSelect.selectedIndex]?.dataset.code || "GEN";
            const q = ALL_QUIZZES.find(item => (item.contentId || item.ContentId) === selectedQuizId);
            const qTitle = q ? (q.title || q.Title || "Đề thi đấu") : "Đề thi đấu";

            const resp = await fetch('/Home/CreateArenaRoom', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    contentId: selectedQuizId,
                    quizTitle: qTitle,
                    subjectName: subName,
                    subjectCode: subCode,
                    playerId: MY_PLAYER_ID
                })
            });

            if (!resp.ok) {
                const err = await resp.json();
                EC.toast(err.message || 'Máy chủ chưa tạo được phòng. Thử lại sau ít giây.', 'err');
                btnCreateRoom.disabled = false;
                btnCreateRoom.innerHTML = 'Tạo mã phòng';
                return;
            }

            currentRoom = await resp.json();
            isHost = true;

            const codeBox = document.getElementById('createdRoomBox');
            document.getElementById('displayRoomCode').value = currentRoom.roomCode;
            codeBox.classList.remove('d-none');

            // Bắt đầu thăm dò (polling) chờ người chơi thứ 2 vào phòng
            clearInterval(roomPollTimer);
            roomPollTimer = setInterval(async () => {
                try {
                    const checkResp = await fetch(`/Home/GetArenaRoom?code=${encodeURIComponent(currentRoom.roomCode)}`);
                    if (checkResp.ok) {
                        const roomState = await checkResp.json();
                        if (roomState.status === 'Playing' && roomState.guest) {
                            clearInterval(roomPollTimer);
                            codeBox.classList.add('d-none');
                            currentRoom = roomState;
                            startPvPMatch(roomState, true);
                        }
                    }
                } catch(e) {}
            }, 1000);

        } catch (e) {
            EC.toast('Mất kết nối khi tạo phòng. Kiểm tra mạng rồi thử lại.', 'err');
        } finally {
            btnCreateRoom.disabled = false;
            btnCreateRoom.innerHTML = 'Tạo mã phòng';
        }
    });

    // 2. VÀO PHÒNG ĐẤU VỚI MÃ ĐÃ CHIA SẺ
    document.getElementById('btnJoinRoom')?.addEventListener('click', async () => {
        const rawCode = document.getElementById('inputRoomCode').value;
        const validCode = validateRoomCode(rawCode);

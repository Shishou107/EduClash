@model List<ContentItemViewModel>
@{
    ViewData["Title"] = "EduClash · Ôn đề cương, đấu trí 1 vs 1";
    var subjects = ViewBag.Subjects as List<SubjectViewModel> ?? new List<SubjectViewModel>();
    int? selectedSubjectId = ViewBag.SelectedSubjectId as int?;
    var selectedSubject = ViewBag.SelectedSubject as SubjectViewModel;
    string searchKeyword = ViewBag.SearchKeyword as string ?? "";
    var topPlayers = ViewBag.TopPlayers as List<LeaderboardItemViewModel> ?? new List<LeaderboardItemViewModel>();
    var me = ViewBag.CurrentUser as UserProfileViewModel;
    bool filtering = selectedSubject != null || !string.IsNullOrWhiteSpace(searchKeyword);
}

@if (!filtering)
{
    <section class="hero" aria-labelledby="heroTitle">
        <div class="wrap hero__inner">
            <div>
                <h1 id="heroTitle">Ôn đề cương xong,<br /><em>vào đấu trường</em> so tài.</h1>
                <p class="hero__lede">Đọc đề cương các môn đại học, luyện trắc nghiệm, rồi thách đấu 1 vs 1 với bạn bè. Trả lời đúng là bắn trúng, ai còn nhiều máu hơn thì thắng và leo hạng Elo.</p>
                <div class="hero__cta">
                    <a href="/Home/Arena" class="btn-arcade btn-arcade--gold btn-arcade--lg">
                        <svg class="icon" aria-hidden="true"><use href="#i-swords" /></svg>Vào đấu ngay
                    </a>
                    <a href="#de-cuong" class="btn-arcade btn-arcade--ghost btn-arcade--lg">
                        <svg class="icon" aria-hidden="true"><use href="#i-book" /></svg>Xem đề cương
                    </a>
                </div>
                <ol class="hero__steps" aria-label="Cách chơi">
                    <li><svg class="icon" aria-hidden="true"><use href="#i-book" /></svg>Đọc đề cương</li>
                    <li><svg class="icon" aria-hidden="true"><use href="#i-quiz" /></svg>Luyện trắc nghiệm</li>
                    <li><svg class="icon" aria-hidden="true"><use href="#i-swords" /></svg>Đấu 1 vs 1, 200 HP</li>
                </ol>
            </div>

            <aside class="board" aria-labelledby="boardTitle">
                <div class="board__head">
                    <h2 class="board__title" id="boardTitle">Cao thủ đấu trường</h2>
                    <span class="board__live">TOP 3</span>
                </div>
                @if (me != null)
                {
                    <dl class="me-strip m-0" aria-label="Chỉ số của bạn">
                        <div><dt>Elo của bạn</dt><dd class="is-elo"><span data-count>@me.Rating</span></dd></div>
                        <div><dt>Xu</dt><dd class="is-coin"><span data-count>@me.Coins</span></dd></div>
                        <div><dt>Thắng / Thua</dt><dd>@me.Wins/@me.Losses</dd></div>
                    </dl>
                }
                @if (topPlayers.Count == 0)
                {
                    <p class="board__empty">Chưa ai lên bảng. Thắng trận đầu tiên để ghi tên mình ở đây.</p>
                }
                else
                {
                    <ol class="board__list">
                        @foreach (var p in topPlayers)
                        {
                            <li class="board__row">
                                <span class="board__rank">#@p.RankPosition</span>
                                <span class="avatar">
                                    @if (!string.IsNullOrEmpty(p.AvatarUrl))
                                    {
                                        <img src="@p.AvatarUrl" alt="" />
                                    }
                                    else
                                    {
                                        @(string.IsNullOrEmpty(p.DisplayName) ? "?" : p.DisplayName.Substring(0, 1).ToUpper())
                                    }
                                </span>
                                <span class="board__name">@p.DisplayName<small>Hạng @p.RankTier · @p.Wins trận thắng</small></span>
                                <span class="board__score"><span data-count>@p.Rating</span><span class="visually-hidden"> Elo</span></span>
                            </li>
                        }
                    </ol>
                }
                <div class="board__foot">
                    <span>@(me == null ? "Đăng ký để nhận 50 xu" : "Leo hạng bằng mỗi trận thắng")</span>
                    <a href="/Home/Leaderboard">Bảng xếp hạng →</a>
                </div>
            </aside>
        </div>
    </section>
}

<div class="wrap">
    @if (filtering)
    {
        <div class="page-head">
            <ol class="crumbs" aria-label="Vị trí">
                <li><a href="/">Đề cương</a></li>
                <li aria-current="page">@(selectedSubject?.Name ?? "Kết quả tìm kiếm")</li>
            </ol>
        </div>
    }

    <section class="section" aria-labelledby="subjectsTitle">
        <div class="section-head">
            <h2 id="subjectsTitle">Chọn môn để lọc đề cương</h2>
            <a class="link-arrow" href="/Home/Subjects">Tất cả môn học <svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg></a>
        </div>
        @await Html.PartialAsync("_SubjectRail", subjects, new ViewDataDictionary(ViewData) { { "BaseUrl", "/" }, { "SelectedId", selectedSubjectId }, { "ShowCounts", true } })
    </section>

    <section class="section" id="de-cuong" aria-labelledby="docsTitle">
        <div class="section-head">
            <h2 id="docsTitle">@(selectedSubject != null ? $"Đề cương môn {selectedSubject.Name}" : "Đề cương mới nhất")</h2>
            <form method="get" action="/" class="search" role="search">
                @if (selectedSubjectId != null)
                {
                    <input type="hidden" name="subjectId" value="@selectedSubjectId" />
                }
                <svg class="icon" aria-hidden="true"><use href="#i-search" /></svg>
                <label for="docSearch" class="visually-hidden">Tìm đề cương</label>
                <input id="docSearch" type="search" name="search" placeholder="Tên đề hoặc tag, ví dụ: giải tích" value="@searchKeyword" />
                <button type="submit">Tìm</button>
            </form>
        </div>

        @if (filtering)
        {
            <p class="filter-note">
                Đang lọc: @if (selectedSubject != null) { <span class="chip chip--green">@selectedSubject.Code</span> }
                @if (!string.IsNullOrWhiteSpace(searchKeyword)) { <span class="chip">“@searchKeyword”</span> }
                <a href="/" class="link-arrow">Bỏ lọc</a>
            </p>
        }

        @if (Model == null || Model.Count == 0)
        {
            <div class="empty">
                <svg class="icon empty__icon" aria-hidden="true"><use href="#i-file" /></svg>
                <h3>Chưa có đề cương nào @(selectedSubject != null ? "cho môn này" : "khớp")</h3>
                <p>Bạn có thể là người đầu tiên tải lên. Hệ thống nhận file Word (.docx) hoặc PDF và hiển thị như một trang sách.</p>
                <a href="/Outline/Import" class="btn-arcade btn-arcade--green">
                    <svg class="icon" aria-hidden="true"><use href="#i-upload" /></svg>Tải đề cương lên
                </a>
            </div>
        }
        else
        {
            <div class="doc-grid">
                @foreach (var item in Model)
                {
                    <article class="doc-card">
                        <div class="doc-card__top">
                            <span class="chip chip--code">@item.Subject.Code</span>
                            <span class="stat-inline" title="Lượt thích"><svg class="icon" aria-hidden="true"><use href="#i-star" /></svg>@item.StarCount</span>
                        </div>
                        <h3><a href="/Home/Outline/@item.ContentId">@item.Title</a></h3>
                        <p class="doc-card__desc">@(string.IsNullOrEmpty(item.Description) ? $"Đề cương môn {item.Subject.Name}." : item.Description)</p>
                        <div class="doc-card__meta">
                            <span class="doc-card__author">
                                <span class="avatar avatar--sm" aria-hidden="true">@(string.IsNullOrEmpty(item.Author.DisplayName) ? "?" : item.Author.DisplayName.Substring(0, 1).ToUpper())</span>
                                <span>@item.Author.DisplayName</span>
                            </span>
                            <span class="doc-card__go" aria-hidden="true">Đọc <svg class="icon"><use href="#i-arrow" /></svg></span>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
<script>
    // Điểm trên bảng đếm từ 0 lên khi bảng "bật nguồn". Số thật đã có sẵn trong HTML,
    // nên nếu script lỗi hoặc người dùng tắt chuyển động thì vẫn thấy đúng số.
    (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const els = document.querySelectorAll('.hero [data-count]');
        els.forEach((el, i) => {
            const target = parseInt(el.textContent, 10);
            if (!Number.isFinite(target) || target <= 0) return;
            el.setAttribute('aria-hidden', 'true');
            const label = document.createElement('span');
            label.className = 'visually-hidden';
            label.textContent = target;
            el.after(label);
            el.textContent = '0';
            const delay = 850 + i * 120, dur = 900;
            setTimeout(() => {
                const t0 = performance.now();
                const tick = (now) => {
                    const p = Math.min(1, (now - t0) / dur);
                    el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3)));
                    if (p < 1) requestAnimationFrame(tick);
                };
                requestAnimationFrame(tick);
            }, delay);
        });
    })();
</script>
}

@{
    ViewData["Title"] = "Tải đề lên · EduClash";
    var subjects = ViewBag.Subjects as List<SubjectViewModel> ?? new List<SubjectViewModel>();
    string? errorMessage = ViewBag.ErrorMessage as string;
}

<div class="wrap wrap--form">
    <header class="page-head">
        <ol class="crumbs" aria-label="Vị trí">
            <li><a href="/">Trang chủ</a></li>
            <li><a href="/Outline/MyOutlines">Đề tôi đã đăng</a></li>
            <li aria-current="page">Tải đề lên</li>
        </ol>
        <h1>Tải đề lên</h1>
        <p class="page-head__lede">Đề cương được giữ nguyên bố cục như trang sách. Bộ trắc nghiệm được tách thành từng câu A, B, C, D để luyện và mang vào đấu trường.</p>
    </header>

    <form method="post" action="/Outline/Import" enctype="multipart/form-data" id="importForm" class="panel panel--pad mt-3">
        @Html.AntiForgeryToken()

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="flash flash--err mt-0 mb-4" role="alert">
                <svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg><span>@errorMessage</span>
            </div>
        }

        <div class="form-grid">
            <fieldset class="field span-2">
                <legend class="label mb-1">Loại tài liệu <span class="req" aria-hidden="true">*</span></legend>
                <div class="mode-pick">
                    <label>
                        <input type="radio" name="mode" value="TheoryOutline" checked />
                        <strong><svg class="icon" aria-hidden="true"><use href="#i-book" /></svg>Đề cương lý thuyết</strong>
                        <span>Giữ nguyên file Word hoặc PDF, đọc như trang sách.</span>
                    </label>
                    <label>
                        <input type="radio" name="mode" value="StructuredQuiz" />
                        <strong><svg class="icon" aria-hidden="true"><use href="#i-quiz" /></svg>Bộ trắc nghiệm</strong>
                        <span>Tách câu hỏi và phương án A, B, C, D để làm bài online.</span>
                    </label>
                </div>
            </fieldset>

            <div class="field span-2">
                <label for="impTitle">Tiêu đề <span class="req" aria-hidden="true">*</span></label>
                <input id="impTitle" type="text" name="title" class="form-control" placeholder="Ví dụ: Đề cương Hệ quản trị CSDL, chương 1 và 2" required />
            </div>

            <div class="field">
                <label for="subjectSelect">Môn học <span class="req" aria-hidden="true">*</span></label>
                <select name="subjectId" id="subjectSelect" class="form-select" required>
                    <option value="">Chọn môn học</option>
                    @foreach (var s in subjects)
                    {
                        <option value="@s.SubjectId">@s.Code · @s.Name</option>
                    }
                </select>
            </div>

            <div class="field">
                <label for="impDifficulty">Độ khó</label>
                <select id="impDifficulty" name="difficultyLevel" class="form-select">
                    <option value="Easy">Dễ, kiến thức cơ bản</option>
                    <option value="Medium" selected>Vừa, sát đề thi</option>
                    <option value="Hard">Khó, nâng cao</option>
                </select>
            </div>

            <div class="field span-2">
                <label for="tagsInput">Tag <span class="field-hint d-inline">(không bắt buộc)</span></label>
                <input type="text" name="tags" id="tagsInput" class="form-control" placeholder="GiuaKy, CSDL, HUIT" aria-describedby="tagsHint" />
                <p class="field-hint" id="tagsHint">Ngăn cách bằng dấu phẩy. Hệ thống tự thêm tag #lythuyet hoặc #tracnghiem.</p>
            </div>

            <div class="field span-2">
                <label for="impDesc">Mô tả ngắn <span class="field-hint d-inline">(không bắt buộc)</span></label>
                <textarea id="impDesc" name="description" class="form-control" rows="2" placeholder="Phạm vi kiến thức, dành cho kỳ thi nào…"></textarea>
            </div>

            <div class="field span-2">
                <span class="label" id="fileLabel">File đính kèm <span class="req" aria-hidden="true">*</span></span>
                <label class="dropzone" id="dropZone" for="fileInput">
                    <input type="file" name="file" id="fileInput" class="visually-hidden" accept=".docx,.pdf" aria-labelledby="fileLabel" aria-describedby="fileHint" required />
                    <svg class="icon" aria-hidden="true"><use href="#i-upload" id="dropIcon" /></svg>
                    <strong id="dropTitle">Kéo thả file vào đây hoặc bấm để chọn</strong>
                    <p id="fileHint">Word (.docx) hoặc PDF (.pdf), tối đa 20 MB.</p>
                </label>
            </div>
        </div>

        <div class="form-actions">
            <a href="/Outline/MyOutlines" class="btn-arcade">Huỷ</a>
            <button type="submit" id="btnSubmitUpload" class="btn-arcade btn-arcade--green">
                <svg class="icon" aria-hidden="true"><use href="#i-upload" /></svg><span id="btnSubmitText">Tải lên và xử lý</span>
                <span id="btnSubmitSpinner" class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    (function () {
        const MAX = 20 * 1024 * 1024;
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const dropTitle = document.getElementById('dropTitle');
        const fileHint = document.getElementById('fileHint');
        const dropIcon = document.getElementById('dropIcon');
        const form = document.getElementById('importForm');

        function show() {
            const f = fileInput.files && fileInput.files[0];
            if (!f) {
                dropZone.classList.remove('has-file');
                dropTitle.textContent = 'Kéo thả file vào đây hoặc bấm để chọn';
                fileHint.textContent = 'Word (.docx) hoặc PDF (.pdf), tối đa 20 MB.';
                dropIcon.setAttribute('href', '#i-upload');
                return;
            }
            const okType = /\.(docx|pdf)$/i.test(f.name);
            if (!okType || f.size > MAX) {
                fileInput.value = '';
                EC.toast(!okType ? 'Chỉ nhận file .docx hoặc .pdf.' : 'File lớn hơn 20 MB, hãy nén hoặc tách nhỏ.', 'err');
                return show();
            }
            dropZone.classList.add('has-file');
            dropTitle.textContent = f.name;
            fileHint.textContent = `${(f.size / 1024).toFixed(0)} KB · bấm để đổi file khác`;
            dropIcon.setAttribute('href', '#i-check');
        }

        fileInput.addEventListener('change', show);
        dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('is-over'); });
        dropZone.addEventListener('dragleave', () => dropZone.classList.remove('is-over'));
        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('is-over');
            if (e.dataTransfer.files.length) { fileInput.files = e.dataTransfer.files; show(); }
        });

        form.addEventListener('submit', () => {
            const btn = document.getElementById('btnSubmitUpload');
            btn.disabled = true;
            document.getElementById('btnSubmitText').textContent = 'Đang tải lên và xử lý…';
            document.getElementById('btnSubmitSpinner').classList.remove('d-none');
        });
    })();
</script>
}

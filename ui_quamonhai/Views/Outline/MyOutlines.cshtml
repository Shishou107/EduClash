@model List<ContentItemViewModel>
@{
    ViewData["Title"] = "Đề tôi đã đăng · EduClash";
    var currentType = ViewBag.Type as string ?? "All";
    var searchKeyword = ViewBag.Search as string ?? "";
    var items = Model ?? new List<ContentItemViewModel>();
    var totalCount = items.Count;
    var outlineCount = items.Count(c => c.ContentType == "StudyOutline");
    var quizCount = items.Count(c => c.ContentType == "Quiz");
    string? Cur(string t) => currentType == t ? "page" : null;
    var q = Uri.EscapeDataString(searchKeyword);
}

<div class="wrap">
    <header class="page-head">
        <ol class="crumbs" aria-label="Vị trí">
            <li><a href="/">Trang chủ</a></li>
            <li><a href="/Auth/Profile">Hồ sơ</a></li>
            <li aria-current="page">Đề tôi đã đăng</li>
        </ol>
        <div class="page-head__row">
            <div>
                <h1>Đề tôi đã đăng</h1>
                <p class="page-head__lede">Kiểm tra lại đề cương và bộ trắc nghiệm bạn đã tải lên, hoặc xoá những đề không còn dùng.</p>
            </div>
            <a href="/Outline/Import" class="btn-arcade btn-arcade--green">
                <svg class="icon" aria-hidden="true"><use href="#i-upload" /></svg>Tải đề mới
            </a>
        </div>
    </header>

    <section class="section">
        <div class="toolbar">
            <nav class="seg" aria-label="Lọc theo loại">
                <a href="/Outline/MyOutlines?type=All&search=@q" aria-current="@Cur("All")">Tất cả <span class="num">@totalCount</span></a>
                <a href="/Outline/MyOutlines?type=StudyOutline&search=@q" aria-current="@Cur("StudyOutline")">Đề cương <span class="num">@outlineCount</span></a>
                <a href="/Outline/MyOutlines?type=Quiz&search=@q" aria-current="@Cur("Quiz")">Trắc nghiệm <span class="num">@quizCount</span></a>
            </nav>
            <form method="get" action="/Outline/MyOutlines" class="search" role="search">
                <input type="hidden" name="type" value="@currentType" />
                <svg class="icon" aria-hidden="true"><use href="#i-search" /></svg>
                <label for="mySearch" class="visually-hidden">Tìm trong đề của tôi</label>
                <input id="mySearch" type="search" name="search" placeholder="Tiêu đề hoặc mã môn" value="@searchKeyword" />
                <button type="submit">Tìm</button>
            </form>
        </div>

        @if (items.Count == 0)
        {
            <div class="empty">
                <svg class="icon empty__icon" aria-hidden="true"><use href="#i-file" /></svg>
                @if (!string.IsNullOrWhiteSpace(searchKeyword) || currentType != "All")
                {
                    <h3>Không có đề nào khớp bộ lọc</h3>
                    <p>Thử bỏ từ khoá hoặc chuyển sang “Tất cả”.</p>
                    <a href="/Outline/MyOutlines" class="btn-arcade">Bỏ lọc</a>
                }
                else
                {
                    <h3>Bạn chưa đăng đề nào</h3>
                    <p>Tải lên file Word hoặc PDF đầu tiên. Cả lớp sẽ đọc được, và bộ trắc nghiệm có thể mang vào đấu trường.</p>
                    <a href="/Outline/Import" class="btn-arcade btn-arcade--green"><svg class="icon" aria-hidden="true"><use href="#i-upload" /></svg>Tải đề lên</a>
                }
            </div>
        }
        else
        {
            <div class="panel table-scroll">
                <table class="data-table">
                    <caption class="visually-hidden">Danh sách đề bạn đã đăng</caption>
                    <thead>
                        <tr>
                            <th scope="col">Tài liệu</th>
                            <th scope="col">Môn</th>
                            <th scope="col" class="num-col">Lượt xem</th>
                            <th scope="col" class="num-col">Thích</th>
                            <th scope="col">Ngày đăng</th>
                            <th scope="col" class="num-col"><span class="visually-hidden">Thao tác</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            var isQuiz = item.ContentType == "Quiz";
                            var detailUrl = isQuiz ? $"/Home/Quiz/{item.ContentId}" : $"/Home/Outline/{item.ContentId}";
                            <tr id="row-@item.ContentId">
                                <td>
                                    <div class="player-cell">
                                        <span class="doc-type @(isQuiz ? "doc-type--quiz" : "doc-type--outline")" title="@(isQuiz ? "Trắc nghiệm" : "Đề cương")">
                                            <svg class="icon" aria-hidden="true"><use href="@(isQuiz ? "#i-quiz" : "#i-book")" /></svg>
                                        </span>
                                        <div>
                                            <a href="@detailUrl"><strong>@item.Title</strong></a>
                                            <small>@(isQuiz ? "Trắc nghiệm" : "Đề cương")@(string.IsNullOrWhiteSpace(item.Description) ? "" : $" · {item.Description}")</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="chip chip--code">@(item.Subject?.Code ?? "—")</span></td>
                                <td class="num-col"><span class="num">@item.ViewCount</span></td>
                                <td class="num-col"><span class="num">@item.StarCount</span></td>
                                <td><span class="num">@item.CreatedAt.ToString("dd/MM/yyyy")</span></td>
                                <td>
                                    <div class="row-actions">
                                        <a href="@detailUrl" class="btn-arcade btn-arcade--sm" aria-label="Xem @item.Title"><svg class="icon" aria-hidden="true"><use href="#i-eye" /></svg>Xem</a>
                                        <button type="button" class="btn-arcade btn-arcade--sm btn-delete-content" data-id="@item.ContentId" data-title="@item.Title" aria-label="Xoá @item.Title">
                                            <svg class="icon" aria-hidden="true"><use href="#i-trash" /></svg>Xoá
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts {
<script>
    document.querySelectorAll('.btn-delete-content').forEach(btn => {
        btn.addEventListener('click', async function () {
            const id = this.dataset.id;
            const title = this.dataset.title;
            const ok = await EC.confirm({
                title: 'Xoá đề này vĩnh viễn?',
                body: `“${title}” và toàn bộ câu hỏi đi kèm sẽ bị gỡ khỏi hệ thống. Không thể khôi phục.`,
                okText: 'Xoá vĩnh viễn',
                cancelText: 'Giữ lại',
                danger: true
            });
            if (!ok) return;

            this.disabled = true;
            try {
                const formData = new FormData();
                formData.append('formId', id);
                const res = await fetch('/Outline/DeleteAjax', { method: 'POST', body: formData });
                const data = await res.json();
                if (!data.success) throw new Error(data.message || 'Máy chủ từ chối xoá đề này.');
                const row = document.getElementById(`row-${id}`);
                row.style.transition = 'opacity 0.3s';
                row.style.opacity = '0';
                setTimeout(() => row.remove(), 300);
                EC.toast(`Đã xoá “${title}”.`, 'ok');
            } catch (e) {
                this.disabled = false;
                EC.toast(`Chưa xoá được: ${e.message}`, 'err', 7000);
            }
        });
    });
</script>
}

@model List<ContentItemViewModel>
@{
    ViewData["Title"] = "Quản Lý Đề Cương Của Tôi — EduClash";
    var currentType = ViewBag.Type as string ?? "All";
    var searchKeyword = ViewBag.Search as string ?? "";
    var totalCount = Model?.Count ?? 0;
    var outlineCount = Model?.Count(c => c.ContentType == "StudyOutline") ?? 0;
    var quizCount = Model?.Count(c => c.ContentType == "Quiz") ?? 0;
}

<div class="edu-breadcrumbs-strip" style="background-color: #0F1D33; padding: 12px 24px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
    <div style="max-width: 1200px; margin: 0 auto; display: flex; align-items: center; gap: 10px; font-size: 0.95rem;">
        <a href="/" style="color: #FFFFFF; font-weight: 500; text-decoration: none;">Trang chủ</a>
        <span style="color: #94A3B8;">&gt;</span>
        <span style="color: #38BDF8; font-weight: 600;">Quản lý đề cương của tôi</span>
    </div>
</div>

<div class="container py-4" style="max-width: 1200px;">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark m-0">📑 Quản Lý Đề Cương &amp; Bộ Đề Của Tôi</h1>
            <p class="text-muted small mt-1 mb-0">Theo dõi, kiểm tra và quản lý toàn bộ các tài liệu học tập và đề trắc nghiệm bạn đã tải lên.</p>
        </div>
        <div>
            <a href="/Outline/Import" class="btn btn-primary fw-bold px-3 py-2 shadow-sm d-flex align-items-center gap-2" style="border-radius: 8px;">
                <span>📤</span> Tải lên đề cương mới
            </a>
        </div>
    </div>

    <!-- Toolbar: Search & Filter Tabs -->
    <div class="card shadow-sm border-0 p-3 mb-4" style="border-radius: 12px; background: #FFFFFF;">
        <div class="row g-3 align-items-center">
            <!-- Search -->
            <div class="col-md-5">
                <form method="get" action="/Outline/MyOutlines" class="d-flex gap-2">
                    <input type="hidden" name="type" value="@currentType" />
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">🔍</span>
                        <input type="text" name="search" class="form-control border-start-0" 
                               placeholder="Tìm theo tiêu đề, mã môn..." 
                               value="@searchKeyword" />
                        <button type="submit" class="btn btn-outline-primary">Tìm</button>
                        @if (!string.IsNullOrWhiteSpace(searchKeyword))
                        {
                            <a href="/Outline/MyOutlines?type=@currentType" class="btn btn-outline-secondary">✕</a>
                        }
                    </div>
                </form>
            </div>

            <!-- Filter tabs -->
            <div class="col-md-7">
                <div class="d-flex justify-content-md-end gap-2 flex-wrap">
                    <a href="/Outline/MyOutlines?type=All&search=@searchKeyword" 
                       class="btn btn-sm @(currentType == "All" ? "btn-dark fw-bold" : "btn-outline-secondary") rounded-pill px-3">
                        Tất cả (@totalCount)
                    </a>
                    <a href="/Outline/MyOutlines?type=StudyOutline&search=@searchKeyword" 
                       class="btn btn-sm @(currentType == "StudyOutline" ? "btn-success fw-bold" : "btn-outline-secondary") rounded-pill px-3">
                        📖 Đề cương (@outlineCount)
                    </a>
                    <a href="/Outline/MyOutlines?type=Quiz&search=@searchKeyword" 
                       class="btn btn-sm @(currentType == "Quiz" ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">
                        📝 Trắc nghiệm (@quizCount)
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Table -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="card p-5 text-center shadow-sm border-0" style="border-radius: 14px; background: #FFFFFF;">
            <div style="font-size: 3.5rem;">📂</div>
            <h4 class="fw-bold mt-2">Chưa Có Tài Liệu Nào</h4>
            @if (!string.IsNullOrWhiteSpace(searchKeyword) || currentType != "All")
            {
                <p class="text-muted">Không tìm thấy tài liệu nào phù hợp với bộ lọc tìm kiếm hiện tại.</p>
                <div>
                    <a href="/Outline/MyOutlines" class="btn btn-sm btn-outline-secondary mt-1">Xóa bộ lọc</a>
                </div>
            }
            else
            {
                <p class="text-muted">Bạn chưa đăng tải đề cương nào. Hãy tải lên tài liệu DOCX hoặc PDF đầu tiên của bạn!</p>
                <div>
                    <a href="/Outline/Import" class="btn btn-success fw-bold px-4 py-2 mt-2" style="border-radius: 8px;">
                        📤 Tải lên tài liệu ngay
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 overflow-hidden" style="border-radius: 14px; background: #FFFFFF;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width: 320px;" class="ps-4">Tài liệu</th>
                            <th>Loại</th>
                            <th>Môn học</th>
                            <th>Lượt xem / Thích</th>
                            <th>Ngày đăng</th>
                            <th class="text-end pe-4" style="min-width: 160px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var isQuiz = item.ContentType == "Quiz";
                            var detailUrl = isQuiz ? $"/Home/Quiz/{item.ContentId}" : $"/Home/Outline/{item.ContentId}";
                            <tr id="row-@item.ContentId">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="p-2 rounded text-center d-flex align-items-center justify-content-center" 
                                             style="width: 42px; height: 42px; background: @(isQuiz ? "rgba(37, 99, 235, 0.1)" : "rgba(16, 185, 129, 0.1)"); font-size: 1.25rem;">
                                            @(isQuiz ? "📝" : "📖")
                                        </div>
                                        <div>
                                            <a href="@detailUrl" class="text-dark fw-bold text-decoration-none">
                                                @item.Title
                                            </a>
                                            @if (!string.IsNullOrWhiteSpace(item.Description))
                                            {
                                                <div class="text-muted small text-truncate" style="max-width: 360px;">
                                                    @item.Description
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(isQuiz ? "bg-primary-subtle text-primary" : "bg-success-subtle text-success") fw-bold rounded-pill px-2 py-1">
                                        @(isQuiz ? "Trắc nghiệm" : "Đề cương")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        #@(item.Subject?.Code ?? "CS") - @(item.Subject?.Name ?? "Môn học")
                                    </span>
                                </td>
                                <td>
                                    <div class="small text-muted">
                                        <span>👁️ @item.ViewCount</span>
                                        <span class="ms-2">⭐ @item.StarCount</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="small text-muted">@item.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="@detailUrl" class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                                            👁️ Xem
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-delete-content" 
                                                data-id="@item.ContentId" 
                                                data-title="@item.Title" 
                                                title="Xóa đề cương này">
                                            🗑️ Xóa
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal Xác Nhận Xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius: 14px;">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-danger" id="deleteModalLabel">⚠️ Xác Nhận Xóa Tài Liệu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Bạn có chắc chắn muốn xóa tài liệu <strong id="deleteTargetTitle" class="text-dark"></strong> không?</p>
                <div class="alert alert-warning small mb-0">
                    <strong>Lưu ý:</strong> Hành động này sẽ gỡ bỏ đề cương và toàn bộ câu hỏi liên quan khỏi hệ thống và không thể khôi phục lại.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-danger fw-bold px-4" id="btnConfirmDelete">
                    <span id="btnDeleteText">Xóa vĩnh viễn</span>
                    <span id="btnDeleteSpinner" class="spinner-border spinner-border-sm d-none ms-1" role="status"></span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let selectedIdToDelete = null;
    const deleteModalElem = document.getElementById('deleteModal');
    const deleteModal = new bootstrap.Modal(deleteModalElem);
    const deleteTargetTitle = document.getElementById('deleteTargetTitle');
    const btnConfirmDelete = document.getElementById('btnConfirmDelete');
    const btnDeleteText = document.getElementById('btnDeleteText');
    const btnDeleteSpinner = document.getElementById('btnDeleteSpinner');

    document.querySelectorAll('.btn-delete-content').forEach(btn => {
        btn.addEventListener('click', function () {
            selectedIdToDelete = this.dataset.id;
            deleteTargetTitle.innerText = `"${this.dataset.title}"`;
            deleteModal.show();
        });
    });

    btnConfirmDelete.addEventListener('click', async function () {
        if (!selectedIdToDelete) return;

        btnConfirmDelete.disabled = true;
        btnDeleteText.innerText = "Đang xóa...";
        btnDeleteSpinner.classList.remove('d-none');

        try {
            const formData = new FormData();
            formData.append('formId', selectedIdToDelete);

            const res = await fetch('/Outline/DeleteAjax', {
                method: 'POST',
                body: formData
            });

            const data = await res.json();
            if (data.success) {
                deleteModal.hide();
                const row = document.getElementById(`row-${selectedIdToDelete}`);
                if (row) {
                    row.style.transition = 'opacity 0.4s';
                    row.style.opacity = '0';
                    setTimeout(() => row.remove(), 400);
                }
            } else {
                alert(data.message || 'Lỗi khi xóa tài liệu.');
            }
        } catch (e) {
            alert('Lỗi kết nối máy chủ: ' + e.message);
        } finally {
            btnConfirmDelete.disabled = false;
            btnDeleteText.innerText = "Xóa vĩnh viễn";
            btnDeleteSpinner.classList.add('d-none');
            selectedIdToDelete = null;
        }
    });
</script>
}

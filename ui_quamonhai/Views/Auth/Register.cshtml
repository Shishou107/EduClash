@model RegisterRequest
@{
    ViewData["Title"] = "Đăng ký · EduClash";
    string? errorMessage = ViewBag.ErrorMessage as string;
}

<div class="wrap">
    <div class="auth panel">
        <aside class="auth__side">
            <h2>Tạo tài khoản, nhận ngay 50 xu</h2>
            <ul class="perk-list">
                <li><span class="perk-icon"><svg class="icon" aria-hidden="true"><use href="#i-coin" /></svg></span><div><strong>50 xu khởi đầu</strong>Đủ để AI soạn khoảng 100 câu trắc nghiệm từ đề cương.</div></li>
                <li><span class="perk-icon"><svg class="icon" aria-hidden="true"><use href="#i-upload" /></svg></span><div><strong>Chia sẻ đề cương</strong>Tải lên file Word hoặc PDF cho cả lớp cùng ôn.</div></li>
                <li><span class="perk-icon"><svg class="icon" aria-hidden="true"><use href="#i-trophy" /></svg></span><div><strong>Ghi tên lên bảng xếp hạng</strong>Thắng trận để leo từ Đồng lên Kim Cương.</div></li>
            </ul>
        </aside>

        <form method="post" action="/Auth/Register" class="auth__form">
            @Html.AntiForgeryToken()
            <h1>Đăng ký</h1>
            <p>Chỉ mất chưa tới một phút.</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="flash flash--err m-0" role="alert">
                    <svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg><span>@errorMessage</span>
                </div>
            }

            <div class="field">
                <label for="regName">Họ và tên</label>
                <input id="regName" type="text" name="DisplayName" class="form-control" autocomplete="name" placeholder="Nguyễn Văn A" value="@Model.DisplayName" minlength="2" maxlength="60" required />
            </div>

            <div class="field">
                <label for="regEmail">Email</label>
                <input id="regEmail" type="email" name="Email" class="form-control" autocomplete="email" placeholder="tenban@gmail.com" value="@Model.Email" required />
            </div>

            <div class="field">
                <label for="regPassword">Mật khẩu</label>
                <div class="pw-field">
                    <input id="regPassword" type="password" name="Password" class="form-control" autocomplete="new-password" minlength="8"
                           pattern="(?=.*[A-Z])(?=.*\d).{8,}" aria-describedby="regPasswordHint" required />
                    <button type="button" class="pw-toggle" data-target="regPassword" aria-label="Hiện mật khẩu" aria-pressed="false">
                        <svg class="icon" aria-hidden="true"><use href="#i-eye" /></svg>
                    </button>
                </div>
                <p class="field-hint" id="regPasswordHint">Ít nhất 8 ký tự, có 1 chữ hoa và 1 chữ số.</p>
            </div>

            <div class="field">
                <label for="regConfirm">Nhập lại mật khẩu</label>
                <input id="regConfirm" type="password" name="ConfirmPassword" class="form-control" autocomplete="new-password" minlength="8" required />
            </div>

            <button type="submit" class="btn-arcade btn-arcade--gold btn-arcade--lg btn-arcade--block">
                <svg class="icon" aria-hidden="true"><use href="#i-coin" /></svg>Đăng ký và nhận 50 xu
            </button>

            <p class="auth__switch">Đã có tài khoản? <a href="/Auth/Login">Đăng nhập</a></p>
        </form>
    </div>
</div>

@section Scripts {
<script>
    // Báo ngay khi hai mật khẩu không khớp, thay vì chờ server trả lỗi.
    (function () {
        const pw = document.getElementById('regPassword');
        const confirm = document.getElementById('regConfirm');
        const check = () => confirm.setCustomValidity(confirm.value && confirm.value !== pw.value ? 'Mật khẩu nhập lại chưa khớp.' : '');
        pw.addEventListener('input', check);
        confirm.addEventListener('input', check);
        pw.addEventListener('invalid', () => pw.setCustomValidity(pw.validity.patternMismatch || pw.validity.tooShort ? 'Mật khẩu cần ít nhất 8 ký tự, có 1 chữ hoa và 1 chữ số.' : ''));
        pw.addEventListener('input', () => pw.setCustomValidity(''));
    })();
</script>
}

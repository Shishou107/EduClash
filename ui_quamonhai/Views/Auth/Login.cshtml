@model LoginRequest
@{
    ViewData["Title"] = "Đăng Nhập — EduClash";
    string? returnUrl = ViewBag.ReturnUrl as string;
    string? errorMessage = ViewBag.ErrorMessage as string;
}

<div class="container py-5" style="max-width: 480px;">
    <div class="card shadow border-0 p-4 p-md-5" style="border-radius: 16px; background: #FFFFFF;">
        <div class="text-center mb-4">
            <div class="d-inline-flex p-3 rounded-circle mb-3" style="background: rgba(16, 185, 129, 0.1);">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" fill="#059669"/>
                </svg>
            </div>
            <h2 class="h4 fw-bold text-dark m-0">Đăng Nhập EduClash</h2>
            <p class="text-muted small mt-1">Học tập &amp; Đấu trí đối kháng tri thức sinh viên</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 small" role="alert">
                @errorMessage
            </div>
        }

        <form method="post" action="/Auth/Login">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">Email hoặc Tên tài khoản</label>
                <input type="text" name="Email" class="form-control py-2" placeholder="tenban@gmail.com" value="@Model.Email" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">Mật khẩu</label>
                <input type="password" name="Password" class="form-control py-2" placeholder="••••••••" required />
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="RememberMe" id="rememberMe" value="true" @(Model.RememberMe ? "checked" : "") />
                    <label class="form-check-label small text-muted" for="rememberMe">
                        Ghi nhớ đăng nhập
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2 fw-bold shadow-sm" style="border-radius: 8px;">
                Đăng Nhập
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top text-muted small">
            Chưa có tài khoản? <a href="/Auth/Register" class="text-success fw-bold text-decoration-none">Đăng ký ngay</a> (Tặng 50 Xu)
        </div>
    </div>
</div>

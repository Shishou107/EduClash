@model LoginRequest
@{
    ViewData["Title"] = "Đăng nhập · EduClash";
    string? returnUrl = ViewBag.ReturnUrl as string;
    string? errorMessage = ViewBag.ErrorMessage as string;
}

<div class="wrap">
    <div class="auth panel">
        <aside class="auth__side">
            <h2>Chào mừng trở lại đấu trường</h2>
            <ul class="perk-list">
                <li><span class="perk-icon"><svg class="icon" aria-hidden="true"><use href="#i-swords" /></svg></span><div><strong>Đấu 1 vs 1</strong>Tạo phòng, gửi mã cho bạn, trả lời đúng để bắn trúng.</div></li>
                <li><span class="perk-icon"><svg class="icon" aria-hidden="true"><use href="#i-bolt" /></svg></span><div><strong>Leo hạng Elo</strong>Mỗi trận thắng đẩy bạn lên bảng xếp hạng.</div></li>
                <li><span class="perk-icon"><svg class="icon" aria-hidden="true"><use href="#i-sparkles" /></svg></span><div><strong>Xu để soạn đề bằng AI</strong>Dùng xu để AI soạn câu hỏi từ đề cương.</div></li>
            </ul>
        </aside>

        <form method="post" action="/Auth/Login" class="auth__form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <h1>Đăng nhập</h1>
            <p>Dùng email bạn đã đăng ký.</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="flash flash--err m-0" role="alert">
                    <svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg><span>@errorMessage</span>
                </div>
            }

            <div class="field">
                <label for="loginEmail">Email</label>
                <input id="loginEmail" type="email" name="Email" class="form-control" autocomplete="email" placeholder="tenban@gmail.com" value="@Model.Email" required />
            </div>

            <div class="field">
                <label for="loginPassword">Mật khẩu</label>
                <div class="pw-field">
                    <input id="loginPassword" type="password" name="Password" class="form-control" autocomplete="current-password" required />
                    <button type="button" class="pw-toggle" data-target="loginPassword" aria-label="Hiện mật khẩu" aria-pressed="false">
                        <svg class="icon" aria-hidden="true"><use href="#i-eye" /></svg>
                    </button>
                </div>
            </div>

            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="RememberMe" id="rememberMe" value="true" @(Model.RememberMe ? "checked" : "") />
                <label class="form-check-label" for="rememberMe">Ghi nhớ đăng nhập trên máy này</label>
            </div>

            <button type="submit" class="btn-arcade btn-arcade--green btn-arcade--lg btn-arcade--block">Đăng nhập</button>

            <p class="auth__switch">Chưa có tài khoản? <a href="/Auth/Register">Đăng ký và nhận 50 xu</a></p>
        </form>
    </div>
</div>

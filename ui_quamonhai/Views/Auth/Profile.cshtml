@model UserProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ · EduClash";
}

<div class="wrap wrap--narrow">
    <header class="page-head">
        <ol class="crumbs" aria-label="Vị trí">
            <li><a href="/">Trang chủ</a></li>
            <li aria-current="page">Hồ sơ của tôi</li>
        </ol>
    </header>

    @if (Model == null)
    {
        <div class="empty">
            <svg class="icon empty__icon" aria-hidden="true"><use href="#i-user" /></svg>
            <h3>Bạn chưa đăng nhập</h3>
            <p>Đăng nhập để xem chỉ số, ví xu và các đề bạn đã đăng.</p>
            <a href="/Auth/Login" class="btn-arcade btn-arcade--green">Đăng nhập</a>
        </div>
    }
    else
    {
        <section class="game-panel" aria-labelledby="playerName">
            <div class="player-hero">
                <span class="avatar">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="" />
                    }
                    else
                    {
                        @UiHelpers.Initial(Model.DisplayName)
                    }
                </span>
                <div>
                    <h1 id="playerName">@Model.DisplayName</h1>
                    <p class="player-hero__meta">@Model.Email · tham gia @Model.RegisteredAt.ToString("dd/MM/yyyy")</p>
                    <div class="player-hero__chips">
                        <span class="chip tier @UiHelpers.TierClass(Model.RankTier)"><svg class="icon" aria-hidden="true"><use href="#i-shield" /></svg>Hạng @Model.RankTier</span>
                        <span class="chip chip--code">LV @Model.Level</span>
                        @if (Model.CurrentStreak > 0)
                        {
                            <span class="chip chip--gold"><svg class="icon" aria-hidden="true"><use href="#i-flame" /></svg>Chuỗi thắng @Model.CurrentStreak</span>
                        }
                    </div>
                </div>
            </div>
            <dl class="stat-grid m-0">
                <div><dt>Ví xu</dt><dd class="is-coin">@Model.Coins</dd></div>
                <div><dt>Elo đấu trường</dt><dd class="is-elo">@Model.Rating</dd></div>
                <div><dt>Thắng / Thua</dt><dd>@Model.Wins/@Model.Losses</dd></div>
                <div><dt>Chuỗi thắng tốt nhất</dt><dd>@Model.BestStreak</dd></div>
            </dl>
        </section>

        <section class="section" aria-labelledby="actionsTitle">
            <div class="section-head"><h2 id="actionsTitle">Việc bạn có thể làm</h2></div>
            <div class="action-list">
                <a class="action-tile" href="/Outline/MyOutlines">
                    <span class="perk-icon"><svg class="icon" aria-hidden="true"><use href="#i-file" /></svg></span>
                    <span><strong>Đề tôi đã đăng</strong><span>Xem, kiểm tra hoặc xoá đề cương và bộ đề.</span></span>
                </a>
                <a class="action-tile" href="/Outline/Import">
                    <span class="perk-icon"><svg class="icon" aria-hidden="true"><use href="#i-upload" /></svg></span>
                    <span><strong>Tải đề mới lên</strong><span>File Word (.docx) hoặc PDF.</span></span>
                </a>
                <a class="action-tile" href="/Home/Arena">
                    <span class="perk-icon"><svg class="icon" aria-hidden="true"><use href="#i-swords" /></svg></span>
                    <span><strong>Vào đấu trường</strong><span>Tạo phòng và mời bạn đấu 1 vs 1.</span></span>
                </a>
                <a class="action-tile action-tile--danger" href="/Auth/Logout">
                    <span class="perk-icon"><svg class="icon" aria-hidden="true"><use href="#i-logout" /></svg></span>
                    <span><strong>Đăng xuất</strong><span>Thoát khỏi tài khoản trên máy này.</span></span>
                </a>
            </div>
        </section>
    }
</div>
